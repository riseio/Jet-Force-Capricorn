new file mode 100644
index 0000000..54920f1
--- /dev/null
+++ b/recompinput/include/recompinput/relative_delta_frame.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#include <array>
+
+namespace recompinput {
+
+class RelativeDeltaFrame {
+public:
+    void add(float x, float y) {
+        pending_[0] += x;
+        pending_[1] += y;
+    }
+
+    void begin_frame() {
+        current_ = pending_;
+        pending_ = {0.0f, 0.0f};
+    }
+
+    const std::array<float, 2>& value() const {
+        return current_;
+    }
+
+private:
+    std::array<float, 2> current_{};
+    std::array<float, 2> pending_{};
+};
+
+}
diff --git a/recompinput/include/recompinput/wheel_button_frame.h b/recompinput/include/recompinput/wheel_button_frame.h
new file mode 100644
index 0000000..73f150e
--- /dev/null
+++ b/recompinput/include/recompinput/wheel_button_frame.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <limits>
+
+namespace recompinput {
+
+class WheelButtonFrame {
+public:
+    void add(int32_t delta) {
+        pending_ = std::clamp<int64_t>(pending_ + int64_t(delta),
+            std::numeric_limits<int32_t>::min(),
+            std::numeric_limits<int32_t>::max());
+    }
+
+    void begin_frame(bool enabled) {
+        if (!enabled) {
+            pending_ = 0;
+            current_.store(0);
+        }
+        else if (current_.load() != 0) {
+            current_.store(0);
+        }
+        else {
+            const int direction = (pending_ > 0) - (pending_ < 0);
+            pending_ -= direction;
+            current_.store(direction);
+        }
+    }
+
+    bool pressed(int32_t direction) const {
+        return (direction == 1 || direction == -1) && current_.load() == direction;
+    }
+
+private:
+    int64_t pending_ = 0;
+    std::atomic<int> current_{0};
+};
+
+}
