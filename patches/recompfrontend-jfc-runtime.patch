+        void graphics::toggle_visual_enhancements() {
+            if (!enhanced_textures_available) return;
+            recomp::config::Config& config = get_graphics_config();
+            const auto requested = ultramodern::renderer::get_graphics_config();
+            const auto next = next_visual_enhancement_state(
+                requested.lighting_option == ultramodern::renderer::LightingMode::Modern,
+                requested.texture_option == ultramodern::renderer::TextureMode::Enhanced);
+            config.update_option_value(
+                graphics::options::lighting_option,
+                static_cast<uint32_t>(next.lighting
+                    ? ultramodern::renderer::LightingMode::Modern
+                    : ultramodern::renderer::LightingMode::Original));
+            config.update_option_value(
+                graphics::options::texture_option,
+                static_cast<uint32_t>(next.textures
+                    ? ultramodern::renderer::TextureMode::Enhanced
+                    : ultramodern::renderer::TextureMode::Original));
+            config.apply_option_value(graphics::options::lighting_option);
+            config.apply_option_value(graphics::options::texture_option);
