diff --git a/recompui/src/base/ui_input_edge.hpp b/recompui/src/base/ui_input_edge.hpp
new file mode 100644
index 0000000..ef1057f
--- /dev/null
+++ b/recompui/src/base/ui_input_edge.hpp
@@ -0,0 +1,53 @@
+#ifndef RECOMPUI_UI_INPUT_EDGE_HPP
+#define RECOMPUI_UI_INPUT_EDGE_HPP
+
+#include <array>
+#include <cstdint>
+
+namespace recompui {
+
+struct UiInputEdge {
+    bool press(int key, uint64_t source, bool repeat = false) {
+        if (repeat || key == 0) {
+            return true;
+        }
+
+        bool action_held = false;
+        Source* free = nullptr;
+        for (auto& held : sources) {
+            if (held.key == key) {
+                action_held = true;
+                if (held.source == source) {
+                    return false;
+                }
+            }
+            if (free == nullptr && held.key == 0) {
+                free = &held;
+            }
+        }
+        if (free != nullptr) {
+            *free = {key, source};
+        }
+        return !action_held;
+    }
+
+    void release(int key, uint64_t source) {
+        for (auto& held : sources) {
+            if (held.key == key && held.source == source) {
+                held = {};
+                return;
+            }
+        }
+    }
+
+private:
+    struct Source {
+        int key = 0;
+        uint64_t source = 0;
+    };
+    std::array<Source, 32> sources{};
+};
+
+}
+
+#endif
