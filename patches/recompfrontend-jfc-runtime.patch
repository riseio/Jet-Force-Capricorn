+    return (stick_inversions.load(std::memory_order_relaxed) & (1U << (std::abs(id) - 1))) ? -id : id;
+}
+static InputField physical_field(InputField field) {
+    if (field.input_type == InputType::ControllerAnalog) field.input_id = physical_axis(field.input_id);
+    for (auto& modifier : field.modifiers)
+        if (modifier.input_type == InputType::ControllerAnalog) modifier.input_id = physical_axis(modifier.input_id);
+    return field;
+}
+
+static bool overlay_controller(SDL_GameController* controller) {
+    return InputState.overlay_available && controller &&
+        SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(controller)) == InputState.overlay_instance;
+}
+
+static void update_overlay(InputChordState& state, uint64_t sequence) {
+    for (unsigned button = 0; button < SDL_CONTROLLER_BUTTON_MAX; ++button)
+        if (InputState.overlay_available & (1U << button))
+            state.update({InputType::ControllerDigital, int(button)},
+                (InputState.overlay_held & (1U << button)) ? 1.0f : 0.0f, sequence);
+}
+
+SDL_JoystickID recompinput::controller_overlay_source() {
+    std::lock_guard lock{InputState.controllers_mutex};
+    for (const auto& [id, state] : InputState.controller_states)
+        if (overlay_controller(state.controller)) return id;
+    return -2;
+}
+
+bool recompinput::controller_button_is_overlaid(SDL_JoystickID source, uint8_t button) {
+    std::lock_guard lock{InputState.controllers_mutex};
+    return button < SDL_CONTROLLER_BUTTON_MAX && source == InputState.overlay_instance &&
+        (InputState.overlay_available & (1U << button));
+}
+
+void recompinput::set_controller_button_overlay(uint16_t vendor, uint16_t product,
+                                                uint32_t available, uint32_t held) {
+    std::lock_guard lock{InputState.controllers_mutex};
+    const auto sequence = ++InputState.input_sequence;
+    const bool first_sample = !InputState.overlay_available && available;
+    const auto retired = InputState.overlay_available & ~available;
+    for (unsigned button = 0; button < SDL_CONTROLLER_BUTTON_MAX; ++button)
+        if (retired & (1U << button)) {
+            InputState.overlay_chord.update({InputType::ControllerDigital, int(button)}, 0, sequence);
+            for (auto& [id, state] : InputState.controller_states)
+                if (overlay_controller(state.controller))
+                    state.chord.update({InputType::ControllerDigital, int(button)}, 0, sequence);
+        }
+    InputState.overlay_vendor = vendor; InputState.overlay_product = product;
+    InputState.overlay_available = available; InputState.overlay_held = held & available;
+    SDL_JoystickID direct = -2, virtual_pad = -2;
+    unsigned direct_count = 0, virtual_count = 0;
+    for (const auto& [id, state] : InputState.controller_states) {
+        if (!state.controller || SDL_GameControllerGetVendor(state.controller) != vendor) continue;
+        const auto actual_product = SDL_GameControllerGetProduct(state.controller);
+        if (actual_product == product) { direct = id; ++direct_count; }
+        else if (vendor == 0x28DE && product == 0x1205 && actual_product == 0x11FF) {
+            virtual_pad = id; ++virtual_count;
+        }
+    }
+    const auto selected = direct_count == 1 ? direct :
+        direct_count == 0 && virtual_count == 1 ? virtual_pad : -2;
+    const bool owner_changed = selected != InputState.overlay_instance;
+    if (owner_changed) {
+        for (auto& [id, state] : InputState.controller_states)
+            if (id == InputState.overlay_instance || id == selected) state.chord.suspend();
+        InputState.overlay_chord.suspend();
+        InputState.overlay_instance = selected;
+    }
+    update_overlay(InputState.overlay_chord, owner_changed || first_sample ? 0 : sequence);
+    for (auto& [id, state] : InputState.controller_states)
+        if (overlay_controller(state.controller)) update_overlay(state.chord, owner_changed || first_sample ? 0 : sequence);
+}
+
+void recompinput::record_input_event(const SDL_Event& event) {
+    std::lock_guard lock{InputState.controllers_mutex};
+    const auto sequence = ++InputState.input_sequence;
+    if (event.type == SDL_WINDOWEVENT && event.window.event == SDL_WINDOWEVENT_FOCUS_LOST) {
+        InputState.keyboard_chord.suspend(); InputState.overlay_chord.suspend();
+        for (auto& [id, state] : InputState.controller_states) state.chord.suspend();
+    } else if (event.type == SDL_KEYDOWN || event.type == SDL_KEYUP) {
+        InputState.keyboard_chord.update({InputType::Keyboard, event.key.keysym.scancode},
+            event.type == SDL_KEYDOWN ? 1 : 0, sequence);
+    } else if (event.type == SDL_MOUSEBUTTONDOWN || event.type == SDL_MOUSEBUTTONUP) {
+        InputState.keyboard_chord.update({InputType::Mouse, event.button.button},
+            event.type == SDL_MOUSEBUTTONDOWN ? 1 : 0, sequence);
+    } else if (event.type == SDL_MOUSEWHEEL && event.wheel.y) {
+        const bool up = (event.wheel.y > 0) != (event.wheel.direction == SDL_MOUSEWHEEL_FLIPPED);
+        InputState.keyboard_chord.update(InputField::mouse_wheel(up).atom(), 1, sequence);
+    } else if (event.type == SDL_CONTROLLERBUTTONDOWN || event.type == SDL_CONTROLLERBUTTONUP) {
+        const auto found = InputState.controller_states.find(event.cbutton.which);
+        if (found != InputState.controller_states.end() &&
+            !(overlay_controller(found->second.controller) &&
+              (InputState.overlay_available & (1U << event.cbutton.button))))
+            found->second.chord.update({InputType::ControllerDigital, event.cbutton.button},
+                event.type == SDL_CONTROLLERBUTTONDOWN ? 1 : 0, sequence);
+    } else if (event.type == SDL_CONTROLLERAXISMOTION) {
+        const auto found = InputState.controller_states.find(event.caxis.which);
+        if (found != InputState.controller_states.end()) {
+            float value = event.caxis.value / 32768.0f;
+            const float deadzone = float(recompui::config::general::get_joystick_deadzone() / 100.0);
+            if (event.caxis.axis < SDL_CONTROLLER_AXIS_TRIGGERLEFT && std::abs(value) <= deadzone) value = 0;
+            found->second.chord.update({InputType::ControllerAnalog, event.caxis.axis + 1}, value, sequence);
+            found->second.chord.update({InputType::ControllerAnalog, -event.caxis.axis - 1}, -value, sequence);
+        }
+    }
+}
+
+void recompinput::release_input_event_pulse(const SDL_Event& event) {
+    if (event.type != SDL_MOUSEWHEEL) return;
+    std::lock_guard lock{InputState.controllers_mutex};
+    const auto sequence = ++InputState.input_sequence;
+    for (int direction : {-1, 1}) InputState.keyboard_chord.update({InputType::MouseWheel, direction}, 0, sequence);
+}
+
+template<class Visitor> static void visit_chord_sources(int controller_num, const InputField& field, Visitor&& visit) {
+    if (!field.atom().is_controller()) { visit(InputState.keyboard_chord); return; }
+    bool overlay_seen = false;
+    for (auto& [id, state] : InputState.controller_states) {
+        if (players::is_single_player_mode() || players::get_player(controller_num).controller == state.controller) {
+            visit(state.chord);
+            overlay_seen |= overlay_controller(state.controller);
+        }
+    }
+    if (!overlay_seen && players::is_single_player_mode()) visit(InputState.overlay_chord);
+}
+
+void recompinput::claim_input_chord(int controller_num, const InputField& logical, bool analog) {
+    const auto field = physical_field(logical);
+    if (!field.modifier_count() || !field.valid()) return;
+    std::lock_guard lock{InputState.controllers_mutex};
+    visit_chord_sources(controller_num, field, [&](InputChordState& state) { state.claim(field, analog); });
+}
+
+static float chord_value(int controller_num, const InputField& logical, bool analog = false) {
+    const auto field = physical_field(logical);
+    std::lock_guard lock{InputState.controllers_mutex};
+    float value = 0;
+    visit_chord_sources(controller_num, field, [&](const InputChordState& state) {
+        value = std::max(value, state.value(field, analog));
+    });
+    return value;
+}
+
+bool recompinput::get_event_input_digital(int controller_num, const InputField& field) {
+    return chord_value(controller_num, field) >= axis_digital_threshold;
+}
+
+bool recompinput::input_field_blocked(int player, const InputField& logical) {
+    const auto field = physical_field(logical);
+    std::lock_guard lock{InputState.controllers_mutex};
+    bool blocked = false;
+    visit_chord_sources(player, field, [&](const InputChordState& state) { blocked |= state.blocked(field); });
+    return blocked;
+}
