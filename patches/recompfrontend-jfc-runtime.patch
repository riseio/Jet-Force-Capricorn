diff --git a/recompinput/include/recompinput/logical_button.h b/recompinput/include/recompinput/logical_button.h
new file mode 100644
index 0000000..599d09c
--- /dev/null
+++ b/recompinput/include/recompinput/logical_button.h
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace recompinput {
+
+class LogicalButton {
+public:
+    bool set_source_pressed(uint64_t source, bool pressed) {
+        if (source == 0 || (source & (source - 1U)) != 0) {
+            return false;
+        }
+
+        if (pressed) {
+            const uint64_t prior = held_sources.fetch_or(
+                source, std::memory_order_acq_rel);
+            if ((prior & source) != 0 || prior != 0) {
+                return false;
+            }
+            pending_presses.fetch_add(1, std::memory_order_release);
+            return true;
+        }
+
+        held_sources.fetch_and(~source, std::memory_order_acq_rel);
+        return false;
+    }
+
+    bool consume_press() {
+        uint64_t pending = pending_presses.load(std::memory_order_acquire);
+        while (pending != 0) {
+            if (pending_presses.compare_exchange_weak(
+                    pending, pending - 1U,
+                    std::memory_order_acq_rel,
+                    std::memory_order_acquire)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    uint64_t pending_count() const {
+        return pending_presses.load(std::memory_order_acquire);
+    }
+
+private:
+    std::atomic_uint64_t held_sources{0};
+    std::atomic_uint64_t pending_presses{0};
+};
+
+}
