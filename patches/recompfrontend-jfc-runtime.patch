+            }
+
+            if (!enhanced_textures_available) return true;
+            const auto applied =
+                ultramodern::renderer::get_applied_graphics_config();
+            const auto requested = ultramodern::renderer::get_graphics_config();
+            return applied.lighting_option == requested.lighting_option &&
+                applied.texture_option == requested.texture_option;
+        }
