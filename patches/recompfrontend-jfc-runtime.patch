+    void binding::scan_input(InputField value, bool down, SDL_JoystickID source) {
+        if (!BindingState.active || !value.valid() || value.is_empty()) return;
+        if (value.atom().is_controller() != (BindingState.device == InputDevice::Controller)) return;
+        if (BindingState.held_count && source != BindingState.source) return;
+        size_t found = 0;
+        while (found < BindingState.held_count && BindingState.held[found] != value) ++found;
+        if (down) {
+            if (found != BindingState.held_count) return;
+            if (BindingState.held_count == BindingState.held.size()) { stop_scanning(); return; }
+            BindingState.source = source;
+            BindingState.held[BindingState.held_count++] = value;
+        } else if (found < BindingState.held_count) {
+            auto result = BindingState.held[BindingState.held_count - 1];
+            for (size_t i = 0; i + 1 < BindingState.held_count; ++i)
+                result = result.holding(BindingState.held[i]);
+            set_scanned_input(result);
+        }
+    }
+
