diff --git a/recompui/src/renderer/ui_image_layout.h b/recompui/src/renderer/ui_image_layout.h
new file mode 100644
index 0000000..9491858
--- /dev/null
+++ b/recompui/src/renderer/ui_image_layout.h
@@ -0,0 +1,22 @@
+#pragma once
+
+#include <cstdint>
+#include <limits>
+#include <stdexcept>
+
+namespace recompui {
+struct RGBA32Layout {
+    uint32_t row_bytes, padded_row_bytes, source_bytes, upload_bytes;
+};
+
+inline RGBA32Layout rgba32_layout(uint32_t width, uint32_t height) {
+    if (!width || !height || width > 16384 || height > 16384)
+        throw std::invalid_argument("UI image dimensions must be between 1 and 16384");
+    const uint64_t row = uint64_t(width) * 4;
+    const uint64_t padded_row = (row + 255) & ~uint64_t(255);
+    const uint64_t source = row * height, upload = padded_row * height;
+    if (source > UINT32_MAX || upload > UINT32_MAX)
+        throw std::length_error("UI image exceeds its upload extent");
+    return {uint32_t(row), uint32_t(padded_row), uint32_t(source), uint32_t(upload)};
+}
+}
