+                std::lock_guard lock(texture_failure_mutex);
+                failure.swap(texture_failure);
+            }
+            if (failure && failure->request_serial ==
+                    ultramodern::renderer::get_graphics_config().texture_request_serial) {
+                auto& config = get_graphics_config();
+                config.update_option_value(graphics::options::texture_option, uint32_t(failure->applied));
+                config.apply_option_value(graphics::options::texture_option);
+                const bool saved = config.save_config_json(config.get_json_config());
+                texture_activation_error = std::move(failure->error);
+                if (!saved)
+                    texture_activation_error += " The corrected preference could not be saved.";
+            }
+            static std::optional<VisualEnhancementState> last_applied;
+            static std::optional<VisualEnhancementState> last_requested;
+            static std::optional<bool> last_available;
+            static std::string last_error;
+            const auto applied_config =
+                ultramodern::renderer::get_applied_graphics_config();
+            const auto requested_config = ultramodern::renderer::get_graphics_config();
+            const VisualEnhancementState applied{
+                applied_config.lighting_option == ultramodern::renderer::LightingMode::Modern,
+                applied_config.texture_option == ultramodern::renderer::TextureMode::Enhanced};
+            const VisualEnhancementState requested{
+                requested_config.lighting_option == ultramodern::renderer::LightingMode::Modern,
+                requested_config.texture_option == ultramodern::renderer::TextureMode::Enhanced};
+            if (last_applied == applied && last_requested == requested &&
+                last_available == enhanced_textures_available && last_error == texture_activation_error) {
+                return;
+            }
+
+            const bool pending = applied != requested;
+            get_graphics_config().update_option_enum_details(
+                graphics::options::lighting_option,
+                std::string(pending ? "Applying; active: " : "Active: ") +
+                    (applied.lighting ? "Modern" : "Original"));
+            get_graphics_config().update_option_enum_details(
+                graphics::options::texture_option,
+                !texture_activation_error.empty() ? texture_activation_error : enhanced_textures_available
+                    ? std::string(pending ? "Applying; active: " : "Active: ") +
+                        (applied.textures ? "On" : "Off")
+                    : "Not installed: choose Install enhanced textures below");
+            last_applied = applied;
+            last_requested = requested;
+            last_available = enhanced_textures_available;
+            last_error = texture_activation_error;
+        }
