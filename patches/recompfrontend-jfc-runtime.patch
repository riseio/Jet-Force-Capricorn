diff --git a/recompinput/include/recompinput/input_chord.h b/recompinput/include/recompinput/input_chord.h
new file mode 100644
index 0000000..0ef35c1
--- /dev/null
+++ b/recompinput/include/recompinput/input_chord.h
@@ -0,0 +1,90 @@
+#pragma once
+
+#include <algorithm>
+#include "input_types.h"
+
+namespace recompinput {
+
+class InputChordState {
+    static constexpr size_t mouse_start = SDL_NUM_SCANCODES;
+    static constexpr size_t wheel_start = mouse_start + 32;
+    static constexpr size_t button_start = wheel_start + 2;
+    static constexpr size_t axis_start = button_start + SDL_CONTROLLER_BUTTON_MAX;
+    static constexpr size_t count = axis_start + SDL_CONTROLLER_AXIS_MAX * 2;
+    struct Press {
+        float value = 0;
+        uint64_t sequence = 0;
+        uint64_t motion_sequence = 0;
+        uint8_t claimed = 0;
+    };
+    std::array<Press, count> inputs{};
+    static size_t index(InputAtom atom) {
+        if (!atom.valid()) return count;
+        switch (atom.input_type) {
+        case InputType::Keyboard: return atom.input_id;
+        case InputType::Mouse: return mouse_start + atom.input_id - 1;
+        case InputType::MouseWheel: return wheel_start + (atom.input_id < 0);
+        case InputType::ControllerDigital: return button_start + atom.input_id;
+        case InputType::ControllerAnalog:
+            return axis_start + (atom.input_id < 0 ? -atom.input_id - 1 : atom.input_id - 1) * 2 + (atom.input_id < 0);
+        default: return count;
+        }
+    }
+    const Press& press(InputAtom atom) const {
+        const auto i = index(atom);
+        static const Press empty{};
+        return i < count ? inputs[i] : empty;
+    }
+public:
+    void update(InputAtom atom, float value, uint64_t sequence) {
+        const auto i = index(atom);
+        if (i >= count) return;
+        auto& p = inputs[i];
+        const bool was_down = p.value >= 0.5f, down = value >= 0.5f;
+        if (value <= 0) { p.motion_sequence = 0; p.claimed = 0; }
+        else if (p.value <= 0) { p.motion_sequence = sequence; p.claimed = sequence ? 0 : UINT8_MAX; }
+        if (!down) p.sequence = 0;
+        else if (!was_down) p.sequence = sequence;
+        p.value = std::clamp(value, 0.0f, 1.0f);
+    }
+    bool qualifies(const InputField& field, bool analog = false) const {
+        const auto& trigger = press(field.atom());
+        const auto started = analog ? trigger.motion_sequence : trigger.sequence;
+        if (!started) return false;
+        for (size_t i = 0; i < field.modifier_count(); ++i) {
+            const auto& modifier = press(field.modifiers[i]);
+            if (!modifier.sequence || modifier.value < 0.5f || modifier.sequence >= started) return false;
+        }
+        return true;
+    }
+    void claim(const InputField& field, bool analog = false) {
+        if (!field.modifier_count() || !qualifies(field, analog)) return;
+        const uint8_t depth = uint8_t(field.modifier_count() + 1);
+        const auto own = [&](InputAtom atom) {
+            auto& p = inputs[index(atom)];
+            p.claimed = std::max(p.claimed, depth);
+        };
+        own(field.atom());
+        for (size_t i = 0; i < field.modifier_count(); ++i) own(field.modifiers[i]);
+    }
+    float value(const InputField& field, bool analog = false) const {
+        const auto& p = press(field.atom());
+        if (p.claimed > field.modifier_count() + 1) return 0;
+        if (field.modifier_count() && !qualifies(field, analog)) return 0;
+        return p.value;
+    }
+    bool suppressed(InputAtom atom) const { return press(atom).claimed > 1; }
+    bool blocked(const InputField& field) const {
+        const auto& p = press(field.atom());
+        return p.value > 0 && p.claimed > field.modifier_count() + 1;
+    }
+    void suspend() {
+        for (auto& p : inputs) if (p.value > 0) {
+            p.sequence = 0;
+            p.motion_sequence = 0;
+            p.claimed = UINT8_MAX;
+        }
+    }
+};
+
+}
