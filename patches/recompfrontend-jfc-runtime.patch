+void renderer::RT64Context::run_state_operation(void (*operation)(void*), void* context) {
+    if (!app || !operation) throw std::runtime_error("Invalid renderer state operation");
+    if (state_operation_active) throw std::runtime_error("Nested renderer state operation");
+    auto& state = *app->state;
+    auto& workloads = *app->workloadQueue;
+    auto& presents = *app->presentQueue;
+
+    if (state.cpuFramebufferPresentPending)
+        throw std::runtime_error("CPU framebuffer image is unfinished at save-state boundary");
+    if (!state.prepareNextWorkload())
+        throw std::runtime_error("Renderer stopped before save-state preparation");
+
+    workloads.waitForWorkloadId(state.workloadId);
+    presents.waitForPresentId(state.presentId);
+    std::scoped_lock consumers(workloads.threadMutex, presents.threadMutex);
+    {
+        std::scoped_lock cursors(workloads.cursorMutex, presents.cursorMutex);
+        if (workloads.writeCursor != workloads.threadCursor || presents.writeCursor != presents.threadCursor)
+            throw std::runtime_error("Renderer producer advanced during save-state retirement");
+    }
+    if (state.taskCompleteCallback || !state.returnAddressStack.empty())
+        throw std::runtime_error("Renderer task is still active at save-state boundary");
+
+    workloads.retireInterpolationWorkers();
+    workloads.ext.workloadGraphicsWorker->waitIfPending();
+    for (auto& transaction : presents.presentTransactions)
+        if (transaction.worker) transaction.worker->waitIfPending();
+    state.ext.framebufferGraphicsWorker->waitIfPending();
+    state.ext.drawDataUploader->wait();
+    state.ext.transformsUploader->wait();
+    state.ext.tilesUploader->wait();
+    state.ext.textureCache->waitForGPUUploads();
+    const uint64_t textureReadEpoch = state.ext.textureCache->acquireTextureRead();
+    struct TextureRead {
+        RT64::TextureCache* cache;
+        uint64_t epoch;
+        ~TextureRead() { cache->releaseTextureRead(epoch); }
+    } textures{state.ext.textureCache, textureReadEpoch};
+    state_operation_active = true;
+    struct ActiveOperation {
+        bool& active;
+        ~ActiveOperation() { active = false; }
+    } active{state_operation_active};
+    if (std::getenv("JFC_STATE_RENDEZVOUS_VI")) {
+        uint32_t count = 0;
+        auto roundTrip = [&](plume::RenderTexture* texture, uint32_t width, uint32_t height,
+                plume::RenderFormat format, const plume::RenderMultisampling& sampling) {
+            if (!texture) return;
+            const auto shaders = app->renderInterface->getCapabilities().shaderFormat;
+            auto* worker = state.ext.framebufferGraphicsWorker;
+            auto saved = RT64::captureStateTexture(worker, shaders, texture, width, height, format, sampling);
+            auto prepared = RT64::prepareStateTexture(worker, shaders, saved);
+            auto repeated = RT64::captureStateTexture(worker, shaders, prepared.get(), width, height, format, sampling);
+            if (saved.blocks != repeated.blocks)
+                throw std::runtime_error("Save-state GPU samples differ after prepared restore");
+            ++count;
+
+            std::fflush(stderr);
+        };
+        auto managers = [&](RT64::RenderTargetManager& targets, RT64::FramebufferManager& framebuffers) {
+            for (auto& pair : targets.targetMap) {
+                auto& t = *pair.second;
+                roundTrip(t.texture.get(), t.width, t.height, t.format, t.multisampling);
+            }
+            for (auto& pair : framebuffers.tileCopies) {
+                auto& t = pair.second;
+                roundTrip(t.texture.get(), t.textureWidth, t.textureHeight,
+                    RT64::RenderTarget::colorBufferFormat(targets.usesHDR), plume::RenderMultisampling());
+            }
+        };
+        managers(state.renderTargetManager, state.framebufferManager);
+        managers(app->sharedQueueResources->renderTargetManager, app->sharedQueueResources->framebufferManager);
+
+        auto owner = capture_state();
+        auto preparedOwner = prepare_state(owner);
+
+    }
+    operation(context);
+}
+
+void renderer::RT64Context::install_cpu_framebuffer_shader(std::span<const uint8_t> spirv,
+    std::span<const uint8_t> dxil) {
+    struct Installation { RT64Context* owner; std::span<const uint8_t> spirv, dxil; } install{this, spirv, dxil};
+    run_state_operation(+[](void* value) {
+        auto& request = *static_cast<Installation*>(value);
+        auto& app = *request.owner->app;
+        const auto sampling = RT64::RasterShader::generateMultisamplingPattern(
+            app.userConfig.msaaSampleCount(), app.device->getCapabilities().sampleLocations);
+        app.shaderLibrary->installCpuFramebufferShader(app.renderInterface.get(), app.device.get(),
+            sampling, request.spirv.data(), request.spirv.size(), request.dxil.data(), request.dxil.size());
+    }, &install);
+}
