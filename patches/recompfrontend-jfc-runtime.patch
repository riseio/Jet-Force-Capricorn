diff --git a/recompui/src/core/input_capture.h b/recompui/src/core/input_capture.h
new file mode 100644
index 0000000..41ac1d3
--- /dev/null
+++ b/recompui/src/core/input_capture.h
@@ -0,0 +1,27 @@
+#pragma once
+
+#include <atomic>
+#include <cassert>
+#include <cstddef>
+#include <cstdint>
+
+namespace recompui {
+
+    class InputCapture {
+        size_t input_count = 0;
+        size_t mouse_count = 0;
+        std::atomic<uint8_t> published{0};
+
+    public:
+        void replace(bool old_input, bool old_mouse, bool input, bool mouse) {
+            assert(input_count >= size_t(old_input));
+            assert(mouse_count >= size_t(old_mouse));
+            input_count = input_count - size_t(old_input) + size_t(input);
+            mouse_count = mouse_count - size_t(old_mouse) + size_t(mouse);
+            published.store(uint8_t((input_count != 0) | ((mouse_count != 0) << 1)),
+                std::memory_order_release);
+        }
+
+        uint8_t read() const { return published.load(std::memory_order_acquire); }
+    };
+}
