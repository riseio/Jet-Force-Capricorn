+std::unique_ptr<ultramodern::renderer::PreparedRendererState> renderer::RT64Context::prepare_state(const std::vector<uint8_t>& image) {
+    if (!state_operation_active) throw std::runtime_error("Renderer state preparation requires owner barrier");
+    struct Prepared final : ultramodern::renderer::PreparedRendererState {
+        RT64::PreparedRendererState state;
+        explicit Prepared(RT64::State& live, const std::vector<uint8_t>& bytes) : state(live, bytes) {}
+        void commit() noexcept override { state.commit(); }
+    };
+    return std::make_unique<Prepared>(*app->state, image);
+}
