+std::vector<std::string> get_reimplemented_funcs(const toml::table* patches_data) {
+    const auto node = (*patches_data)["reimplemented"];
+    std::vector<std::string> result;
+    if (!node) return result;
+    if (!node.is_array()) {
+        throw toml::parse_error("reimplemented must be an array of function names", node.node()->source());
+    }
+    std::unordered_set<std::string> seen;
+    for (const auto& value : *node.as_array()) {
+        auto name = value.value_exact<std::string>();
+        if (!name || name->empty() || !seen.emplace(*name).second) {
+            throw toml::parse_error("Invalid or duplicate reimplemented function", value.source());
+        }
+        result.push_back(*name);
+    }
+    return result;
+}
