+        void audioError(uint64_t stream, uint64_t reason) {
+            state().invalidEvents.fetch_add(1, std::memory_order_relaxed);
+            PerformanceProfiler::recordCriticalInstant(PerformanceCategory::CPU,
+                "Audio.InstrumentationError", stream, reason);
+        }
+
+        AudioStreamRecord *audioStream(uint64_t stream, bool create = false, bool realtime = false) {
+            auto &profiler = state();
+            if (!profiler.accepting.load(std::memory_order_acquire)) return nullptr;
+            const auto invalid = [&](uint64_t reason) {
+                if (realtime) {
+
+                    profiler.invalidEvents.fetch_add(1, std::memory_order_relaxed);
+                    profiler.droppedEvents.fetch_add(1, std::memory_order_relaxed);
+                }
+                else audioError(stream, reason);
+            };
+            if (!stream) { invalid(1); return nullptr; }
+
+            const size_t first = size_t((stream ^ (stream >> 32)) % profiler.audioStreams.size());
+            for (size_t probe = 0; probe < profiler.audioStreams.size(); ++probe) {
+                auto &entry = profiler.audioStreams[(first + probe) % profiler.audioStreams.size()];
+                uint64_t identity = entry.identity.load(std::memory_order_acquire);
+                if (!identity && create && entry.identity.compare_exchange_strong(identity, stream,
+                    std::memory_order_acq_rel)) return &entry;
+                if (identity == stream) {
+                    if (!create) return &entry;
+                    invalid(2);
+                    return nullptr;
+                }
+                if (!identity && !create) break;
+            }
+            invalid(create ? 3 : 4);
+            return nullptr;
+        }
+
+        uint64_t audioContext(uint64_t stream) {
+            auto *entry = audioStream(stream);
+            if (!entry) return 0;
+            const uint64_t context = entry->context.load(std::memory_order_acquire);
+            if (!(context & AudioActive)) { audioError(stream, 5); return 0; }
+            return context;
+        }
+
+        void audioEmit(const char *name, uint64_t stream, uint64_t first = 0, uint64_t second = 0) {
+            PerformanceProfiler::recordCriticalInstant(PerformanceCategory::CPU, name, stream, first, second);
+        }
+
+        void audioEmitContext(uint64_t stream, uint64_t context) {
+            audioEmit("Audio.StreamContext", stream, context & 0xffffffff, (context >> 32) & 0xff);
+        }
+
+        ThreadBuffer *prepareAudioCallbackBuffer(ProfilerState &profiler) {
+            ThreadBuffer *buffer = claimProducerStorage(profiler);
+            if (buffer) buffer->retentionExhausted = true;
+            return buffer;
+        }
+
+        struct AudioCallbackWriter {
+            ProfilerState &profiler;
+            AudioStreamRecord *entry=nullptr;
+            uint64_t stream, context=0;
+            explicit AudioCallbackWriter(uint64_t identity) : profiler(state()), stream(identity) {
+                profiler.activeWriters.fetch_add(1,std::memory_order_acq_rel);
+                if (!profiler.accepting.load(std::memory_order_acquire) || !profiler.recording.load(std::memory_order_acquire)) return;
+                auto *candidate=audioStream(stream,false,true);
+                if (!candidate) return;
+                context=candidate->context.load(std::memory_order_acquire);
+                if (!(context&AudioActive) || candidate->callbackWriting.test_and_set(std::memory_order_acquire)) {
+                    invalid(); return;
+                }
+                entry=candidate;
+            }
+            ~AudioCallbackWriter() {
+                if (entry) entry->callbackWriting.clear(std::memory_order_release);
+                profiler.activeWriters.fetch_sub(1,std::memory_order_release);
+            }
+            void invalid() {
+                profiler.invalidEvents.fetch_add(1,std::memory_order_relaxed);
+                profiler.droppedEvents.fetch_add(1,std::memory_order_relaxed);
+            }
+            void emit(const char *name,uint64_t first,uint64_t second) {
+                Event event;
+                copyEventName(event,name);
+                event.timestampNanoseconds=PerformanceProfiler::nowNanoseconds();
+                event.correlationId=stream;event.argument0=first;event.argument1=second;
+                event.category=PerformanceCategory::CPU;event.kind=EventKind::Instant;
+                event.producerSequence=nextProducerSequence();
+                event.threadId=passiveThreadId(profiler);event.osThreadId=nativeThreadId();
+                if (profiler.passiveRing) profiler.passiveRing->append(event);
+                else if (entry->callbackBuffer) {
+                    if (profiler.incidentRing) profiler.incidentRing->append(event);
+                    appendStreamedJournalEvent(profiler,*entry->callbackBuffer,event);
+                }
+                else invalid();
+            }
+        };
