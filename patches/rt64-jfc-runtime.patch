diff --git a/src/hle/rt64_camera_sample.h b/src/hle/rt64_camera_sample.h
new file mode 100644
index 0000000..babfe26
--- /dev/null
+++ b/src/hle/rt64_camera_sample.h
@@ -0,0 +1,98 @@
+#pragma once
+#include <cmath>
+#include <cstdint>
+#include <limits>
+#include <stdexcept>
+#include "common/rt64_math.h"
+
+namespace RT64 {
+    struct NativeCameraSample {
+        uint32_t matrixAddress = 0;
+        uint32_t cameraId = 0;
+        uint64_t generation = 0;
+        hlslpp::float4x4 view, projection;
+        float billboardScale = 0;
+    };
+
+    struct CameraAcquisition {
+        NativeCameraSample sample;
+        DecomposedTransform pose;
+        hlslpp::float4x4 endpoint, projection, residual;
+        uint32_t transformIndex = UINT32_MAX;
+        uint32_t previousWorkload = UINT32_MAX;
+        uint32_t previousAcquisition = UINT32_MAX;
+
+        static hlslpp::float4x4 poseMatrix(const DecomposedTransform &value) {
+            return recomposeMatrix(value.rotation, hlslpp::float3(1.0f), hlslpp::float3(0.0f),
+                value.translation, hlslpp::float4(0, 0, 0, 1));
+        }
+
+        void initialize(const NativeCameraSample &source, const hlslpp::float4x4 &fixed,
+            const hlslpp::float4x4 &postProjection, uint32_t transform) {
+            const auto requireFinite = [](const hlslpp::float4x4 &matrix) {
+                for (uint32_t row = 0; row < 4; ++row)
+                    for (uint32_t col = 0; col < 4; ++col)
+                        if (!std::isfinite(float(matrix[row][col])))
+                            throw std::runtime_error("Non-finite native camera factor");
+            };
+            requireFinite(source.view);
+            requireFinite(source.projection);
+            requireFinite(fixed);
+            requireFinite(postProjection);
+            if (!std::isfinite(source.billboardScale) || source.billboardScale < 0)
+                throw std::runtime_error("Invalid native camera billboard lens");
+            sample = source;
+            transformIndex = transform;
+            const auto nativeCombined = hlslpp::mul(source.view, source.projection);
+
+            for (uint32_t row = 0; row < 4; ++row)
+                for (uint32_t col = 0; col < 4; ++col) {
+                    float magnitude = 0.0f;
+                    for (uint32_t k = 0; k < 4; ++k)
+                        magnitude += std::abs(float(source.view[row][k]) * float(source.projection[k][col]));
+
+                    const float bound = 8.0f * std::numeric_limits<float>::epsilon() * magnitude + 1.0f / 65536.0f;
+                    if (!std::isfinite(magnitude) || !std::isfinite(float(nativeCombined[row][col])) ||
+                        std::abs(float(nativeCombined[row][col] - fixed[row][col])) > bound)
+                        throw std::runtime_error("Camera sample does not reproduce native matrix DMA");
+                }
+            if (std::abs(float(source.view[0].w)) > 1e-6f ||
+                std::abs(float(source.view[1].w)) > 1e-6f ||
+                std::abs(float(source.view[2].w)) > 1e-6f ||
+                std::abs(float(source.view[3].w) - 1.0f) > 1e-6f)
+                throw std::runtime_error("Native camera view is not affine");
+            const auto inverseView = hlslpp::inverse(source.view);
+            requireFinite(inverseView);
+            pose = DecomposedTransform(inverseView);
+            if (!pose.valid || pose.coordinateFlip)
+                throw std::runtime_error("Native camera pose is invalid");
+            pose.rotation = hlslpp::normalize(pose.rotation);
+            const auto rigidPose = poseMatrix(pose);
+            requireFinite(rigidPose);
+
+            projection = hlslpp::mul(hlslpp::mul(rigidPose, source.view),
+                hlslpp::mul(source.projection, postProjection));
+            endpoint = hlslpp::mul(fixed, postProjection);
+            requireFinite(projection);
+            requireFinite(endpoint);
+            residual = endpoint - hlslpp::mul(hlslpp::inverse(rigidPose), projection);
+            requireFinite(residual);
+        }
+
+        bool sameDomain(const CameraAcquisition &other) const {
+            return sample.cameraId == other.sample.cameraId && sample.generation == other.sample.generation;
+        }
+
+        hlslpp::float4x4 interpolate(const CameraAcquisition &previous, float weight) const {
+            if (weight <= 0.0f) return previous.endpoint;
+            if (weight >= 1.0f) return endpoint;
+            const auto value = lerpTransforms(previous.pose, pose, weight, true, true, false, false, false, true);
+            hlslpp::float4x4 interpolatedProjection, error;
+            for (uint32_t row = 0; row < 4; ++row) {
+                interpolatedProjection[row] = hlslpp::lerp(previous.projection[row], projection[row], weight);
+                error[row] = hlslpp::lerp(previous.residual[row], residual[row], weight);
+            }
+            return hlslpp::mul(hlslpp::inverse(poseMatrix(value)), interpolatedProjection) + error;
+        }
+    };
+}
