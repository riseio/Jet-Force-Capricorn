new file mode 100644
index 0000000..e1ebfc0
--- /dev/null
+++ b/src/include/rt64_f3ddkr_tracer.h
@@ -0,0 +1,93 @@
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+
+namespace RT64 {
+
+    constexpr uint32_t F3DDKRTracerMarker = 0x00008000U;
+    constexpr uint32_t F3DDKRTracerMagic = 0xA0000000U;
+    constexpr uint32_t F3DDKRTracerIdentityMask = 0x0FFFFFFFU;
+    constexpr uint32_t F3DDKRTracerBytes = 40;
+
+    struct F3DDKRTracer {
+        float endpoints[6] = {};
+        float width = 0;
+        uint32_t identity = 0;
+        uint64_t generation = 0;
+    };
+
+    inline void validateF3DDKRTracer(const F3DDKRTracer &tracer) {
+        for (float value : tracer.endpoints)
+            if (!std::isfinite(value))
+                throw std::runtime_error("F3DDKR tracer: non-finite world endpoint");
+        if (!std::isfinite(tracer.width))
+            throw std::runtime_error("F3DDKR tracer: non-finite width");
+        if ((tracer.identity & ~F3DDKRTracerIdentityMask) || (!tracer.identity && tracer.generation))
+            throw std::runtime_error("F3DDKR tracer: invalid effect identity");
+    }
+
+    inline uint32_t f3ddkrTracerIdentity(uint32_t owner, uint32_t segment) {
+        if (!owner || owner >= 0x800000U || (owner & 3U) || segment >= 128)
+            throw std::runtime_error("F3DDKR tracer: invalid owner or segment");
+        return (owner >> 2) | (segment << 21);
+    }
+
+    inline void validateF3DDKRTracerRange(uint32_t address, uint32_t size) {
+        if ((address & 1U) || (size & 3U) || size < F3DDKRTracerBytes || address > size - F3DDKRTracerBytes)
+            throw std::runtime_error("F3DDKR tracer: invalid 40-byte vertex payload range");
+    }
+
+    inline uint32_t readF3DDKRTracerWord(const uint8_t *rdram, uint32_t address) {
+        uint32_t value = 0;
+        for (uint32_t i = 0; i < 4; ++i)
+            value = (value << 8) | rdram[(address + i) ^ 3U];
+        return value;
+    }
+
+    inline void writeF3DDKRTracerWord(uint8_t *rdram, uint32_t address, uint32_t value) {
+        for (uint32_t i = 0; i < 4; ++i)
+            rdram[(address + i) ^ 3U] = uint8_t(value >> (24U - i * 8U));
+    }
+
+    inline F3DDKRTracer readF3DDKRTracer(const uint8_t *rdram, uint32_t size, uint32_t address) {
+        validateF3DDKRTracerRange(address, size);
+        if (!rdram)
+            throw std::runtime_error("F3DDKR tracer: null RDRAM");
+        const auto header = readF3DDKRTracerWord(rdram, address + 28);
+
+        const bool legacy = header == 0x4A545201U;
+        if ((!legacy && (header & ~F3DDKRTracerIdentityMask) != F3DDKRTracerMagic) ||
+            (legacy && (readF3DDKRTracerWord(rdram, address + 32) || readF3DDKRTracerWord(rdram, address + 36))))
+            throw std::runtime_error("F3DDKR tracer: invalid payload schema");
+        F3DDKRTracer tracer;
+        tracer.identity = legacy ? 0 : header & F3DDKRTracerIdentityMask;
+        tracer.generation = (uint64_t(readF3DDKRTracerWord(rdram, address + 32)) << 32) |
+            readF3DDKRTracerWord(rdram, address + 36);
+        for (uint32_t i = 0; i < 7; ++i) {
+            const uint32_t bits = readF3DDKRTracerWord(rdram, address + i * 4);
+            float &value = i < 6 ? tracer.endpoints[i] : tracer.width;
+            std::memcpy(&value, &bits, sizeof(value));
+        }
+        validateF3DDKRTracer(tracer);
+        return tracer;
+    }
+
+    inline void writeF3DDKRTracer(uint8_t *rdram, uint32_t size, uint32_t address, const F3DDKRTracer &tracer) {
+        validateF3DDKRTracerRange(address, size);
+        validateF3DDKRTracer(tracer);
+        if (!rdram)
+            throw std::runtime_error("F3DDKR tracer: null RDRAM");
+        for (uint32_t i = 0; i < 7; ++i) {
+            const float value = i < 6 ? tracer.endpoints[i] : tracer.width;
+            uint32_t bits;
+            std::memcpy(&bits, &value, sizeof(bits));
+            writeF3DDKRTracerWord(rdram, address + i * 4, bits);
+        }
+        writeF3DDKRTracerWord(rdram, address + 28, F3DDKRTracerMagic | tracer.identity);
+        writeF3DDKRTracerWord(rdram, address + 32, uint32_t(tracer.generation >> 32));
+        writeF3DDKRTracerWord(rdram, address + 36, uint32_t(tracer.generation));
+    }
+}
