+
+namespace RT64::ProfilerDetail {
+
+    class Sha256 {
+        std::array<uint32_t, 8> state = {0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
+            0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19};
+        std::array<uint8_t, 64> pending{};
+        size_t used = 0;
+        uint64_t length = 0;
+        static uint32_t rotate(uint32_t value, unsigned bits) { return (value >> bits) | (value << (32 - bits)); }
+        void block(const uint8_t *data) {
+            constexpr uint32_t constants[] = {
+                0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
+                0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
+                0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+                0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
+                0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
+                0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+                0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
+                0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2};
+            uint32_t words[64];
+            for (unsigned i = 0; i < 16; ++i) words[i] = (uint32_t(data[4*i]) << 24) |
+                (uint32_t(data[4*i+1]) << 16) | (uint32_t(data[4*i+2]) << 8) | data[4*i+3];
+            for (unsigned i = 16; i < 64; ++i) {
+                const uint32_t x = words[i-15], y = words[i-2];
+                words[i] = words[i-16] + (rotate(x,7) ^ rotate(x,18) ^ (x >> 3)) + words[i-7] +
+                    (rotate(y,17) ^ rotate(y,19) ^ (y >> 10));
+            }
+            auto a=state[0], b=state[1], c=state[2], d=state[3], e=state[4], f=state[5], g=state[6], h=state[7];
+            for (unsigned i = 0; i < 64; ++i) {
+                const uint32_t first = h + (rotate(e,6) ^ rotate(e,11) ^ rotate(e,25)) +
+                    ((e & f) ^ (~e & g)) + constants[i] + words[i];
+                const uint32_t second = (rotate(a,2) ^ rotate(a,13) ^ rotate(a,22)) + ((a & b) ^ (a & c) ^ (b & c));
+                h=g; g=f; f=e; e=d+first; d=c; c=b; b=a; a=first+second;
+            }
+            state[0]+=a; state[1]+=b; state[2]+=c; state[3]+=d;
+            state[4]+=e; state[5]+=f; state[6]+=g; state[7]+=h;
+        }
+    public:
+        void update(const void *input, size_t size) {
+            const auto *data = static_cast<const uint8_t *>(input);
+            length += size;
+            while (size) {
+                const size_t part = std::min(size, pending.size() - used);
+                std::memcpy(pending.data() + used, data, part);
+                used += part; data += part; size -= part;
+                if (used == pending.size()) { block(pending.data()); used = 0; }
+            }
+        }
+        uint64_t bytes() const { return length; }
+        std::string hex() const {
+            Sha256 final = *this;
+            uint8_t suffix[128] = {0x80};
+            const size_t padding = used < 56 ? 56 - used : 120 - used;
+            const uint64_t bits = length * 8;
+            for (unsigned i = 0; i < 8; ++i) suffix[padding+i] = uint8_t(bits >> (56-8*i));
+            final.update(suffix, padding+8);
+            std::string result(64, '0');
+            constexpr char digits[] = "0123456789abcdef";
+            for (unsigned i = 0; i < 64; ++i) result[i] = digits[(final.state[i/8] >> (28-4*(i%8))) & 15];
+            return result;
+        }
+    };
+
+    struct ContentDigest {
+        uint64_t bytes = 0;
+        std::string sha256;
+        bool valid = false;
+    };
+
+    template<class Hash = Sha256>
+    class HashingOutput : public std::streambuf {
+        std::streambuf *destination;
+        Hash hash;
+        std::streamsize xsputn(const char *data, std::streamsize count) override {
+            const auto written = destination->sputn(data, count);
+            if (written > 0) hash.update(data, size_t(written));
+            return written;
+        }
+        int_type overflow(int_type character) override {
+            if (traits_type::eq_int_type(character, traits_type::eof())) return traits_type::not_eof(character);
+            const char value = traits_type::to_char_type(character);
+            const auto result = destination->sputc(value);
+            if (!traits_type::eq_int_type(result, traits_type::eof())) hash.update(&value, 1);
+            return result;
+        }
+        int sync() override { return destination->pubsync(); }
+    public:
+        explicit HashingOutput(std::streambuf *destination) : destination(destination) {}
+        ContentDigest digest(bool valid) const {
+            auto value = hash.hex();
+            return {hash.bytes(), value, valid && value.size() == 64};
+        }
+    };
+
+    template<class Hash = Sha256>
+    inline bool verifyContent(const std::filesystem::path &path, const ContentDigest &expected) {
+        if (!expected.valid) return false;
+        std::error_code error;
+        const auto before = std::filesystem::last_write_time(path, error);
+        if (error || std::filesystem::file_size(path, error) != expected.bytes || error) return false;
+        std::ifstream input(path, std::ios::binary);
+        Hash hash;
+        std::array<char, 65536> buffer;
+        uint64_t remaining = expected.bytes;
+        while (remaining) {
+            const auto size = std::streamsize(std::min<uint64_t>(remaining, buffer.size()));
+            if (!input.read(buffer.data(), size)) return false;
+            hash.update(buffer.data(), size_t(size));
+            remaining -= uint64_t(size);
+        }
+        if (input.peek() != std::char_traits<char>::eof() || input.bad()) return false;
+        const auto after = std::filesystem::last_write_time(path, error);
+        return !error && before == after && hash.hex() == expected.sha256;
+    }
+}
diff --git a/src/common/rt64_profiler_summary.h b/src/common/rt64_profiler_summary.h
new file mode 100644
index 0000000..7ff1f74
--- /dev/null
+++ b/src/common/rt64_profiler_summary.h
@@ -0,0 +1,68 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <limits>
+#include <vector>
+
+namespace RT64::ProfilerDetail {
+    class SampleDistribution {
+        std::vector<double> values;
+        mutable std::vector<double> sorted;
+    public:
+        void emplace_back(double value) { values.emplace_back(value); }
+        size_t size() const { return values.size(); }
+        bool empty() const { return values.empty(); }
+        double percentile(double fraction) const {
+            if (values.empty()) return 0.0;
+            if (sorted.size() != values.size()) {
+                sorted = values;
+                std::sort(sorted.begin(), sorted.end());
+            }
+            const double position = fraction * double(sorted.size() - 1);
+            const size_t lower = size_t(std::floor(position));
+            const size_t upper = size_t(std::ceil(position));
+            const double weight = position - double(lower);
+            return sorted[lower] * (1.0 - weight) + sorted[upper] * weight;
+        }
+    };
+
+    class IntervalIndex {
+        struct Entry { uint64_t start, end, maximum; size_t index; };
+        std::vector<Entry> entries;
+        uint64_t build(size_t first, size_t last) {
+            if (first == last) return 0;
+            const size_t middle = first + (last - first) / 2;
+            return entries[middle].maximum = std::max({entries[middle].end,
+                build(first, middle), build(middle + 1, last)});
+        }
+        void query(size_t first, size_t last, uint64_t start, uint64_t end,
+                   std::vector<size_t>& matches) const {
+            if (first == last) return;
+            const size_t middle = first + (last - first) / 2;
+            const auto& entry = entries[middle];
+            if (entry.maximum < start || entries[first].start > end) return;
+            query(first, middle, start, end, matches);
+            if (entry.start <= end && entry.end >= start) matches.push_back(entry.index);
+            if (entry.start <= end) query(middle + 1, last, start, end, matches);
+        }
+    public:
+        void reserve(size_t count) { entries.reserve(count); }
+        void add(uint64_t start, uint64_t duration) {
+            const auto end = duration > UINT64_MAX - start ? UINT64_MAX : start + duration;
+            entries.push_back({start, end, 0, entries.size()});
+        }
+        void finish() {
+            std::sort(entries.begin(), entries.end(), [](const Entry& a, const Entry& b) {
+                return a.start < b.start || (a.start == b.start && a.index < b.index);
+            });
+            build(0, entries.size());
+        }
+        void overlapping(uint64_t start, uint64_t end, std::vector<size_t>& matches) const {
+            matches.clear();
+            if (start <= end) query(0, entries.size(), start, end, matches);
+            std::sort(matches.begin(), matches.end());
+        }
+    };
+}
