@@ -0,0 +1,32 @@
+#pragma once
+
+#include "render/rt64_render_worker_queue_state.h"
+
+namespace RT64 {
+    struct IdleActivity {
+        uint64_t workload = 0, present = 0;
+        bool supplied(uint64_t currentWorkload, uint64_t currentPresent) {
+            const bool changed = workload != currentWorkload || present != currentPresent;
+            workload = currentWorkload;
+            present = currentPresent;
+            return changed;
+        }
+    };
+
+    inline bool isIdleMaintenanceQueueAvailable(
+        RenderWorkerQueueWorkState state
+    ) {
+        return (state == RenderWorkerQueueWorkState::NoSubmission) ||
+            (state == RenderWorkerQueueWorkState::CompletedOnly);
+    }
+
+    inline bool shouldSubmitIdleMaintenance(
+        RenderWorkerQueueWorkState workloadState,
+        RenderWorkerQueueWorkState presentState,
+        bool interpolationPending
+    ) {
+        return isIdleMaintenanceQueueAvailable(workloadState) &&
+            isIdleMaintenanceQueueAvailable(presentState) &&
+            !interpolationPending;
+    }
+}
diff --git a/src/hle/rt64_interpolation_coverage.h b/src/hle/rt64_interpolation_coverage.h
new file mode 100644
index 0000000..b0fa8d9
--- /dev/null
+++ b/src/hle/rt64_interpolation_coverage.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+namespace RT64 {
+
+    inline constexpr uint32_t MaximumInterpolationTargets = 18;
+
+    constexpr uint32_t interpolationOutputCapacity(uint32_t targetRate) {
+        return targetRate <= 240U ? 12U : MaximumInterpolationTargets;
+    }
+
+    constexpr uint32_t interpolationRateForCapacity(
+        uint32_t targetRate,
+        uint32_t sourceRate,
+        uint32_t maximumFrames
+    ) {
+        if ((targetRate == 0U) || (sourceRate == 0U) ||
+            (maximumFrames == 0U)) {
+            return sourceRate;
+        }
+
+        const uint32_t minimumRate =
+            (targetRate / maximumFrames) +
+            ((targetRate % maximumFrames) != 0U ? 1U : 0U);
+        return std::max(sourceRate, minimumRate);
+    }
+}
diff --git a/src/hle/rt64_interpolation_queue_order.h b/src/hle/rt64_interpolation_queue_order.h
new file mode 100644
index 0000000..a3116e5
--- /dev/null
+++ b/src/hle/rt64_interpolation_queue_order.h
@@ -0,0 +1,86 @@
+#pragma once
+
+#include <cstdint>
+
+namespace RT64 {
+    enum class InterpolationQueueOrder {
+        IndependentNativeQueues,
+        SharedNativeQueue
+    };
+
+    constexpr InterpolationQueueOrder interpolationQueueOrder(
+        bool workloadAndPresentShareNativeQueue) {
+        return workloadAndPresentShareNativeQueue
+            ? InterpolationQueueOrder::SharedNativeQueue
+            : InterpolationQueueOrder::IndependentNativeQueues;
+    }
+
+    constexpr bool requiresCpuPresentSubmissionOrder(
+        InterpolationQueueOrder order) {
+
+        return order == InterpolationQueueOrder::SharedNativeQueue;
+    }
+
+    constexpr bool canSubmitInterpolatedTarget(
+        InterpolationQueueOrder order,
+        uint32_t targetIndex,
+        uint32_t presentQueued,
+        uint32_t presentCompleted
+    ) {
+        if ((targetIndex == 0U) ||
+            (order == InterpolationQueueOrder::IndependentNativeQueues)) {
+            return true;
+        }
+
+        return (presentQueued >= targetIndex) ||
+            (presentCompleted >= targetIndex);
+    }
+
+    constexpr bool canSubmitCpuCompletedTarget(
+        InterpolationQueueOrder order,
+        uint32_t targetIndex,
+        bool previousPending,
+        uint32_t previousCount,
+        uint32_t previousQueued,
+        uint32_t previousCompleted
+    ) {
+        if (!requiresCpuPresentSubmissionOrder(order) || !previousPending) {
+            return true;
+        }
+
+        const uint32_t required = (targetIndex < previousCount)
+            ? targetIndex + 1U : previousCount;
+        return previousQueued >= required || previousCompleted >= required;
+    }
+
+    constexpr uint32_t completedInterpolatedOutputCount(
+        uint32_t outputIndex,
+        uint32_t outputCount
+    ) {
+
+        return (outputIndex < outputCount) ? (outputIndex + 1U) : outputCount;
+    }
+
+    constexpr bool interpolationOutputExhausted(
+        uint32_t outputIndex,
+        uint32_t availableOutputCount,
+        bool batchSkipped
+    ) {
+
+        return batchSkipped && (availableOutputCount <= outputIndex);
+    }
+
+    constexpr uint32_t publishCompletedInterpolatedOutputCount(
+        uint32_t currentCompleted,
+        uint32_t transactionCompleted,
+        uint32_t outputCount
+    ) {
+        const uint32_t boundedCompleted =
+            (transactionCompleted < outputCount)
+                ? transactionCompleted
+                : outputCount;
+        return (currentCompleted < boundedCompleted)
+            ? boundedCompleted
+            : currentCompleted;
+    }
+}
