diff --git a/src/render/rt64_queue_admission.h b/src/render/rt64_queue_admission.h
new file mode 100644
index 0000000..02f9292
--- /dev/null
+++ b/src/render/rt64_queue_admission.h
@@ -0,0 +1,24 @@
+#pragma once
+#include <atomic>
+#include <mutex>
+
+namespace RT64 {
+
+    struct QueueAdmission {
+        std::mutex mutex;
+        std::atomic_uint32_t requests{0};
+        struct Request {
+            QueueAdmission &owner;
+            explicit Request(QueueAdmission &owner) : owner(owner) { owner.requests.fetch_add(1, std::memory_order_acq_rel); }
+            ~Request() { owner.requests.fetch_sub(1, std::memory_order_release); }
+            Request(const Request &) = delete;
+            Request &operator=(const Request &) = delete;
+        };
+        std::unique_lock<std::mutex> tryMaintenance() {
+            std::unique_lock lock(mutex, std::defer_lock);
+            if (requests.load(std::memory_order_acquire) == 0 && lock.try_lock() &&
+                requests.load(std::memory_order_acquire) != 0) lock.unlock();
+            return lock;
+        }
+    };
+}
