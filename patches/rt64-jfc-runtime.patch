+        struct HostResourceSamplerState {
+            std::unordered_map<uint32_t, uint64_t> previousProcessCpu;
+            std::unordered_map<uint32_t, uint64_t>
+                previousProcessGpuNanoseconds;
+            uint64_t previousSystemTotal = 0;
+            uint64_t previousSystemIdle = 0;
+            long clockTicks = std::max<long>(sysconf(_SC_CLK_TCK), 1);
+            long pageSize = std::max<long>(sysconf(_SC_PAGESIZE), 1);
+            uint32_t logicalProcessorCount = std::max(
+                std::thread::hardware_concurrency(),
+                1u
+            );
+        };
