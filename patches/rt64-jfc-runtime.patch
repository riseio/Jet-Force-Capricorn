+        AttachmentGroupLease(AttachmentGroupLease &&other) noexcept : value(std::exchange(other.value, 0)) {}
+        AttachmentGroupLease &operator=(AttachmentGroupLease &&other) noexcept {
+            if (this != &other) { finish(false); value = std::exchange(other.value, 0); }
+            return *this;
+        }
+        ~AttachmentGroupLease() { finish(false); }
+        uint64_t id() const { return value; }
