diff --git a/src/shaders/StateReadCS.hlsl b/src/shaders/StateReadCS.hlsl
new file mode 100644
index 0000000..c1257fb
--- /dev/null
+++ b/src/shaders/StateReadCS.hlsl
@@ -0,0 +1,18 @@
+struct StateCB { uint width; uint rows; uint firstRow; uint sampleIndex; };
+[[vk::push_constant]] ConstantBuffer<StateCB> state : register(b0);
+#ifdef MULTISAMPLING
+Texture2DMS<float4> source : register(t1);
+#else
+Texture2D<float4> source : register(t1);
+#endif
+RWStructuredBuffer<float4> destination : register(u2);
+[numthreads(8, 8, 1)]
+void CSMain(uint2 p : SV_DispatchThreadID) {
+    if (p.x >= state.width || p.y >= state.rows) return;
+    uint2 q = uint2(p.x, p.y + state.firstRow);
+#ifdef MULTISAMPLING
+    destination[p.y * state.width + p.x] = source.Load(q, state.sampleIndex);
+#else
+    destination[p.y * state.width + p.x] = source.Load(uint3(q, 0));
+#endif
+}
