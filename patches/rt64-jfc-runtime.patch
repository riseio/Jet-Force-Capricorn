@@ -0,0 +1,69 @@
+#pragma once
+#include <cstdint>
+#include <array>
+#include "common/rt64_performance_profiler.h"
+#include "rt64_render_worker.h"
+#include "shared/rt64_hlsl.h"
+#include "rt64_descriptor_sets.h"
+#if __has_include("rt64_conforming_mesh.h")
+#include "rt64_conforming_mesh.h"
+#define RT64_PROFILER_CONFORMING_SUPPORT 1
+#endif
+
+namespace RT64 {
+    struct Workload;
+    struct GameFrameMap;
+    struct RenderTarget;
+    struct ShaderLibrary;
+    struct GeometryReadback;
+
+    bool profileGeometry(const Workload &workload, const GameFrameMap &map,
+        uint32_t workloadIndex, uint64_t output, float weight,
+        bool processedTransforms, bool processedProjections, GeometryReadback &capture);
+    bool geometryGPUEnabled();
+    void profileGeometryRasterState(uint32_t call, const hlslpp::float2 &resolution,
+        const RenderViewport &viewport, const RenderRect &scissor,
+        const hlslpp::float2 &scale, const hlslpp::float2 &offset, uint32_t flags,
+        const hlslpp::float2 &primDepth, const RenderMultisampling &multisampling);
+    void profileGeometryRasterSubmitted(uint32_t call);
+    std::unique_ptr<RenderBuffer> recordGeometryReadback(RenderWorker *worker,
+        const Workload &workload);
+    struct GeometryDepthStorage {
+        std::unique_ptr<RenderBuffer> gpu, readback;
+        std::unique_ptr<GeometryDepthDescriptorSet> descriptors;
+        uint64_t bytes = 0;
+        bool mapped = false;
+        ~GeometryDepthStorage();
+    };
+
+    class GeometryDepthPool {
+        struct Impl;
+        std::unique_ptr<Impl> impl;
+    public:
+        explicit GeometryDepthPool(RenderDevice *device);
+        ~GeometryDepthPool();
+        std::shared_ptr<GeometryDepthStorage> acquire(uint64_t bytes);
+    };
+    struct GeometryDepthReadback {
+        std::shared_ptr<GeometryDepthStorage> storage;
+        uint32_t framebuffer = 0, width = 0, height = 0, samples = 0;
+    };
+    struct GeometryReadback {
+        AttachmentGroupLease group;
+        bool succeeded = true;
+        std::unique_ptr<RenderBuffer> buffer;
+        uint64_t workloadId = 0, output = 0;
+        uint32_t vertexCount = 0;
+        bool pending = false;
+#ifdef RT64_PROFILER_CONFORMING_SUPPORT
+        std::vector<ConformingDerivedVertex> derived;
+#endif
+        std::vector<GeometryDepthReadback> depth;
+    };
+    bool geometryCoverageEnabled();
+    void recordGeometryDepth(RenderWorker *worker, RenderTarget &target,
+        const ShaderLibrary &shaders, uint32_t framebuffer, GeometryReadback &capture,
+        RenderTextureLayout restoreLayout, GeometryDepthPool &pool);
+    void finishGeometryDepth(GeometryReadback &capture);
+    void finishGeometryReadback(GeometryReadback &readback);
+}
diff --git a/src/render/rt64_geometry_records.h b/src/render/rt64_geometry_records.h
new file mode 100644
index 0000000..82aea2f
--- /dev/null
+++ b/src/render/rt64_geometry_records.h
@@ -0,0 +1,71 @@
+#pragma once
+#include "common/rt64_performance_profiler.h"
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace RT64 {
+
+inline constexpr const char *GeometryRecordNames[] = {
+    "Geometry.VertexOwner", "Geometry.SourceXY", "Geometry.SourceZW", "Geometry.NativeXY", "Geometry.NativeZW",
+    "Geometry.RebuiltXY", "Geometry.RebuiltZW", "Geometry.RenderXY", "Geometry.RenderZW", "Geometry.VertexState",
+    "Geometry.IndexPair", "Geometry.InvalidModify", "Geometry.RepeatedModify", "Geometry.InvalidVertex",
+    "Geometry.SourceAddressUnavailable", "Geometry.DrawRange", "Geometry.DrawMode", "Geometry.DrawOwner",
+    "Geometry.DrawIdentity", "Geometry.DrawAlpha", "Geometry.DrawAlphaCompare", "Geometry.DrawCombiner",
+    "Geometry.GPUXY", "Geometry.GPUZW", "Geometry.InvalidGPU",
+    "Geometry.GPUHomogeneousXY", "Geometry.GPUHomogeneousZW"
+};
+class GeometryRecords {
+    struct Record { uint32_t field, reserved = 0; uint64_t a, b; };
+    static_assert(sizeof(Record) == 24);
+    static constexpr size_t Limit = (16 * 1024 * 1024) / sizeof(Record);
+    std::vector<Record> records;
+    uint64_t workload, output;
+    uint64_t group;
+    bool gpu, rejected = false;
+public:
+    GeometryRecords(uint64_t workload, uint64_t output, bool gpu, size_t expected, uint64_t group = 0) : workload(workload), output(output), group(group), gpu(gpu) {
+        try { records.reserve(std::min(Limit, expected)); }
+        catch (const std::bad_alloc &) { rejected = true; }
+    }
+    void event(const char *name, uint64_t a, uint64_t b) {
+        for (uint32_t field = 0; field < std::size(GeometryRecordNames); ++field) {
+            if (std::strcmp(name, GeometryRecordNames[field]) != 0) continue;
+            if (rejected || records.size() == Limit) { rejected = true; return; }
+            try {
+                if (records.size() == records.capacity()) records.reserve(std::min(Limit, std::max(size_t(64), records.capacity() * 2)));
+            }
+            catch (const std::bad_alloc &) { rejected = true; return; }
+            records.push_back({field, 0, a, b});
+            return;
+        }
+        if (group) PerformanceProfiler::recordAttachmentInstant(group,name,workload,a,b);
+        else PerformanceProfiler::recordCriticalInstant(PerformanceCategory::Counter, name, workload, a, b);
+    }
+    bool finish() try {
+        if (rejected) {
+            event("Geometry.Rejected",output,records.size());
+            return false;
+        }
+
+        struct Header { uint64_t magic, workload, output, count; };
+        const Header header{0x314f454734364eULL, workload, output, records.size()};
+        std::vector<uint8_t> bytes(sizeof(header) + records.size() * sizeof(Record));
+        std::memcpy(bytes.data(), &header, sizeof(header));
+        if (!records.empty()) std::memcpy(bytes.data() + sizeof(header), records.data(), records.size() * sizeof(Record));
+        std::string suffix = std::string(".geometry-") + (gpu ? "gpu-" : "cpu-") + std::to_string(workload) + "-" + std::to_string(output) + ".bin";
+        const bool accepted = PerformanceProfiler::writeOwnedAttachment(suffix, std::move(bytes),
+            PerformanceAttachmentChecksum::CRC32,
+            gpu ? "Geometry.BinaryGPU" : "Geometry.BinaryCPU", workload, output, 0, "Geometry.Aborted",group);
+        if (!accepted) {
+            event("Geometry.Aborted",output,gpu ? 2 : 1);
+        }
+        return accepted;
+    } catch (const std::bad_alloc &) {
+        event("Geometry.Rejected",output,records.size());
+        return false;
+    }
+};
+}
