@@ -0,0 +1,49 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+#include "common/rt64_common.h"
+#include "shared/rt64_hlsl.h"
+#include "../../include/rt64_extended_gbi.h"
+
+namespace RT64 {
+
+    inline float rectangleAspectScale(uint8_t aspect, float nativePixelRatio,
+        float automaticRatio, bool tileCopy, bool coversWidth) {
+        if (aspect == G_EX_ASPECT_ADJUST) return nativePixelRatio;
+        if (aspect == G_EX_ASPECT_STRETCH || aspect == G_EX_ASPECT_COVER)
+            return 1.0f;
+        return (tileCopy || coversWidth) ? 1.0f : automaticRatio;
+    }
+
+    inline interop::float2 presentationCoverScale(float widthRatio, float projectionScaleX) {
+
+        const float cover = std::max(1.0f, widthRatio);
+        return { cover / (widthRatio * projectionScaleX), cover };
+    }
+
+    inline bool projectionCoversAspectWidth(
+        const FixedRect &intersectionRect,
+        const FixedRect &framebufferPairRect,
+        uint32_t nativeFramebufferWidth
+    ) {
+        if (intersectionRect.isEmpty()) {
+            return false;
+        }
+
+        const bool coversPairWidth =
+            intersectionRect.ulx <= framebufferPairRect.ulx &&
+            intersectionRect.lrx >= framebufferPairRect.lrx;
+        if (coversPairWidth) {
+            return true;
+        }
+
+        const uint64_t nativeRight =
+            static_cast<uint64_t>(nativeFramebufferWidth) * 4ULL;
+        return nativeFramebufferWidth != 0U &&
+            intersectionRect.ulx <= 0 &&
+            static_cast<int64_t>(intersectionRect.lrx) >=
+                static_cast<int64_t>(nativeRight);
+    }
+}
