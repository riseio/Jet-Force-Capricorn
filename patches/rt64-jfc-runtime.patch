--- /dev/null
+++ b/src/shared/rt64_texture_footprint.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#ifdef HLSL_CPU
+#include <algorithm>
+#include <cmath>
+#include "common/rt64_hlslpp.h"
+#endif
+
+namespace TextureFootprint {
+#ifdef HLSL_CPU
+    using hlslpp::float2;
+    using std::isfinite;
+    using std::log2;
+    using std::min;
+    using std::max;
+#endif
+
+    inline float2 gradient(float2 inputGradient, float2 coordinateScale) {
+        return inputGradient * coordinateScale;
+    }
+
+    inline float mipLevel(float squaredFootprint, float maximumLevel) {
+        if (!isfinite(squaredFootprint)) return maximumLevel;
+        return min(max(0.5f * log2(max(squaredFootprint, 1e-20f)) - 0.25f, 0.0f), maximumLevel);
+    }
+}
