+        bool writeIncidentSnapshot(ProfilerState &profiler, uint64_t generation) {
+            if (generation > profiler.maximumIncidents) return false;
+            auto *ring = profiler.passiveRing ? profiler.passiveRing.get() : profiler.incidentRing.get();
+            if (!ring) return false;
+            uint64_t busy = 0;
+            const auto events = ring->snapshot(busy);
+            std::filesystem::path base = profiler.outputPath;
+            base += ".snapshot-" + std::to_string(generation) + ".json";
+            const std::filesystem::path journalPath = base.string() + ".journal.jsonl";
+            const std::filesystem::path summaryPath = base.string() + ".summary.json";
+            if (std::filesystem::exists(journalPath) || std::filesystem::exists(summaryPath)) return false;
+            if (profiler.snapshotBytes >= profiler.maximumSnapshotBytes) return false;
+            std::ofstream journalFile(journalPath, std::ios::binary);
+            if (!journalFile) return false;
+            const uint64_t available = profiler.maximumSnapshotBytes - profiler.snapshotBytes;
+            RecordLimitedOutput limited(journalFile.rdbuf(), available);
+            std::ostream journal(&limited);
+            journal << "{\"record\":\"header\",\"schema\":\"rt64-performance-journal-v1\"}\n";
+            std::map<std::string, std::string> metadata;
+            { const std::scoped_lock lock(profiler.metadataMutex); metadata = profiler.metadata; }
+            for (const auto &entry : metadata) journal << "{\"record\":\"metadata\",\"key\":\""
+                << jsonEscape(entry.first) << "\",\"value\":\"" << jsonEscape(entry.second) << "\"}\n";
+            for (const auto &event : events) writeJournalEvent(journal, event);
+            journal.flush();
+            const bool healthy = journal.good();
+            journalFile.close();
+            profiler.snapshotBytes += available - limited.unused();
+            if (!healthy || journalFile.fail()) return false;
+            std::ofstream summary(summaryPath, std::ios::binary);
+            summary << "{\"schema\":\"n64profiler-snapshot-v1\",\"analysis_scope\":\"ROLLING_EVENT_WINDOW\",\"budget_ms\":"
+                << profiler.budgetMilliseconds << ",\"durability\":{\"journal_healthy\":true,\"journal_events_written\":"
+                << events.size() << ",\"events_dropped\":" << busy + ring->dropped()
+                << ",\"events_streamed_only\":0},\"snapshot_generation\":" << generation << "}\n";
+            summary.flush();
+            const bool written = summary.good();
+            summary.close();
+            return written && !summary.fail();
+        }
+
+        void startControlObservation(ProfilerState &profiler) {
+            std::error_code error;
+            std::filesystem::create_directories(profiler.controlPath, error);
+            if (error) { profiler.invalidEvents.fetch_add(1); return; }
+            profiler.controlRunning.store(true);
+            profiler.controlThread = std::thread([&profiler]() {
+                uint64_t lastRequest = 0;
+                uint64_t &generation = profiler.snapshotGeneration;
+                std::string result = "ready";
+                const auto requestPath = profiler.controlPath / "command.txt";
+                const auto processingPath = profiler.controlPath / "processing.txt";
+                const auto statusPath = profiler.controlPath / "status.json";
+                const auto statusTemporary = profiler.controlPath / "status.json.tmp";
+                while (profiler.controlRunning.load(std::memory_order_acquire)) {
+                    try {
+                        std::error_code error;
+                        if (std::filesystem::exists(requestPath) && !std::filesystem::exists(processingPath)) {
+                            std::filesystem::rename(requestPath, processingPath, error);
+                            if (!error) {
+                                if (std::filesystem::file_size(processingPath) > 512) result = "rejected_oversized_command";
+                                else {
+                                    std::ifstream request(processingPath);
+                                    uint64_t identity = 0;
+                                    std::string command;
+                                    request >> identity >> command;
+                                    if (!request || identity <= lastRequest) result = "rejected_stale_or_invalid_command";
+                                    else {
+                                        lastRequest = identity;
+                                        result = "ok";
+                                        if (command == "start") {
+                                            profiler.resumeTimestamp.store(PerformanceProfiler::nowNanoseconds(), std::memory_order_release);
+                                            profiler.recording.store(true, std::memory_order_release);
+                                            PerformanceProfiler::recordCriticalInstant(PerformanceCategory::CPU, "Recorder.CaptureStarted", identity);
+                                        }
+                                        else if (command == "stop") {
+                                            profiler.attachments.setWindow(0);
+                                            PerformanceProfiler::recordCriticalInstant(PerformanceCategory::CPU, "Recorder.CaptureStopped", identity);
+                                            profiler.recording.store(false, std::memory_order_release);
+                                            result = writeIncidentSnapshot(profiler, ++generation) ? "snapshot_written" : "snapshot_failed";
+                                        }
+                                        else if (command == "capture-geometry") {
+                                            uint32_t count = 0;
+                                            std::string extra;
+                                            if (!(request >> count) || count < 1 || count > 256 || (request >> extra))
+                                                result = "rejected_invalid_capture_window";
+                                            else if (!profiler.recording.load()) result = "rejected_not_recording";
+                                            else {
+                                                profiler.attachments.setWindow(count);
+                                                PerformanceProfiler::recordCriticalInstant(PerformanceCategory::CPU,"Recorder.GeometryWindow",identity,count);
+                                            }
+                                        }
+                                        else if (command == "stop-geometry") {
+                                            profiler.attachments.setWindow(0);
+                                            PerformanceProfiler::recordCriticalInstant(PerformanceCategory::CPU,"Recorder.GeometryWindow",identity,0);
+                                        }
+                                        else if (command == "mark") {
+                                            if (!profiler.recording.load()) result = "rejected_not_recording";
+                                            else {
+                                                PerformanceProfiler::recordCriticalInstant(PerformanceCategory::CPU, "Recorder.Marker", identity);
+                                                profiler.incidentDeadline.store(PerformanceProfiler::nowNanoseconds() + profiler.incidentPostNanoseconds);
+                                            }
+                                        }
+                                        else if (command == "snapshot") result = writeIncidentSnapshot(profiler, ++generation) ? "snapshot_written" : "snapshot_failed";
+                                        else if (command != "status") result = "rejected_unknown_command";
+                                    }
+                                }
+                                std::filesystem::remove(processingPath, error);
+                            }
+                        }
+                        const uint64_t deadline = profiler.incidentDeadline.load(std::memory_order_acquire);
+                        if (deadline && PerformanceProfiler::nowNanoseconds() >= deadline) {
+                            result = writeIncidentSnapshot(profiler, ++generation) ? "snapshot_written" : "snapshot_failed";
+                            profiler.incidentDeadline.store(0, std::memory_order_release);
+                        }
+                        std::vector<ThreadBuffer *> statusBuffers;
+                        { const std::scoped_lock lock(profiler.registryMutex); statusBuffers = profiler.threadBuffers; }
+                        std::ofstream status(statusTemporary, std::ios::binary);
+                        status << "{\"schema\":\"n64profiler-control-v1\",\"pid\":" << profiler.processId
+                            << ",\"capture\":\"" << jsonEscape(profiler.outputPath.u8string())
+                            << "\",\"recording\":" << (profiler.recording.load() ? "true" : "false")
+                            << ",\"gpu_configured\":" << (profiler.gpuInstrumentation ? "true" : "false")
+                            << ",\"gpu_active\":" << (PerformanceProfiler::gpuInstrumentationEnabled() ? "true" : "false")
+                            << ",\"last_request\":" << lastRequest << ",\"result\":\"" << result
+                            << "\",\"snapshot_generation\":" << generation << ",\"heartbeat_ns\":" << PerformanceProfiler::nowNanoseconds()
+                            << ",\"dropped\":" << droppedEventCount(profiler, statusBuffers)
+                            << ",\"host_sampler\":" << (profiler.hostObservationStarted.load() ? "true" : "false")
+                            << ",\"invalid_events\":" << profiler.invalidEvents.load()
+                            << ",\"ring_rejected\":" << (profiler.passiveRing ? profiler.passiveRing->dropped() : 0)
+                            << ",\"ring_submitted\":" << (profiler.passiveRing ? profiler.passiveRing->submitted() : 0)
+                            << ",\"ring_capacity\":" << (profiler.passiveRing ? profiler.maximumEvents : 0)
+                            << ",\"aggregate_storage_bytes\":" << sizeof(profiler.aggregates)
+                            << ",\"stream_high_water_per_thread\":" << profiler.backlogHighWater.load()
+                            << ",\"journal_running\":" << (profiler.checkpointRunning.load() ? "true" : "false")
+                            << ",\"journal_healthy\":" << (profiler.journalHealthy.load() ? "true" : "false")
+                            << ",\"rolling_tail_available\":" << (profiler.incidentRing ? "true" : "false")
+                            << ",\"journal_events_written\":" << profiler.journalEventsWritten.load()
+                            << ",\"snapshot_bytes\":" << profiler.snapshotBytes
+                            << ",\"attachment_rejected\":" << profiler.attachments.rejected.load()
+                            << ",\"attachment_admission_deferred\":" << profiler.attachments.admissionDeferred.load()
+                            << ",\"attachment_failed\":" << profiler.attachments.failed.load()
+                            << ",\"attachment_group\":" << profiler.attachments.activeGroup.load()
+                            << ",\"geometry_captures_remaining\":" << profiler.attachments.windowRemaining.load()
+                            << ",\"attachment_groups_failed\":" << profiler.attachments.groupsFailed.load()
+                            << ",\"attachment_written_bytes\":" << profiler.attachments.written.load() << "}\n";
+                        status.flush();
+                        const bool good = status.good();
+                        status.close();
+                        if (good && !status.fail()) replaceFileAtomically(statusTemporary, statusPath);
+                    }
+                    catch (const std::exception &) { result = "control_io_failure"; }
+                    std::this_thread::sleep_for(std::chrono::milliseconds(100));
+                }
+
+                std::ofstream terminal(statusTemporary, std::ios::binary);
+                terminal << "{\"schema\":\"n64profiler-control-v1\",\"pid\":" << profiler.processId
+                    << ",\"capture\":\"" << jsonEscape(profiler.outputPath.u8string())
+                    << "\",\"recording\":false,\"last_request\":" << lastRequest
+                    << ",\"result\":\"finalizing\",\"snapshot_generation\":" << generation
+                    << ",\"heartbeat_ns\":" << PerformanceProfiler::nowNanoseconds() << "}\n";
+                terminal.flush();
+                const bool good = terminal.good();
+                terminal.close();
+                if (good && !terminal.fail()) replaceFileAtomically(statusTemporary, statusPath);
+            });
+        }
+
+        bool writeLiveCheckpoint(
+            ProfilerState &profiler,
+            const std::vector<ThreadBuffer *> &buffers
+        ) {
+            std::filesystem::path temporaryPath = profiler.livePath;
+            temporaryPath += ".tmp";
+            ensureParentDirectory(temporaryPath);
+            std::ofstream output(temporaryPath, std::ios::binary);
+            if (!output.is_open()) {
+                return false;
+            }
+
+            uint64_t latestTimestampNanoseconds = 0;
+            for (const ThreadBuffer *buffer : buffers) {
+                latestTimestampNanoseconds = std::max(
+                    latestTimestampNanoseconds,
+                    buffer->latestTimestampNanoseconds.load(
+                        std::memory_order_acquire
+                    )
+                );
+            }
+            const uint64_t generation =
+                profiler.checkpointGeneration.fetch_add(
+                    1,
+                    std::memory_order_relaxed
+                ) + 1;
+            bool submissionCollapseDetected = false;
+            uint64_t submissionCollapseTimestamp = 0u;
+            uint64_t collapsedSubmissionSamples = 0u;
+            uint64_t observedSubmissionSamples = 0u;
+            {
+                const std::scoped_lock lock(
+                    profiler.submissionIntegrityMutex
+                );
+                submissionCollapseDetected =
+                    profiler.submissionIntegrity.collapseDetected;
+                submissionCollapseTimestamp =
+                    profiler.submissionIntegrity.detectedCollapseTimestamp;
+                collapsedSubmissionSamples =
+                    profiler.submissionIntegrity.collapsedSampleCount;
+                observedSubmissionSamples = profiler.submissionIntegrity.completeSamples;
+            }
+            output << "{\n"
+                << "  \"schema\": \"rt64-performance-live-v1\",\n"
+                << "  \"generation\": " << generation << ",\n"
+                << "  \"journal\": \""
+                << jsonEscape(profiler.journalPath.u8string()) << "\",\n"
+                << "  \"journal_healthy\": "
+                << (profiler.journalHealthy.load(std::memory_order_acquire)
+                    ? "true" : "false") << ",\n"
+                << "  \"journal_events_written\": "
+                << profiler.journalEventsWritten.load(
+                    std::memory_order_acquire
+                ) << ",\n"
+                << "  \"journal_flush_count\": "
+                << profiler.journalFlushCount.load(
+                    std::memory_order_acquire
+                ) << ",\n"
+                << "  \"recorded_events\": "
+                << recordedEventCount(buffers) << ",\n"
+                << "  \"retained_events\": "
+                << retainedEventCount(buffers) << ",\n"
+                << "  \"streamed_only_events\": "
+                << streamedOnlyEventCount(buffers) << ",\n"
+                << "  \"dropped_events\": "
+                << droppedEventCount(profiler, buffers) << ",\n"
+                << "  \"submission_integrity\": {\"status\":\""
+                << (submissionCollapseDetected
+                    ? "WORLD_SUBMISSION_COLLAPSE"
+                    : (observedSubmissionSamples == 0
+                        ? "UNOBSERVED_REQUIRED_PRODUCERS"
+                        : "NO_SUSTAINED_GAMEPLAY_COLLAPSE"))
+                << "\",\"detected\":"
+                << (submissionCollapseDetected ? "true" : "false")
+                << ",\"collapsed_sample_count\":"
+                << collapsedSubmissionSamples
+                << ",\"onset_timestamp_ns\":"
+                << submissionCollapseTimestamp << "},\n"
+                << "  \"latest_timestamp_ns\": "
+                << latestTimestampNanoseconds << "\n}\n";
+            output.flush();
+            const bool written = output.good();
+            output.close();
+            return written && replaceFileAtomically(
+                temporaryPath,
+                profiler.livePath
+            );
+        }
+
+        void startCheckpointObservation(ProfilerState &profiler) {
+            const std::scoped_lock startLock(profiler.checkpointMutex);
+            if (profiler.checkpointThread.joinable()) {
+                return;
+            }
+
+            ensureParentDirectory(profiler.journalPath);
+            {
+                const std::scoped_lock metadataLock(profiler.metadataMutex);
+                profiler.metadata["capture_durability"] =
+                    "incremental_jsonl_journal";
+                profiler.metadata["journal_path"] =
+                    profiler.journalPath.u8string();
+                profiler.metadata["journal_interval_ms"] =
+                    std::to_string(profiler.journalIntervalMilliseconds);
+                profiler.metadata["live_checkpoint_interval_ms"] =
+                    std::to_string(profiler.checkpointIntervalMilliseconds);
+            }
+            profiler.checkpointRunning.store(true, std::memory_order_release);
+            profiler.checkpointThread = std::thread([&profiler]() {
+                std::ofstream journalFile(
+                    profiler.journalPath,
+                    std::ios::binary | std::ios::trunc
+                );
+                if (!journalFile.is_open()) {
+                    std::fprintf(
+                        stderr,
+                        "RT64_PROFILE journal_open_failed=1 path=%s\n",
+                        profiler.journalPath.string().c_str()
+                    );
+                    std::fflush(stderr);
+                    profiler.checkpointRunning.store(
+                        false,
+                        std::memory_order_release
+                    );
+                    return;
+                }
+
+                HashingOutput journalHash(journalFile.rdbuf());
+                RecordLimitedOutput limited(&journalHash, profiler.maximumJournalBytes);
+                std::ostream journal(&limited);
+                journal << "{\"record\":\"header\",\"schema\":\"rt64-performance-journal-v1\",\"clock\":\"steady_clock_nanoseconds\"}\n";
+                journal.flush();
+                profiler.journalHealthy.store(
+                    journal.good(),
+                    std::memory_order_release
+                );
+
+                std::unordered_map<ThreadBuffer *, uint64_t> cursors;
+                std::unordered_map<ThreadBuffer *, std::string> threadNames;
+                std::map<std::string, std::string> writtenMetadata;
+                auto nextLiveCheckpoint = Clock::now();
+                while (true) {
+
+                    const bool finalDrain = !profiler.checkpointRunning.load(
+                        std::memory_order_acquire
+                    );
+                    std::vector<ThreadBuffer *> buffers;
+                    {
+                        const std::scoped_lock registryLock(
+                            profiler.registryMutex
+                        );
+                        buffers = profiler.threadBuffers;
+                    }
+
+                    std::map<std::string, std::string> metadata;
+                    {
+                        const std::scoped_lock metadataLock(
+                            profiler.metadataMutex
+                        );
+                        metadata = profiler.metadata;
+                    }
+                    for (const auto &[key, value] : metadata) {
+                        const auto previous = writtenMetadata.find(key);
+                        if ((previous == writtenMetadata.end()) ||
+                            (previous->second != value)) {
+                            journal << "{\"record\":\"metadata\",\"key\":\""
+                                << jsonEscape(key) << "\",\"value\":\""
+                                << jsonEscape(value) << "\"}\n";
+                            writtenMetadata[key] = value;
+                        }
+                    }
+
+                    uint64_t eventsWritten = 0;
+                    std::vector<Event> integrityEvents;
+                    const auto collectIntegrity = [&](const Event &event) {
+                        const std::string_view name(event.name.data());
+                        if (name == "Host.Context.World" || name == "Work.DrawCalls" ||
+                            name == "Work.Triangles" || name == "Work.SpecializedPipelines.World")
+                            integrityEvents.push_back(event);
+                    };
+                    for (ThreadBuffer *buffer : buffers) {
+                        std::string name;
+                        {
+                            const std::scoped_lock nameLock(
+                                buffer->nameMutex
+                            );
+                            name = buffer->name;
+                        }
+                        const auto previousName = threadNames.find(buffer);
+                        if ((previousName == threadNames.end()) ||
+                            (previousName->second != name)) {
+
+                            threadNames[buffer] = name;
+                        }
+
+                        const uint64_t streamEnd = buffer->streamWrite.load(std::memory_order_acquire);
+                        uint64_t &cursor = cursors[buffer];
+                        const uint64_t count = buffer->eventCount.load(
+                            std::memory_order_acquire
+                        );
+                        while (cursor < count) {
+                            writeJournalEvent(
+                                journal,
+                                eventAt(*buffer, cursor)
+                            );
+                            collectIntegrity(eventAt(*buffer, cursor));
+                            ++cursor;
+                            ++eventsWritten;
+                        }
+
+                        uint64_t read = buffer->streamRead.load(std::memory_order_relaxed);
+                        while (read < streamEnd) {
+                            const Event &event = buffer->streamEvents[read % buffer->streamCapacity];
+                            writeJournalEvent(journal, event);
+                            collectIntegrity(event);
+                            buffer->streamRead.store(++read, std::memory_order_release);
+                            ++eventsWritten;
+                        }
+                    }
+                    std::stable_sort(integrityEvents.begin(), integrityEvents.end(), [](const Event &a, const Event &b) {
+                        return a.timestampNanoseconds < b.timestampNanoseconds;
+                    });
+                    for (const auto &event : integrityEvents) updateSubmissionIntegrity(profiler, event);
+                    journal.flush();
+                    const bool healthy = journal.good();
+                    profiler.journalHealthy.store(
+                        healthy,
+                        std::memory_order_release
+                    );
+
+                    if (healthy) profiler.journalEventsWritten.fetch_add(
+                        eventsWritten, std::memory_order_release);
+                    profiler.journalFlushCount.fetch_add(
+                        1,
+                        std::memory_order_release
+                    );
+
+                    const auto now = Clock::now();
+                    if (now >= nextLiveCheckpoint) {
+                        writeLiveCheckpoint(profiler, buffers);
+                        nextLiveCheckpoint = now + std::chrono::milliseconds(
+                            profiler.checkpointIntervalMilliseconds
+                        );
+                    }
+
+                    if (!healthy || finalDrain) {
+                        break;
+                    }
+                    if (profiler.checkpointRunning.load(std::memory_order_acquire)) {
+                        std::this_thread::sleep_for(std::chrono::milliseconds(
+                            profiler.journalIntervalMilliseconds
+                        ));
+                    }
+                }
+                journalFile.close();
+                if (journalFile.fail()) profiler.journalHealthy.store(false, std::memory_order_release);
+                profiler.journalDigest = journalHash.digest(profiler.journalHealthy.load(std::memory_order_acquire));
+                profiler.checkpointRunning.store(
+                    false,
+                    std::memory_order_release
+                );
+            });
+        }
+
+        template<size_t Count> void writeNames(std::ostream &output, const std::array<const char *, Count> &names) {
+            output << '[';
+            for (size_t i = 0; i < Count; ++i) {
+                if (i) output << ',';
+                output << '\"' << jsonEscape(names[i]) << '\"';
+            }
+            output << ']';
+        }
+
+        void writeSharedContext(std::ostream &output, const ProfilerState &profiler) {
+            output << "  \"rt64_event_vocabulary_revision\":" << PerformanceProfilerContract::SchemaVersion << ",\n";
+            output << "  \"gpu_sample_interval\":" << (profiler.gpuInstrumentation ? profiler.gpuFrameSampleInterval : 0)
+                << ",\n  \"render_workers\":[";
+            const uint32_t count = std::min<uint32_t>(profiler.nextRenderWorker.load(), uint32_t(profiler.renderWorkers.size()));
+            for (uint32_t i = 0; i < count; ++i) {
+                const auto &worker = profiler.renderWorkers[i];
+                if (i) output << ',';
+                output << "{\"worker_id\":" << worker.workerId << ",\"name\":\"" << jsonEscape(worker.name.data())
+                    << "\",\"logical_queue_id\":" << worker.logicalQueueId << ",\"native_queue_id\":" << worker.nativeQueueId
+                    << ",\"command_list_type\":" << worker.commandListType << '}';
+            }
+            output << "],\n  \"render_worker_metadata_dropped\":" << profiler.droppedRenderWorkers.load()
+                << ",\n  \"observer_invariants\":{\"secondary_graphics_devices\":" << profiler.secondaryGraphicsDevices.load()
+                << ",\"gpu_query_commands\":" << profiler.gpuQueryCommands.load()
+                << ",\"backend_fence_status_queries\":" << profiler.backendFenceStatusQueries.load()
+                << ",\"frame_path_allocations\":" << profiler.framePathAllocations.load()
+                << ",\"host_sampler\":" << (profiler.hostObservationStarted.load() ? "true" : "false")
+                << ",\"external_display_sampler\":" << (profiler.displayObservationStarted.load() ? "true" : "false")
+                << ",\"control_thread_enabled\":" << (!profiler.controlPath.empty() ? "true" : "false") << "},\n";
+            output << "  \"storage\":{\"maximum_named_threads\":" << profiler.maximumThreads
+                << ",\"registered_threads\":" << profiler.nextPassiveThread.load()
+                << ",\"maximum_render_workers\":1024,\"registered_render_workers\":" << count
+                << ",\"event_capacity\":" << profiler.maximumEvents
+                << ",\"allocated_buffers\":" << (profiler.passiveRing ? 1 : profiler.threadBuffers.size())
+                << ",\"reserved_bytes\":" << (profiler.passiveRing ? profiler.passiveRing->bytes() : 0)
+                << ",\"event_bytes\":" << (profiler.passiveRing ? profiler.passiveRing->bytes() / profiler.maximumEvents : sizeof(Event))
+                << ",\"reserved_bytes_scope\":\"PASSIVE_RING_ONLY_NOT_TOTAL_PROCESS_MEMORY\"},\n";
+            output << "  \"sampled_frame_counters\":";
+            output << '[';
+            bool firstCounter = true;
+            const auto counterName = [&](const char *name) {
+                if (!firstCounter) output << ',';
+                firstCounter = false;
+                output << '\"' << jsonEscape(name) << '\"';
+            };
+            for (const char *name : PerformanceEventNames::SampledRendererFrameCounters) counterName(name);
+            for (const auto &pair : PerformanceEventNames::SampledRendererPairExtentCounters)
+                for (const char *name : pair) counterName(name);
+            output << ']';
+            output << ",\n  \"sampled_gpu_stage_counters\":";
+            writeNames(output, PerformanceEventNames::SampledRendererGPUStageCounters);
+            output << ",\n  \"interpolation_batch_counters\":";
+            writeNames(output, PerformanceEventNames::WorkloadInterpolationBatchCounters);
+            output << ",\n";
+        }
+
+        uint64_t omittedTraceEvents(const ProfilerState &profiler, const std::vector<ThreadBuffer *> &buffers) {
+            if (profiler.passiveRing || profiler.keepDrawEvents) return 0;
+            uint64_t omitted = 0;
+            for (const auto *buffer : buffers) {
+                const uint64_t count = buffer->eventCount.load(std::memory_order_acquire);
+                for (uint64_t i = 0; i < count; ++i) {
+                    const std::string_view name(eventAt(*buffer, i).name.data());
+                    if (name.substr(0, 9) == "GPU.Draw.") ++omitted;
+                }
+            }
+            return omitted;
+        }
+
+        bool writeTrace(
+            const ProfilerState &profiler,
+            const std::vector<ThreadBuffer *> &buffers,
+            const std::filesystem::path &outputPath,
+            ContentDigest &digest
+        ) {
+            ensureParentDirectory(outputPath);
+            std::ofstream outputFile(outputPath, std::ios::binary);
+            if (!outputFile.is_open()) {
+                return false;
+            }
+            HashingOutput hash(outputFile.rdbuf());
+            std::ostream output(&hash);
+
+            output << "{\n  \"schema\": \"n64profiler-trace-v1\",\n";
+            output << "  \"clock\": \"steady_clock_nanoseconds\",\n";
+            output << "  \"capture_mode\":\"" << (profiler.passiveRing ?
+                (profiler.gpuInstrumentation ? "sparse_gpu" : "passive") : "detailed") << "\",\n";
+            output << "  \"gpu_clock_alignment\": \"fence_completion_estimate\",\n";
+            writeSharedContext(output, profiler);
+            output << "  \"traceEvents\": [\n";
+            bool first = true;
+            auto separator = [&]() {
+                if (!first) {
+                    output << ",\n";
+                }
+                first = false;
+            };
+            {
+                const uint32_t count = std::min<uint32_t>(profiler.nextPassiveThread.load(), uint32_t(profiler.maximumThreads));
+                for (uint32_t i = 0; i < count; ++i) {
+                    separator();
+                    output << "{\"name\":\"thread_name\",\"ph\":\"M\",\"pid\":1,\"tid\":" << i + 1
+                        << ",\"args\":{\"name\":\"" << jsonEscape(profiler.passiveThreadNames[i].data()) << "\"}}";
+                }
+            }
+
+            for (const ThreadBuffer *buffer : buffers) {
+                std::string threadName;
+                {
+                    const std::scoped_lock nameLock(buffer->nameMutex);
+                    threadName = buffer->name;
+                }
+
+            }
+            separator();
+            output << "    {\"name\":\"thread_name\",\"ph\":\"M\",\"pid\":1,\"tid\":4294967294,\"args\":{\"name\":\"RT64 GPU samples\"}}";
+
+            std::string line;
+            line.reserve(1024);
+            const auto integer = [&](std::string_view prefix, uint64_t value) {
+                line.append(prefix);
+                appendTraceInteger(line, value);
+            };
+            for (const ThreadBuffer *buffer : buffers) {
+                const uint64_t eventCount = buffer->eventCount.load(
+                    std::memory_order_acquire
+                );
+                for (uint64_t eventIndex = 0;
+                    eventIndex < eventCount;
+                    ++eventIndex) {
+                    const Event &event = eventAt(*buffer, eventIndex);
+                    constexpr std::string_view DrawPrefix = "GPU.Draw.";
+                    const std::string_view eventName(event.name.data());
+                    if (!profiler.passiveRing && !profiler.keepDrawEvents &&
+                        (eventName.size() >= DrawPrefix.size()) &&
+                        (eventName.substr(0, DrawPrefix.size()) == DrawPrefix)) {
+                        continue;
+                    }
+                    separator();
+                    const uint32_t traceThread = event.gpuClock
+                        ? 4'294'967'294u
+                        : event.threadId;
+                    line = "    {\"name\":\"";
+                    line += jsonEscape(event.name.data());
+                    line += "\",\"cat\":\"";
+                    line += categoryName(event.category);
+                    integer("\",\"pid\":1,\"tid\":", traceThread);
+                    line += ",\"ts\":";
+                    appendTraceMicroseconds(line, event.timestampNanoseconds);
+                    switch (event.kind) {
+                    case EventKind::Duration:
+                        line += ",\"ph\":\"X\",\"dur\":";
+                        appendTraceMicroseconds(line, event.durationNanoseconds);
+                        break;
+                    case EventKind::Instant:
+                        line += ",\"ph\":\"i\",\"s\":\"t\"";
+                        break;
+                    case EventKind::Counter:
+                        line += ",\"ph\":\"C\"";
+                        break;
+                    }
+                    integer(",\"args\":{\"correlation_id\":", event.correlationId);
+                    integer(",\"argument0\":", event.argument0);
+                    integer(",\"argument1\":", event.argument1);
+                    integer(",\"os_thread_id\":", event.osThreadId);
+                    integer(",\"producer_thread_id\":", event.threadId);
+                    integer(",\"producer_sequence\":", event.producerSequence);
+                    integer(",\"timestamp_ns\":", event.timestampNanoseconds);
+                    integer(",\"duration_ns\":", event.durationNanoseconds);
+                    line += event.threadScope ? ",\"thread_scope\":true" : ",\"thread_scope\":false";
+                    if (event.kind == EventKind::Counter) {
+                        line += ",\"value\":";
+                        appendTraceCounter(line, event.value);
+                    }
+                    if (event.threadCpuMeasured) {
+                        integer(",\"thread_cpu_duration_ns\":", event.threadCpuDurationNanoseconds);
+                    }
+                    if (event.gpuClock) {
+                        integer(",\"raw_gpu_start_ns\":", event.gpuStartNanoseconds);
+                        integer(",\"raw_gpu_end_ns\":", event.gpuEndNanoseconds);
+                        line += ",\"alignment\":\"fence_completion_estimate\"";
+                    }
+                    line += "}}";
+                    output.write(line.data(), std::streamsize(line.size()));
+                }
+            }
+
+            output << "\n  ],\n  \"metadata\": {";
+            bool firstMetadata = true;
+            for (const auto &[key, value] : profiler.metadata) {
+                if (!firstMetadata) {
+                    output << ',';
+                }
+                firstMetadata = false;
+                output << "\n    \"" << jsonEscape(key) << "\": \""
+                    << jsonEscape(value) << "\"";
+            }
+            if (!firstMetadata) {
+                output << ',';
+            }
+            output << "\n    \"budget_ms\": " << profiler.budgetMilliseconds
+                << ",\n    \"recorded_events\": "
+                << recordedEventCount(buffers)
+                << ",\n    \"retained_events\": "
+                << retainedEventCount(buffers)
+                << ",\n    \"streamed_only_events\": "
+                << streamedOnlyEventCount(buffers)
+                << ",\n    \"dropped_events\": "
+                << droppedEventCount(profiler, buffers)
+                << "\n  }\n}\n";
+            output.flush();
+            const bool written = output.good();
+            outputFile.close();
+            digest = hash.digest(written && !outputFile.fail());
+            return digest.valid;
+        }
+
+        bool isFrameContainer(std::string_view name) {
+            return (name == "Application.Setup") ||
+                (name == "Application.ProcessDisplayLists") ||
+                (name == "State.FullSync") ||
+                (name == "State.FullSyncWorkloadAdvance") ||
+                (name == "Present.Batch") ||
+                (name == "Present.OutputFrame") ||
+                (name == "Renderer.Frame") ||
+                (name == "State.UpdateScreenAndSubmit") ||
+                (name == "Workload.InterpolationBatch") ||
+                (name == "Workload.Process") ||
+                (name == "GPU.Frame") ||
+                (name == "GPU.Framebuffers");
+        }
+
+        bool isConcurrentBackgroundStage(const Event &event) {
+            const std::string_view name(event.name.data());
+            return (event.category == PerformanceCategory::Compile) ||
+                (event.category == PerformanceCategory::IO) ||
+                (name == "Present.PresentationSlotGPUCompletion") ||
+                ((event.category == PerformanceCategory::Upload) &&
+                    (name != "Renderer.UploadWait"));
+        }
+
+        bool isFrameProductionCadenceObservation(const Event &event) {
+            const std::string_view name(event.name.data());
+            return (name == "FrameProduction.RuntimeVIInterval") ||
+                (name == "FrameProduction.RuntimeVIWakeDeadlineMiss") ||
+                (name == "FrameProduction.GuestGraphicsTaskInterval") ||
+                (name == "FrameProduction.GuestGraphicsWaitAfterCompletion") ||
+                (name == "FrameProduction.PresentQueueStarvation") ||
+                (name == "FrameProduction.WorkloadQueueStarvation");
+        }
+
+        bool isDisplayCadenceObservation(const Event &event) {
+            const std::string_view name(event.name.data());
+            return (name == "Present.ActualScanoutInterval") ||
+                (name == "Present.DesktopOutputChangeInterval") ||
+                (name == "Present.DisplayVBlankInterval") ||
+                (name == "Present.EstimatedDisplayedFrameInterval") ||
+                (name == "Present.PresentWaitCompletionInterval") ||
+                (name ==
+                    "Present.SwapChainImageReleaseObservationInterval");
+        }
+
+        bool isBufferedProducerBackpressure(const Event &event) {
+            const std::string_view name(event.name.data());
+            return (name == "FrameProduction.WorkloadProducerBackpressure") ||
+                (name == "FrameProduction.PresentProducerBackpressure");
+        }
+
+        bool bufferedBackpressureMatchesDisplayedFrame(
+            const Event &event,
+            const Event &displayed
+        ) {
+            if ((event.correlationId == 0) ||
+                !isBufferedProducerBackpressure(event)) {
+                return false;
+            }
+
+            const std::string_view name(event.name.data());
+            if (name == "FrameProduction.WorkloadProducerBackpressure") {
+                return event.correlationId == displayed.argument0;
+            }
+
+            return event.correlationId == displayed.correlationId;
+        }
+
+        bool isCriticalPathStage(const Event &event) {
+            if ((event.kind != EventKind::Duration) ||
+                (event.durationNanoseconds == 0)) {
+                return false;
+            }
+
+            const std::string_view name(event.name.data());
+
+            if ((name == "FrameProduction.GuestGraphicsSchedulerDelay") ||
+                (name == "FrameProduction.GraphicsTaskDispatchDelay")) {
+                return false;
+            }
+            if (isFrameContainer(name) || isConcurrentBackgroundStage(event) ||
+                isFrameProductionCadenceObservation(event) ||
+                isDisplayCadenceObservation(event)) {
+                return false;
+            }
+
+            constexpr std::string_view renderWorkerPrefix = "RenderWorker.";
+            if ((name.size() >= renderWorkerPrefix.size()) &&
+                (name.substr(0, renderWorkerPrefix.size()) == renderWorkerPrefix)) {
+                return false;
+            }
+
+            return (event.category == PerformanceCategory::CPU) ||
+                (event.category == PerformanceCategory::GPU) ||
+                (event.category == PerformanceCategory::Wait) ||
+                (event.category == PerformanceCategory::Pacing) ||
+                (event.category == PerformanceCategory::Upload);
+        }
+
+        double overlapMilliseconds(
+            const Event &event,
+            uint64_t intervalStart,
+            uint64_t intervalEnd
+        ) {
+            const uint64_t eventEnd = event.timestampNanoseconds +
+                event.durationNanoseconds;
+            if ((event.timestampNanoseconds >= intervalEnd) ||
+                (eventEnd <= intervalStart)) {
+                return 0.0;
+            }
+
+            const uint64_t overlapStart = std::max(
+                event.timestampNanoseconds,
+                intervalStart
+            );
+            const uint64_t overlapEnd = std::min(eventEnd, intervalEnd);
+            return double(overlapEnd - overlapStart) / 1'000'000.0;
+        }
+
+        std::string diagnosisForCategory(PerformanceCategory category) {
+            switch (category) {
+            case PerformanceCategory::GPU: return "GPU_BOUND";
+            case PerformanceCategory::CPU: return "CPU_BOUND";
+            case PerformanceCategory::Wait:
+                return "SYNCHRONIZATION_OR_QUEUE_WAIT";
+            case PerformanceCategory::Pacing:
+                return "DISPLAY_PACING_OR_BACKPRESSURE";
+            case PerformanceCategory::Upload:
+                return "RESOURCE_UPLOAD_BLOCKING_RENDERER";
+            default: return "EXTERNAL_OR_UNINSTRUMENTED_STALL";
+            }
+        }
+
+        bool isFrameProductionStage(const Event &event) {
+            constexpr std::string_view frameProductionPrefix =
+                "FrameProduction.";
+            const std::string_view name(event.name.data());
+            return (name.size() >= frameProductionPrefix.size()) &&
+                (name.substr(0, frameProductionPrefix.size()) ==
+                    frameProductionPrefix);
+        }
+
+        bool isInterpolationBurstStage(const Event &event) {
+            const uint32_t sourceRate =
+                uint32_t(event.argument1 >> 32u);
+            const uint32_t targetRate =
+                uint32_t(event.argument1 & 0xFFFFFFFFULL);
+            const uint32_t expectedMaximumDisplayFrames =
+                (sourceRate > 0) && (targetRate > 0)
+                    ? uint32_t((uint64_t(targetRate) + sourceRate - 1u) /
+                        sourceRate)
+                    : 0u;
+            return (event.kind == EventKind::Duration) &&
+                (std::string_view(event.name.data()) ==
+                    "Workload.InterpolationBatch") &&
+                (expectedMaximumDisplayFrames > 0) &&
+                (event.argument0 > expectedMaximumDisplayFrames);
+        }
+
+        uint32_t interpolationSourceRate(const Event &event) {
+            return uint32_t(event.argument1 >> 32u);
+        }
+
+        uint32_t interpolationTargetRate(const Event &event) {
+            return uint32_t(event.argument1 & 0xFFFFFFFFULL);
+        }
+
+        double interpolationDeadlineMilliseconds(const Event &event) {
+            const uint32_t sourceRate = interpolationSourceRate(event);
+            return sourceRate > 0
+                ? (1'000.0 / double(sourceRate))
+                : 0.0;
+        }
+
+        bool isInterpolationDeadlineMiss(const Event &event) {
+            const double deadline = interpolationDeadlineMilliseconds(event);
+            return (deadline > 0.0) &&
+                ((double(event.durationNanoseconds) / 1'000'000.0) > deadline);
+        }
+
+        std::string diagnosisForEvent(const Event &event) {
+            const std::string_view name(event.name.data());
+            if (name == "FrameProduction.RuntimeVIWakeDeadlineMiss") {
+                return "RUNTIME_VI_TIMER_DEADLINE_MISS";
+            }
+            if (name == "FrameProduction.RuntimeVIInterval") {
+                return "RUNTIME_VI_SCHEDULER_STALL";
+            }
+            if (isInterpolationBurstStage(event)) {
+                return "INTERPOLATION_BURST_BACKPRESSURE";
+            }
+            if (isFrameProductionStage(event)) {
+                return (name.find("Backpressure") != std::string_view::npos)
+                    ? "FRAME_PRODUCTION_BACKPRESSURE"
+                    : "FRAME_PRODUCTION_STARVATION";
+            }
+
+            return diagnosisForCategory(event.category);
+        }
+
+        bool writeSummary(
+            const ProfilerState &profiler,
+            const std::vector<ThreadBuffer *> &buffers,
+            const std::filesystem::path &summaryPath,
+            ContentDigest &digest
+        ) {
+            std::map<std::pair<PerformanceCategory, std::string>, Statistics> map;
+            std::map<std::string, ThreadExecutionStatistics>
+                threadExecutionMap;
+            std::map<std::string, std::vector<double>> counterValues;
+            std::unordered_map<uint64_t, SubmissionIntegritySample>
+                submissionIntegritySampleMap;
+            std::vector<const Event *> durationEvents;
+            std::vector<const Event *> displayedEvents;
+            std::vector<const Event *> actualScanoutEvents;
+            std::vector<const Event *> desktopOutputEvents;
+            std::vector<const Event *> displayVBlankEvents;
+            std::vector<const Event *> estimatedDisplayedFrameEvents;
+            std::vector<const Event *> presentWaitCompletionEvents;
+            std::vector<const Event *> imageReacquireCompletionEvents;
+            std::vector<const Event *> interpolationBatchEvents;
+            std::vector<const Event *> interpolationDecisionEvents;
+            std::vector<const Event *> interpolationReuseBlockedEvents;
+            std::vector<const Event *> presentInterpolationBlockedEvents;
+            std::vector<const Event *> pendingDepthEvents;
+            std::vector<const Event *> runtimeVIIntervalEvents;
+            std::vector<const Event *> runtimeVIWakeDeadlineMissEvents;
+            std::vector<const Event *> manualPacingResultEvents;
+            std::vector<const Event *> contextEvents;
+            std::vector<double> runtimeVIIntervals;
+            std::vector<double> runtimeVIWakeDeadlineMisses;
+            uint64_t runtimeVISkippedRetraces = 0;
+            std::map<uint64_t, HostResourceObservation>
+                hostResourceObservationMap;
+            uint64_t displayQueueUnderruns = 0;
+            uint64_t presentationEnqueuedCount = 0;
+            uint64_t presentationDequeuedCount = 0;
+            uint64_t presentationDequeuedSkippedCount = 0;
+            uint64_t presentationDequeuedCoalescedCount = 0;
+            uint64_t interpolationSetPublishedCount = 0;
+            uint64_t interpolationResolvedCount = 0;
+            uint64_t interpolationResolvedMatchedCount = 0;
+            uint64_t interpolationResolvedGeneratedCount = 0;
+            uint64_t interpolationResolvedConsumedCount = 0;
+            uint64_t interpolationFramebufferMismatchCount = 0;
+            uint64_t interpolationFramebufferMismatchPresentedCount = 0;
+            uint64_t interpolationFramebufferMismatchRejectedCount = 0;
+            uint64_t presentationFramebufferInventoryCount = 0;
+            uint64_t presentationFramebufferOwnerMatchedCount = 0;
+            uint64_t presentationFramebufferOwnerMissingCount = 0;
+            uint64_t diagnosticCaptureQueuedCount = 0;
+            uint64_t diagnosticCaptureCompletedCount = 0;
+            uint64_t diagnosticCaptureContentCount = 0;
+            uint64_t diagnosticCaptureBlankOutputCount = 0;
+            uint64_t earlyPresentDecisionCount = 0;
+            uint64_t earlyPresentEnabledCount = 0;
+            uint64_t earlyPresentCandidateCount = 0;
+            uint64_t earlyPresentSubmittedCount = 0;
+            uint64_t earlyPresentSubmissionMissCount = 0;
+            uint64_t coalescedDuplicateWorkloadCount = 0;
+            std::vector<double> manualPacingOvershootMilliseconds;
+            uint64_t fifoRateCalibrationObservationCount = 0;
+            uint64_t fifoRateCalibrationCompletionId = 0;
+            uint32_t fifoRateAdvertisedHz = 0;
+            double fifoRateObservedHz = 0.0;
+            uint32_t fifoRateEffectiveHz = 0;
+            bool fifoRateCalibrationApplied = false;
+            std::unordered_map<uint64_t, double>
+                presentationHandoffMilliseconds;
+            std::vector<double> presentationSubmissionIntervals;
+            std::vector<double> scanoutIntervals;
+            std::vector<double> presentWaitCompletionIntervals;
+            std::vector<double> imageReacquireCompletionIntervals;
+            uint64_t interpolationCoverageSamples = 0;
+            uint64_t interpolationViewProjectionTotal = 0;
+            uint64_t interpolationViewProjectionMapped = 0;
+            uint64_t interpolationTransformTotal = 0;
+            uint64_t interpolationTransformMapped = 0;
+            uint64_t interpolationDynamicVertexSamples = 0;
+            uint64_t interpolationDynamicVertexChangedTransforms = 0;
+            uint64_t interpolationDynamicVertexInterpolatedTransforms = 0;
+            uint64_t interpolationDynamicVertexSkippedTransforms = 0;
+            uint64_t interpolationDynamicVertexCountMismatchTransforms = 0;
+            uint64_t interpolationDynamicVertexChangedVertices = 0;
+            uint64_t interpolationDynamicVertexInterpolatedVertices = 0;
+            uint64_t interpolationDynamicVertexSkippedVertices = 0;
+            std::unordered_map<uint64_t, GPUWorkloadAccumulator>
+                gpuWorkloads;
+            std::map<std::pair<std::string, uint32_t>, DrawHotspotStatistics>
+                drawHotspotMap;
+            for (const ThreadBuffer *buffer : buffers) {
+                const uint64_t eventCount = buffer->eventCount.load(
+                    std::memory_order_acquire
+                );
+                for (uint64_t eventIndex = 0;
+                    eventIndex < eventCount;
+                    ++eventIndex) {
+                    const Event &event = eventAt(*buffer, eventIndex);
+                    if ((event.kind == EventKind::Duration) &&
+                        (event.durationNanoseconds > 0)) {
+                        durationEvents.emplace_back(&event);
+                        const auto key = std::make_pair(
+                            event.category,
+                            std::string(event.name.data())
+                        );
+                        Statistics &entry = map[key];
+                        entry.name = key.second;
+                        entry.category = key.first;
+                        const double milliseconds =
+                            double(event.durationNanoseconds) / 1'000'000.0;
+                        entry.milliseconds.emplace_back(milliseconds);
+                        entry.totalMilliseconds += milliseconds;
+                        const std::string_view eventName(event.name.data());
+                        if (event.threadCpuMeasured) {
+                            ThreadExecutionStatistics &execution =
+                                threadExecutionMap[std::string(eventName)];
+                            execution.name = eventName;
+                            const double cpuMilliseconds = double(
+                                event.threadCpuDurationNanoseconds
+                            ) / 1'000'000.0;
+                            execution.wallMilliseconds.emplace_back(
+                                milliseconds
+                            );
+                            execution.cpuMilliseconds.emplace_back(
+                                cpuMilliseconds
+                            );
+                            execution.offCpuMilliseconds.emplace_back(
+                                std::max(0.0, milliseconds - cpuMilliseconds)
+                            );
+                        }
+                        if (eventName == "Present.ActualScanoutInterval") {
+                            actualScanoutEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "Present.DesktopOutputChangeInterval") {
+                            desktopOutputEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "Present.DisplayVBlankInterval") {
+                            displayVBlankEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "Present.EstimatedDisplayedFrameInterval") {
+                            estimatedDisplayedFrameEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "Present.PresentWaitCompletionInterval") {
+                            presentWaitCompletionEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "Present.SwapChainImageReleaseObservationInterval") {
+                            imageReacquireCompletionEvents.emplace_back(
+                                &event
+                            );
+                        }
+                        else if (eventName ==
+                            "Workload.InterpolationBatch") {
+                            interpolationBatchEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "FrameProduction.RuntimeVIInterval") {
+                            runtimeVIIntervalEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "FrameProduction.RuntimeVIWakeDeadlineMiss") {
+                            runtimeVIWakeDeadlineMissEvents.emplace_back(
+                                &event
+                            );
+                        }
+                        else if ((eventName ==
+                            "Workload.PresentationQueueHandoff") ||
+                            (eventName ==
+                                "Workload.InterpolationReuseWait") ||
+                            (eventName ==
+                                "Workload.PresentationTargetClaimWait") ||
+                            (eventName ==
+                                "Workload.PresentationEventQueueWait") ||
+                            (eventName ==
+                                "Workload.PresentationSetCommitWait") ||
+                            (eventName ==
+                                "Workload.FirstPresentationQueueWait") ||
+                            (eventName ==
+                                "Renderer.PresentationQueueWait")) {
+                            presentationHandoffMilliseconds[
+                                event.correlationId
+                            ] += milliseconds;
+                        }
+                        if ((eventName == "GPU.Frame") &&
+                            (event.argument0 != 0u)) {
+                            GPUWorkloadAccumulator &gpuWorkload =
+                                gpuWorkloads[event.argument0];
+                            gpuWorkload.frameMilliseconds += milliseconds;
+                            gpuWorkload.sampledFrames++;
+                        }
+                        constexpr std::string_view DrawPrefix = "GPU.Draw.";
+                        if ((eventName.size() >= DrawPrefix.size()) &&
+                            (eventName.substr(0, DrawPrefix.size()) ==
+                                DrawPrefix)) {
+                            const uint32_t shaderHash =
+                                uint32_t(event.argument1 & 0xFFFFFFFFu);
+                            const uint32_t faceCount =
+                                uint32_t(event.argument1 >> 32u);
+                            const auto drawKey = std::make_pair(
+                                std::string(eventName),
+                                shaderHash
+                            );
+                            DrawHotspotStatistics &hotspot =
+                                drawHotspotMap[drawKey];
+                            hotspot.name = drawKey.first;
+                            hotspot.shaderHash = shaderHash;
+                            hotspot.samples++;
+                            hotspot.faces += faceCount;
+                            hotspot.totalMilliseconds += milliseconds;
+                            hotspot.milliseconds.emplace_back(milliseconds);
+                        }
+                    }
+                    else if (event.kind == EventKind::Instant) {
+                        const std::string_view eventName(event.name.data());
+                        if ((eventName.size() >= 13u) &&
+                            (eventName.substr(0, 13u) == "Host.Context.")) {
+                            contextEvents.emplace_back(&event);
+                        }
+                        if ((event.category == PerformanceCategory::Frame) &&
+                            (eventName == "Present.Submitted")) {
+                            displayedEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "Workload.InterpolationDecision") {
+                            interpolationDecisionEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "Workload.InterpolationCoverage") {
+                            interpolationCoverageSamples++;
+                            interpolationViewProjectionTotal +=
+                                uint32_t(event.argument0 >> 32u);
+                            interpolationViewProjectionMapped +=
+                                uint32_t(event.argument0);
+                            interpolationTransformTotal +=
+                                uint32_t(event.argument1 >> 32u);
+                            interpolationTransformMapped +=
+                                uint32_t(event.argument1);
+                        }
+                        else if (eventName ==
+                            "Workload.InterpolationDynamicVertices") {
+                            interpolationDynamicVertexSamples++;
+                            interpolationDynamicVertexChangedTransforms +=
+                                uint32_t(event.argument0 >> 32u);
+                            interpolationDynamicVertexInterpolatedTransforms +=
+                                uint32_t(event.argument0);
+                            interpolationDynamicVertexSkippedTransforms +=
+                                uint32_t(event.argument1 >> 32u);
+                            interpolationDynamicVertexCountMismatchTransforms +=
+                                uint32_t(event.argument1);
+                        }
+                        else if (eventName ==
+                            "Workload.InterpolationDynamicVertexCounts") {
+                            interpolationDynamicVertexChangedVertices +=
+                                uint32_t(event.argument0 >> 32u);
+                            interpolationDynamicVertexInterpolatedVertices +=
+                                uint32_t(event.argument0);
+                            interpolationDynamicVertexSkippedVertices +=
+                                uint32_t(event.argument1);
+                        }
+                        else if (eventName ==
+                            "Workload.InterpolationReuseBlocked") {
+                            interpolationReuseBlockedEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "Present.InterpolationBlocked") {
+                            presentInterpolationBlockedEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "Present.PendingDepthChanged") {
+                            pendingDepthEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "Present.DisplayQueueUnderrun") {
+                            displayQueueUnderruns += event.argument0;
+                        }
+                        else if (eventName == "Present.Enqueued") {
+                            presentationEnqueuedCount++;
+                        }
+                        else if (eventName == "Present.Dequeued") {
+                            presentationDequeuedCount++;
+                            presentationDequeuedSkippedCount +=
+                                (event.argument1 & 1u) != 0u ? 1u : 0u;
+                            presentationDequeuedCoalescedCount +=
+                                (event.argument1 & (1u << 1u)) != 0u
+                                    ? 1u
+                                    : 0u;
+                        }
+                        else if (eventName ==
+                            "Workload.InterpolationSetPublished") {
+                            interpolationSetPublishedCount++;
+                        }
+                        else if (eventName ==
+                            "Present.InterpolationResolved") {
+                            const uint64_t flags = event.argument0 & 0xFFu;
+                            interpolationResolvedCount++;
+                            interpolationResolvedMatchedCount +=
+                                (flags & 1u) != 0u ? 1u : 0u;
+                            interpolationResolvedGeneratedCount +=
+                                (flags & (1u << 1u)) != 0u ? 1u : 0u;
+                            interpolationResolvedConsumedCount +=
+                                (flags & (1u << 2u)) != 0u ? 1u : 0u;
+                            const bool consumed =
+                                (flags & (1u << 2u)) != 0u;
+                            const bool framebufferMismatch =
+                                (flags & (1u << 3u)) != 0u;
+                            interpolationFramebufferMismatchCount +=
+                                framebufferMismatch ? 1u : 0u;
+                            interpolationFramebufferMismatchPresentedCount +=
+                                framebufferMismatch && consumed ? 1u : 0u;
+                            interpolationFramebufferMismatchRejectedCount +=
+                                framebufferMismatch && !consumed ? 1u : 0u;
+                            const bool workloadFramebufferInventory =
+                                (flags & (1u << 4u)) != 0u;
+                            const bool workloadFramebufferOwnerMatched =
+                                (flags & (1u << 5u)) != 0u;
+                            presentationFramebufferInventoryCount +=
+                                workloadFramebufferInventory ? 1u : 0u;
+                            presentationFramebufferOwnerMatchedCount +=
+                                workloadFramebufferOwnerMatched ? 1u : 0u;
+                            presentationFramebufferOwnerMissingCount +=
+                                workloadFramebufferInventory &&
+                                    !workloadFramebufferOwnerMatched
+                                ? 1u
+                                : 0u;
+                        }
+                        else if (eventName ==
+                            "Present.DiagnosticCaptureQueued") {
+                            diagnosticCaptureQueuedCount++;
+                        }
+                        else if (eventName ==
+                            "Present.DiagnosticCaptureCompleted") {
+                            diagnosticCaptureCompletedCount++;
+                        }
+                        else if (eventName ==
+                            "Host.DiagnosticCaptureContent") {
+                            const uint64_t nonblackPixels =
+                                event.argument0 >> 32u;
+                            const uint64_t totalPixels =
+                                event.argument0 & UINT32_MAX;
+                            diagnosticCaptureContentCount++;
+                            diagnosticCaptureBlankOutputCount +=
+                                totalPixels > 0u &&
+                                    nonblackPixels * 100u < totalPixels
+                                ? 1u
+                                : 0u;
+                        }
+                        else if (eventName ==
+                            "State.FullSyncEarlyPresentDecision") {
+                            const uint64_t flags = event.argument0 & 0xFFu;
+                            const bool enabled = (flags & 1u) != 0u;
+                            const bool candidate =
+                                (flags & (1u << 2u)) != 0u;
+                            const bool submitted =
+                                (flags & (1u << 3u)) != 0u;
+                            earlyPresentDecisionCount++;
+                            earlyPresentEnabledCount += enabled ? 1u : 0u;
+                            earlyPresentCandidateCount += candidate ? 1u : 0u;
+                            earlyPresentSubmittedCount += submitted ? 1u : 0u;
+                            earlyPresentSubmissionMissCount +=
+                                enabled && candidate && !submitted ? 1u : 0u;
+                        }
+                        else if (eventName ==
+                            "Present.CoalescedDuplicateWorkload") {
+                            coalescedDuplicateWorkloadCount++;
+                        }
+                        else if (eventName ==
+                            "Present.ManualPacingResult") {
+                            manualPacingResultEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "Present.FifoRateCalibrationObservation") {
+                            fifoRateCalibrationObservationCount++;
+                            fifoRateCalibrationCompletionId =
+                                event.correlationId;
+                            fifoRateAdvertisedHz =
+                                uint32_t(event.argument0);
+                            fifoRateObservedHz =
+                                double(event.argument1) / 1'000.0;
+                        }
+                        else if (eventName ==
+                            "Present.FifoRateCalibrated") {
+                            fifoRateCalibrationApplied = true;
+                            fifoRateCalibrationCompletionId =
+                                event.correlationId;
+                            fifoRateAdvertisedHz =
+                                uint32_t(event.argument0);
+                            fifoRateEffectiveHz =
+                                uint32_t(event.argument1);
+                        }
+                    }
+                    else if (event.kind == EventKind::Counter) {
+                        const std::string name(event.name.data());
+                        counterValues[name].emplace_back(event.value);
+                        if (name == "Work.DrawCalls" ||
+                            name == "Work.Triangles" ||
+                            name == "Work.SpecializedPipelines.World") {
+                            SubmissionIntegritySample &sample =
+                                submissionIntegritySampleMap[
+                                    event.correlationId
+                                ];
+                            sample.timestampNanoseconds = std::max(
+                                sample.timestampNanoseconds,
+                                event.timestampNanoseconds
+                            );
+                            sample.correlationId = event.correlationId;
+                            if (name == "Work.DrawCalls") {
+                                sample.drawCalls = event.value;
+                            }
+                            else if (name == "Work.Triangles") {
+                                sample.triangles = event.value;
+                            }
+                            else {
+                                sample.worldPipelines = event.value;
+                            }
+                        }
+                        HostResourceObservation *observation = nullptr;
+                        if ((name == "Host.SystemCPUPercent") ||
+                            (name == "Host.ExternalCPUPercent") ||
+                            (name == "Host.ExternalGPUPercent") ||
+                            (name == "Host.AvailableMemoryMiB") ||
+                            (name.compare(
+                                0,
+                                HostProcessCpuPrefix.size(),
+                                HostProcessCpuPrefix
+                            ) == 0) ||
+                            (name.compare(
+                                0,
+                                HostProcessGpuPrefix.size(),
+                                HostProcessGpuPrefix
+                            ) == 0) ||
+                            (name.compare(
+                                0,
+                                HostProcessMemoryPrefix.size(),
+                                HostProcessMemoryPrefix
+                            ) == 0)) {
+                            observation = &hostResourceObservationMap[
+                                event.correlationId
+                            ];
+                            observation->timestampNanoseconds = std::max(
+                                observation->timestampNanoseconds,
+                                event.timestampNanoseconds
+                            );
+                        }
+                        if (observation == nullptr) {
+                            continue;
+                        }
+                        if (name == "Host.SystemCPUPercent") {
+                            observation->systemCpuPercent = event.value;
+                            observation->systemCpuAvailable = true;
+                        }
+                        else if (name == "Host.ExternalCPUPercent") {
