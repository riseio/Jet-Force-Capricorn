diff --git a/src/hle/rt64_state_codec.h b/src/hle/rt64_state_codec.h
new file mode 100644
index 0000000..1b1c868
--- /dev/null
+++ b/src/hle/rt64_state_codec.h
@@ -0,0 +1,79 @@
+#pragma once
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+#include <type_traits>
+#include <vector>
+
+namespace RT64::StateIO {
+constexpr size_t MaximumBytes = 128 * 1024 * 1024;
+inline void check(bool valid, const char *message) {
+    if (!valid) throw std::runtime_error(message);
+}
+
+struct Writer {
+    static constexpr bool reading = false;
+    std::vector<uint8_t> data;
+    template<class T> void scalar(const T &value) {
+        static_assert(std::is_integral_v<T> || std::is_enum_v<T> || std::is_same_v<T, float>);
+        uint64_t bits;
+        if constexpr (std::is_same_v<T, float>) {
+            uint32_t word; std::memcpy(&word, &value, 4); bits = word;
+        } else bits = uint64_t(value);
+        check(data.size() <= MaximumBytes - 8, "Renderer save-state exceeds file budget");
+        for (unsigned i = 0; i < 8; ++i) data.push_back(uint8_t(bits >> (i * 8)));
+    }
+    template<class... T> void fields(const T&... value) { (scalar(value), ...); }
+    void bytes(const std::vector<uint8_t> &value) {
+        scalar(uint64_t(value.size()));
+        check(value.size() <= MaximumBytes - data.size(), "Renderer save-state exceeds file budget");
+        data.insert(data.end(), value.begin(), value.end());
+    }
+};
+struct Reader {
+    static constexpr bool reading = true;
+    const std::vector<uint8_t> &data;
+    size_t offset = 0;
+    uint64_t preparedGPUBytes = 0;
+    explicit Reader(const std::vector<uint8_t> &value) : data(value) {
+        check(data.size() <= MaximumBytes, "Renderer save-state exceeds file budget");
+    }
+    template<class T> void scalar(T &value) {
+        static_assert(std::is_integral_v<T> || std::is_enum_v<T> || std::is_same_v<T, float>);
+        check(data.size() - offset >= 8, "Truncated renderer save-state scalar");
+        uint64_t bits = 0;
+        for (unsigned i = 0; i < 8; ++i) bits |= uint64_t(data[offset++]) << (8 * i);
+        if constexpr (std::is_same_v<T, float>) {
+            check(bits <= UINT32_MAX, "Invalid renderer float representation");
+            const uint32_t word = uint32_t(bits); std::memcpy(&value, &word, 4);
+        } else if constexpr (std::is_enum_v<T>) {
+            using U = std::underlying_type_t<T>;
+            check(uint64_t(U(bits)) == bits, "Renderer enum outside field range");
+            value = T(U(bits));
+        } else {
+            check(uint64_t(T(bits)) == bits, "Renderer integer outside field range");
+            value = T(bits);
+        }
+    }
+    template<class... T> void fields(T&... value) { (scalar(value), ...); }
+    void bytes(std::vector<uint8_t> &value, size_t limit = MaximumBytes) {
+        uint64_t length = 0; scalar(length);
+        check(length <= limit && length <= data.size() - offset, "Invalid renderer save-state byte extent");
+        value.assign(data.begin() + offset, data.begin() + offset + size_t(length));
+        offset += size_t(length);
+    }
+    void gpuBytes(uint64_t bytes) {
+
+        constexpr uint64_t Budget = 1024ull * 1024 * 1024;
+        check(bytes <= Budget - preparedGPUBytes, "Restored GPU state exceeds 1 GiB resource budget");
+        preparedGPUBytes += bytes;
+    }
+    void end() const { check(offset == data.size(), "Trailing renderer save-state data"); }
+};
+template<class A> uint32_t count(A &a, size_t size, uint32_t maximum) {
+    uint64_t value = size; a.scalar(value);
+    check(value <= maximum, "Renderer save-state collection exceeds bound");
+    return uint32_t(value);
+}
+}
