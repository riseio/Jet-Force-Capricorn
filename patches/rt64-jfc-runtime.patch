+        const bool alphaBlend = interop::Blender::usesAlphaBlend(otherMode);
+        const bool depthDecal = otherMode.zMode() == ZMODE_DEC;
+        const bool depthSurface = otherMode.zCmp() || otherMode.zUpd();
+        const bool eligible = modernLightingMaterialEligible(
+                gameplayScene,
+                false,
+                indexed,
+                shadeColor,
+                alphaBlend,
+                depthDecal,
+                depthSurface);
+        const bool eligibleWorld = eligible &&
+            call.modernLightingCandidateInitialized &&
+            call.modernLightingCandidateValid;
+        if (!eligibleWorld) {
+            return;
+        }
+
+        gameCall.modernLightingDesc.lightIndex =
+            (call.geometryMode & G_LIGHTING) != 0 ? 1U : 0U;
+        gameCall.modernLightingDesc.lightCount = 1U;
+    }
