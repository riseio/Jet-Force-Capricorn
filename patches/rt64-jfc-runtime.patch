+    void AudioProfile::start(uint64_t stream, uint32_t outputRate, uint32_t channels) {
+        if (!state().accepting.load(std::memory_order_acquire)) return;
+        if (outputRate < 8000 || outputRate > 768000 || !channels || channels > 32) {
+            audioError(stream, 6);
+            return;
+        }
+        auto *entry = audioStream(stream, true);
+        if (!entry) return;
+        if (!state().passiveRing) {
+            entry->callbackBuffer=prepareAudioCallbackBuffer(state());
+            if (!entry->callbackBuffer) { audioError(stream,10); return; }
+        }
+        entry->context.store(AudioActive | uint64_t(channels) << 32 | outputRate, std::memory_order_release);
+
+        PerformanceProfiler::setMetadata("producer.audio_stream.schema", "rt64-audio-v2");
+        PerformanceProfiler::setMetadata("producer.audio_stream.supported", "1");
+        PerformanceProfiler::setMetadata("producer.audio_stream.enabled", "1");
+        audioEmit("Audio.StreamStart", stream, outputRate, channels);
+    }
+
+    void AudioProfile::stop(uint64_t stream) {
+        auto *entry = audioStream(stream);
+        if (!entry) return;
+        const uint64_t previous = entry->context.fetch_and(~AudioActive, std::memory_order_acq_rel);
+        if (!(previous & AudioActive)) { audioError(stream, 5); return; }
+        audioEmitContext(stream, previous);
+        audioEmit("Audio.StreamStop", stream);
+    }
+
+    void AudioProfile::phase(uint64_t stream, Phase phase) {
+        if (uint64_t(phase) > uint64_t(Phase::Loading)) {
+            if (state().accepting.load(std::memory_order_acquire)) audioError(stream, 7);
+            return;
+        }
+        auto *entry = audioStream(stream);
+        if (!entry) return;
+
+        uint64_t previous = entry->context.load(std::memory_order_acquire);
+        if (!(previous & AudioActive)) { audioError(stream, 5); return; }
+        const uint64_t updated = (previous & ~(uint64_t(0xff) << 40)) | uint64_t(phase) << 40;
+        if (!entry->context.compare_exchange_strong(previous, updated, std::memory_order_acq_rel)) {
+            audioError(stream, 8);
+            return;
+        }
+        audioEmitContext(stream, updated);
+        audioEmit("Audio.StreamPhase", stream, uint64_t(phase));
+    }
+
+    void AudioProfile::produced(uint64_t stream, uint64_t nativeFrames, uint64_t outputFrames) {
+        if (!PerformanceProfiler::enabled()) return;
+        const uint64_t context = audioContext(stream);
+        if (!context) return;
+        audioEmitContext(stream, context);
+        audioEmit("Audio.ProducerFrames", stream, nativeFrames, outputFrames);
+    }
+
+    void AudioProfile::callbackBegin(uint64_t stream, uint64_t callback, uint64_t requestedFrames, uint64_t queuedFrames) {
+        AudioCallbackWriter writer(stream);
+        if (!writer.entry) return;
+        if (!callback || !requestedFrames || requestedFrames>AudioFrameMask) { writer.invalid(); return; }
+        writer.emit("Audio.StreamContext",writer.context&0xffffffff,(writer.context>>32)&0xff);
+        writer.emit("Audio.CallbackBeginV2",callback,requestedFrames|((writer.context>>40)&0xff)<<56);
+        writer.emit("Audio.CallbackOccupancy",callback,queuedFrames);
+    }
+
+    void AudioProfile::callbackEnd(uint64_t stream, uint64_t callback, uint64_t missingFrames) {
+        AudioCallbackWriter writer(stream);
+        if (!writer.entry) return;
+        if (!callback || missingFrames>AudioFrameMask) { writer.invalid(); return; }
+        writer.emit("Audio.CallbackEnd",callback,missingFrames);
+    }
