+        worker->commandList->setViewports(RenderViewport(constants.offset[0], constants.offset[1], nativeWidth * scale, nativeHeight * scale));
+        worker->commandList->setScissors(RenderRect(long(std::floor(constants.offset[0])), long(std::floor(constants.offset[1])),
+            long(std::ceil(right)), long(std::ceil(bottom))));
+        worker->commandList->setPipeline(pipeline);
+        worker->commandList->setGraphicsPipelineLayout(shader.pipelineLayout.get());
+        worker->commandList->setGraphicsPushConstants(0, &constants);
+        worker->commandList->setGraphicsDescriptorSet(descriptors->get(), 0);
+        worker->commandList->setVertexBuffers(0, nullptr, 0, nullptr);
+        worker->commandList->drawInstanced(3, 1, 0, 0);
+        target.markForResolve();
+    }
+}
