+    namespace {
+        void recordRuntimeTaskBoundary(unsigned phase, uint64_t sequence, uint32_t displayList) {
+            using Profiler = PerformanceProfiler;
+            struct Slot {
+                std::atomic_flag busy = ATOMIC_FLAG_INIT;
+                uint64_t sequence = 0, submitted = 0, started = 0;
+                uint32_t displayList = 0;
+            };
+            static std::array<Slot, 256> slots;
+            static std::atomic<uint64_t> previousSubmission{0}, previousCompletion{0};
+            static const bool declared = []() {
+                Profiler::setMetadata("producer.graphics_tasks.supported", "1");
+                Profiler::setMetadata("producer.graphics_tasks.enabled", Profiler::mode() != PerformanceCaptureMode::Disabled ? "1" : "0");
+                Profiler::setMetadata("graphics_task_completion_owner", "N64ModernRuntime send_dl callback completed; not GPU retirement");
+                return true;
+            }();
+            (void)declared;
+            if (!Profiler::captureEnabled()) return;
+            const uint64_t now = Profiler::nowNanoseconds();
+            const uint64_t resume = state().resumeTimestamp.load(std::memory_order_acquire);
+            Slot &slot = slots[sequence % slots.size()];
+            if (slot.busy.test_and_set(std::memory_order_acquire)) {
+                Profiler::recordCriticalInstant(PerformanceCategory::CPU, "Recorder.GraphicsTaskTrackingOverload", sequence, displayList, phase);
+                return;
+            }
+            uint64_t start = 0;
+            bool incomplete = false;
+            if (phase == 0) {
+                incomplete = slot.sequence != 0 && slot.submitted >= resume;
+                slot.sequence = sequence;
+                slot.displayList = displayList;
+                slot.submitted = now;
+                slot.started = 0;
+            }
+            else if (!sequence || slot.sequence != sequence || slot.displayList != displayList || slot.submitted < resume) {
+                incomplete = true;
+            }
+            else if (phase == 1) {
+                incomplete = slot.started != 0;
+                start = slot.submitted;
+                slot.started = now;
+            }
+            else {
+                start = slot.started;
+                incomplete = start == 0;
+                slot.sequence = 0;
+            }
+            slot.busy.clear(std::memory_order_release);
+            if (incomplete || !sequence) {
+                Profiler::recordCriticalInstant(PerformanceCategory::CPU, "Recorder.GraphicsTaskBoundaryUnobserved", sequence, displayList, phase);
+                return;
+            }
+            if (phase == 0) {
+                const uint64_t previous = previousSubmission.exchange(now, std::memory_order_acq_rel);
+                if (previous && previous >= resume && previous < now) Profiler::recordDuration(PerformanceCategory::Wait,
+                    "FrameProduction.GuestGraphicsTaskInterval", previous, now, sequence, displayList);
+                const uint64_t completed = previousCompletion.exchange(0, std::memory_order_acq_rel);
+                if (completed && completed >= resume && completed < now) Profiler::recordDuration(PerformanceCategory::Wait,
+                    "FrameProduction.GuestGraphicsWaitAfterCompletion", completed, now, sequence, displayList);
+                Profiler::recordCriticalInstant(PerformanceCategory::Frame, "FrameProduction.GraphicsTaskSubmitted", sequence, displayList);
+            }
+            else if (phase == 1 && start && start <= now) {
+                Profiler::recordDuration(PerformanceCategory::Wait, "FrameProduction.GraphicsActionQueueDelay", start, now, sequence, displayList);
+            }
+            else if (phase == 2 && start && start <= now) {
+                Profiler::recordCriticalInstant(PerformanceCategory::Frame, "FrameProduction.GraphicsTaskCompleted", sequence, displayList, now - start);
+                Profiler::recordDuration(PerformanceCategory::CPU, "FrameProduction.GraphicsTaskActionWork", start, now, sequence, displayList);
+                previousCompletion.store(now, std::memory_order_release);
+            }
+        }
+    }
