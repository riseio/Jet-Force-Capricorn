+#pragma once
+
+#include <cstdint>
+
+#include "shared/rt64_f3d_defines.h"
+
+namespace RT64 {
+    constexpr bool modernLightingUsesShadeColor(
+        uint32_t combinerL,
+        uint32_t combinerH,
+        uint32_t cycleType
+    ) {
+        const uint32_t cycleCount = cycleType == G_CYC_2CYCLE ? 2U :
+            (cycleType == G_CYC_1CYCLE ? 1U : 0U);
+        for (uint32_t cycle = 0; cycle < cycleCount; ++cycle) {
+            const bool secondCycle = (cycleCount == 1) || (cycle != 0);
+            const uint32_t a = secondCycle ? (combinerL >> 5U) & 0xFU :
+                (combinerL >> 20U) & 0xFU;
+            const uint32_t b = secondCycle ? (combinerH >> 24U) & 0xFU :
+                (combinerH >> 28U) & 0xFU;
+            const uint32_t c = secondCycle ? combinerL & 0x1FU :
+                (combinerL >> 15U) & 0x1FU;
+            const uint32_t d = secondCycle ? (combinerH >> 6U) & 0x7U :
+                (combinerH >> 15U) & 0x7U;
+            if (a == 4U || b == 4U || c == 4U || d == 4U) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    constexpr bool modernLightingMaterialEligible(
+        bool enabled,
+        bool raytracing,
+        bool indexedTriangles,
+        bool shadeColor,
+        bool alphaBlend,
+        bool depthDecal,
+        bool depthSurface
+    ) {
+
+        return enabled && !raytracing && indexedTriangles && shadeColor &&
+            !alphaBlend && !depthDecal && depthSurface;
+    }
+}
