diff --git a/src/render/rt64_texture_read_epochs.h b/src/render/rt64_texture_read_epochs.h
new file mode 100644
index 0000000..7b9b637
--- /dev/null
+++ b/src/render/rt64_texture_read_epochs.h
@@ -0,0 +1,45 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+namespace RT64 {
+
+    class TextureReadEpochs {
+        uint64_t latestEpoch = 0;
+        std::vector<uint64_t> readers;
+
+    public:
+        explicit TextureReadEpochs(size_t reservedReaders = 0) {
+            readers.reserve(reservedReaders);
+        }
+
+        uint64_t acquire() {
+            if (latestEpoch == std::numeric_limits<uint64_t>::max() - 1) {
+                throw std::overflow_error("Texture snapshot epoch exhausted");
+            }
+            const uint64_t epoch = latestEpoch + 1;
+            readers.push_back(epoch);
+            latestEpoch = epoch;
+            return epoch;
+        }
+
+        void release(uint64_t epoch) {
+            const auto it = std::lower_bound(readers.begin(), readers.end(), epoch);
+            if (it == readers.end() || *it != epoch) {
+                throw std::logic_error("Unknown or already retired texture snapshot");
+            }
+            readers.erase(it);
+        }
+
+        uint64_t latest() const { return latestEpoch; }
+        uint64_t oldest() const {
+            return readers.empty() ? latestEpoch + 1 : readers.front();
+        }
+        size_t size() const { return readers.size(); }
+    };
+}
