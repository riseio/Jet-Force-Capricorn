diff --git a/src/shaders/CpuFramebufferEffectsPS.hlsl b/src/shaders/CpuFramebufferEffectsPS.hlsl
new file mode 100644
index 0000000..5ec082a
--- /dev/null
+++ b/src/shaders/CpuFramebufferEffectsPS.hlsl
@@ -0,0 +1,72 @@
+#include "Formats.hlsli"
+#include "Random.hlsli"
+
+struct Constants {
+    uint2 resolution;
+    float2 scale;
+    float2 offset;
+    uint usesHDR;
+    uint padding;
+    uint2 backgroundExtent;
+};
+[[vk::push_constant]] ConstantBuffer<Constants> gConstants : register(b0);
+Texture2D<float4> gBackground : register(t1);
+StructuredBuffer<uint> gOperations : register(t2);
+
+uint channel(uint map, uint value) {
+    int offset = int(map & 63) - ((map & 32) ? 64 : 0);
+    return uint(clamp(int(value) + offset, int((map >> 6) & 31), int((map >> 11) & 31)));
+}
+
+uint nativeBlend(uint value, uint operation) {
+JFC_NATIVE_BLEND}
+uint nativeOpaque(uint operation) {
+JFC_NATIVE_OPAQUE}
+
+float4 PSMain(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_TARGET {
+    uint2 pixel = min(uint2(uv * gConstants.resolution), gConstants.resolution - 1);
+    uint index = pixel.y * gConstants.resolution.x + pixel.x;
+    uint base = 6 + index * 5;
+    uint source = gOperations[base + 1];
+    uint tint = gOperations[base + 2];
+    uint rg = gOperations[base + 3];
+    uint b = gOperations[base + 4];
+    if (gOperations[base] == 0xFFFFFFFF && (tint & 0x10000) == 0 && (b & 0x10000) == 0) discard;
+
+    uint value;
+    if ((source & 0x80000000) != 0) value = source & 0xFFFF;
+    else {
+        uint2 nativeSource = uint2(source % gConstants.resolution.x, source / gConstants.resolution.x);
+        uint nodeBase = 6 + gOperations[4] * 5;
+        uint conversion = nodeBase + gOperations[5] * 2 + nativeSource.y * 2;
+        if (gOperations[conversion] == 4) {
+
+            value = gOperations[gOperations[conversion + 1] + nativeSource.x];
+        } else {
+            float2 sourcePosition = pos.xy + (float2(nativeSource) - float2(pixel)) * gConstants.scale;
+            uint2 samplePosition = uint2(clamp(sourcePosition, 0.0f, float2(gConstants.backgroundExtent - 1)));
+            float4 background = gBackground.Load(uint3(samplePosition, 0));
+            uint randomSeed = initRand(gOperations[conversion + 1], source, 16);
+            uint dither = DitherPatternValue(gOperations[conversion], nativeSource, randomSeed);
+            value = Float4ToRGBA16(background, dither, gConstants.usesHDR != 0);
+        }
+        uint node = gOperations[6 + source * 5];
+
+        [loop] while (node != 0xFFFFFFFF) {
+            uint operation = gOperations[nodeBase + node * 2];
+            if ((operation & 0x1000000) != 0) value = nativeOpaque(operation);
+            else {
+                value = nativeBlend(value, operation);
+            }
+            node = gOperations[nodeBase + node * 2 + 1];
+        }
+    }
+    if ((tint & 0x10000) != 0) value = (value + (tint & 0xFFFF)) & 0xFFFF;
+    if ((b & 0x10000) != 0) {
+        value = (channel(rg & 0xFFFF, value >> 11) << 11) |
+            (channel(rg >> 16, (value >> 6) & 31) << 6) |
+            (channel(b & 0xFFFF, (value >> 1) & 31) << 1) |
+            ((b & 0x20000) != 0 ? 1 : (value & 1));
+    }
+    return RGBA16ToFloat4(value);
+}
diff --git a/src/shaders/GeometryDepthCS.hlsl b/src/shaders/GeometryDepthCS.hlsl
new file mode 100644
index 0000000..d1a34ce
--- /dev/null
+++ b/src/shaders/GeometryDepthCS.hlsl
@@ -0,0 +1,22 @@
+struct GeometryDepthCB { uint width; uint height; uint samples; };
+[[vk::push_constant]] ConstantBuffer<GeometryDepthCB> gConstants : register(b0);
+#ifdef MULTISAMPLING
+Texture2DMS<float> sourceDepth : register(t1);
+#else
+Texture2D<float> sourceDepth : register(t1);
+#endif
+RWStructuredBuffer<float2> depthExtrema : register(u2);
+[numthreads(8, 8, 1)]
+void CSMain(uint2 pixel : SV_DispatchThreadID) {
+    if (pixel.x >= gConstants.width || pixel.y >= gConstants.height) { return; }
+#ifdef MULTISAMPLING
+    float lo = sourceDepth.Load(pixel, 0), hi = lo;
+    for (uint s = 1; s < gConstants.samples; ++s) {
+        float z = sourceDepth.Load(pixel, s);
+        lo = min(lo, z); hi = max(hi, z);
+    }
+#else
+    float lo = sourceDepth.Load(uint3(pixel, 0)), hi = lo;
+#endif
+    depthExtrema[pixel.y * gConstants.width + pixel.x] = float2(lo, hi);
+}
diff --git a/src/shaders/ModernLighting.hlsli b/src/shaders/ModernLighting.hlsli
new file mode 100644
index 0000000..88cca46
--- /dev/null
+++ b/src/shaders/ModernLighting.hlsli
@@ -0,0 +1,36 @@
+#ifndef RT64_MODERN_LIGHTING_HLSLI
+#define RT64_MODERN_LIGHTING_HLSLI
+
+ByteAddressBuffer ModernWorldPositions : register(t27, space0);
+ByteAddressBuffer ModernWorldNormals : register(t28, space0);
+
+float3 loadModernWorldPosition(uint vertexIndex) {
+    return asfloat(ModernWorldPositions.Load4(vertexIndex * 16)).xyz;
+}
+
+float3 loadModernWorldNormal(uint vertexIndex) {
+    return asfloat(ModernWorldNormals.Load4(vertexIndex * 16)).xyz;
+}
+
+float3 computeModernLighting(float3 worldNormal) {
+    const float normalLengthSquared = dot(worldNormal, worldNormal);
+    const float3 normal = normalLengthSquared > 1e-8f
+        ? worldNormal * rsqrt(normalLengthSquared)
+        : float3(0.0f, 1.0f, 0.0f);
+    const float3 keyDirection = normalize(float3(0.45f, 0.82f, 0.35f));
+    const float key = saturate(abs(dot(normal, keyDirection)));
+    const float sky = saturate(normal.y * 0.5f + 0.5f);
+    return float3(0.025f, 0.03f, 0.04f) +
+        key * float3(0.32f, 0.29f, 0.25f) +
+        sky * float3(0.025f, 0.04f, 0.065f);
+}
+
+float3 compositeModernLighting(float3 surfaceColor, float3 illumination) {
+    const float3 surface = saturate(surfaceColor);
+    const float3 dynamic = max(illumination, 0.0f) /
+        (1.0f + max(illumination, 0.0f));
+
+    return surface + (1.0f - surface) * dynamic;
+}
+
+#endif
