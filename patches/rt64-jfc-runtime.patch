+namespace RT64 {
+namespace CpuFramebufferEffects {
+    constexpr uint32_t Magic = 0x43464531U;
+    constexpr uint32_t HeaderWords = 6;
+    constexpr uint32_t PixelWords = 5;
+    constexpr uint32_t RainWords = 2;
+    constexpr uint32_t None = UINT32_MAX;
+    constexpr uint32_t ConstantSource = 0x80000000U;
+    constexpr uint32_t Refracted = 0x10000U;
+    constexpr uint32_t Added = 0x10000U;
+    constexpr uint32_t ForceAlpha = 0x20000U;
+    constexpr uint32_t OpaqueRain = 0x1000000U;
+    constexpr uint16_t IdentityChannel = 31U << 11;
+
+    inline uint64_t replayBufferCapacity(uint64_t bytes) {
+        constexpr uint64_t limit = uint64_t(UINT32_MAX) * sizeof(uint32_t);
+        if (!bytes || bytes > limit || bytes % sizeof(uint32_t))
+            throw std::invalid_argument("Invalid CPU replay buffer length");
+        uint64_t capacity = sizeof(uint32_t);
+        while (capacity < bytes) {
+            if (capacity > limit / 2) return limit;
+            capacity *= 2;
+        }
+        return capacity;
+    }
+
+    inline uint32_t applyChannel(uint16_t map, uint32_t value) {
+        const int offset = int(map & 63U) - ((map & 32U) ? 64 : 0);
+        return uint32_t(std::clamp(int(value) + offset,
+            int((map >> 6) & 31U), int(map >> 11)));
+    }
+
+    inline uint16_t appendChannel(uint16_t map, int delta) {
+        const int offset = int(map & 63U) - ((map & 32U) ? 64 : 0);
+        const int low = std::clamp(int((map >> 6) & 31U) + delta, 0, 31);
+        const int high = std::clamp(int(map >> 11) + delta, 0, 31);
+        const int nextOffset = low == high ? 0 : offset + delta;
+        if (nextOffset < -31 || nextOffset > 31)
+            throw std::logic_error("CPU effect channel composition overflow");
+        return uint16_t((uint32_t(nextOffset) & 63U) | (low << 6) | (high << 11));
+    }
+
+    inline uint16_t applyAddition(uint16_t background, uint32_t rg, uint32_t b) {
+        if (!(b & Added)) return background;
+        return uint16_t((applyChannel(uint16_t(rg), background >> 11) << 11) |
+            (applyChannel(uint16_t(rg >> 16), (background >> 6) & 31U) << 6) |
+            (applyChannel(uint16_t(b), (background >> 1) & 31U) << 1) |
+            ((b & ForceAlpha) ? 1U : (background & 1U)));
+    }
+
+    inline void validate(const uint32_t *words, size_t count) {
+        if (count == 0) return;
+        if (words == nullptr || count < HeaderWords || count > UINT32_MAX || words[0] != Magic || words[1] != 1)
+            throw std::invalid_argument("Invalid CPU framebuffer effect header");
+        const uint64_t pixels = uint64_t(words[2]) * words[3];
+        if (pixels == 0 || pixels > 0x400000U || words[4] != pixels ||
+            uint64_t(HeaderWords) + pixels * PixelWords + uint64_t(words[5]) * RainWords != count)
+            throw std::invalid_argument("Invalid CPU framebuffer effect dimensions/length");
+        const auto validMap = [](uint16_t m) {
+            return ((m >> 6) & 31U) <= (m >> 11);
+        };
+        for (uint32_t i = 0; i < pixels; ++i) {
+            const uint32_t *p = words + HeaderWords + size_t(i) * PixelWords;
+            if ((p[0] != None && p[0] >= words[5]) ||
+                ((p[1] & ConstantSource) ? ((p[1] & ~ConstantSource) > 0xFFFFU) : (p[1] >= pixels)) ||
+                (p[2] & ~(Refracted | 0xFFFFU)) || (p[4] & ~(Added | ForceAlpha | 0xFFFFU)) ||
+                !validMap(uint16_t(p[3])) || !validMap(uint16_t(p[3] >> 16)) || !validMap(uint16_t(p[4])))
+                throw std::invalid_argument("Invalid CPU framebuffer pixel operation");
+        }
+        const uint32_t *nodes = words + HeaderWords + size_t(pixels) * PixelWords;
+        for (uint32_t i = 0; i < words[5]; ++i) {
+            const uint32_t next = nodes[size_t(i) * RainWords + 1];
+            if ((nodes[size_t(i) * RainWords] & 0xFE000000U) ||
+                (next != None && (next <= i || next >= words[5])))
+                throw std::invalid_argument("Invalid CPU framebuffer rain operation chain");
+        }
+    }
+
+    inline void validateReplay(const uint32_t *words, size_t count) {
+        if (!words || count < HeaderWords) throw std::invalid_argument("Missing CPU replay header");
+        const uint64_t authored = uint64_t(HeaderWords) + uint64_t(words[4]) * PixelWords + uint64_t(words[5]) * RainWords;
+        const uint64_t suffixEnd = authored + uint64_t(words[3]) * 2;
+        if (suffixEnd > count || count > UINT32_MAX) throw std::invalid_argument("Truncated CPU replay conversion history");
+        validate(words, size_t(authored));
+        for (uint32_t i = 0; i < words[4]; ++i) {
+            const uint32_t *op = words + HeaderWords + size_t(i) * PixelWords;
+            if ((op[0] == None && !(op[2] & Refracted) && !(op[4] & Added)) ||
+                (op[1] & ConstantSource)) continue;
+            const size_t row = op[1] / words[2];
+            const uint32_t pattern = words[authored + row * 2];
+            const uint32_t offset = words[authored + row * 2 + 1];
+            if (pattern > 4 || (pattern == 4 &&
+                (offset < suffixEnd || uint64_t(offset) + words[2] > count)))
+                throw std::invalid_argument("Invalid CPU replay source provenance");
+            if (pattern == 4 && words[offset + op[1] % words[2]] > 0xFFFF)
+                throw std::invalid_argument("Invalid packed CPU replay source");
+        }
+    }
+
+    class Builder {
+        std::vector<uint32_t> words;
+        std::vector<uint32_t> tails;
+        bool changed = false;
+
+        uint32_t *pixel(uint32_t index) {
+            if (words.empty() || index >= words[4])
+                throw std::out_of_range("CPU framebuffer effect pixel outside image");
+            return words.data() + HeaderWords + size_t(index) * PixelWords;
+        }
+    public:
+        void begin(uint32_t width, uint32_t height) {
+            const uint64_t pixels = uint64_t(width) * height;
+            if (pixels == 0 || pixels > 0x400000U)
+                throw std::invalid_argument("CPU framebuffer image does not fit RDRAM");
+            words.resize(HeaderWords + size_t(pixels) * PixelWords);
+            words[0] = Magic; words[1] = 1; words[2] = width; words[3] = height;
+            words[4] = uint32_t(pixels); words[5] = 0;
+            tails.assign(size_t(pixels), None);
+            changed = false;
+            for (uint32_t i = 0; i < pixels; ++i) {
+                uint32_t *p = pixel(i);
+                p[0] = None; p[1] = i; p[2] = 0;
+                p[3] = uint32_t(IdentityChannel) | (uint32_t(IdentityChannel) << 16);
+                p[4] = IdentityChannel;
+            }
+        }
+        void rain(uint32_t index, uint16_t color, uint8_t shift, bool opaque) {
+            pixel(index);
+            if (words[5] == UINT32_MAX || words.size() > UINT32_MAX - RainWords || words.size() > words.max_size() - RainWords)
+                throw std::length_error("CPU framebuffer rain journal exhausted");
+            const uint32_t node = words[5];
+            words.push_back(uint32_t(color) | (uint32_t(shift) << 16) | (opaque ? OpaqueRain : 0U));
+            words.push_back(None);
+            const size_t nodes = HeaderWords + size_t(words[4]) * PixelWords;
+            if (tails[index] == None) pixel(index)[0] = node;
+            else words[nodes + size_t(tails[index]) * RainWords + 1] = node;
+            tails[index] = node;
+            words[5]++;
+            changed = true;
+        }
+        void refract(uint32_t index, uint32_t source, uint16_t tint, bool constant = false) {
+            uint32_t *p = pixel(index);
+            if (constant ? source > 0xFFFFU : source >= words[4])
+                throw std::out_of_range("CPU framebuffer refraction source outside image");
+            p[1] = source | (constant ? ConstantSource : 0U);
+            p[2] = uint32_t(tint) | Refracted;
+            changed = true;
+        }
+        void add(uint32_t index, int r, int g, int b, bool alpha) {
+            if (r < -128 || r > 255 || g < -128 || g > 255 || b < -128 || b > 255)
+                throw std::invalid_argument("CPU framebuffer channel delta outside native byte range");
+            uint32_t *p = pixel(index);
+            p[3] = uint32_t(appendChannel(uint16_t(p[3]), r)) |
+                (uint32_t(appendChannel(uint16_t(p[3] >> 16), g)) << 16);
+            p[4] = uint32_t(appendChannel(uint16_t(p[4]), b)) |
+                (p[4] & ForceAlpha) | Added | (alpha ? ForceAlpha : 0U);
+            changed = true;
+        }
+        const uint32_t *data() const { return words.data(); }
+        size_t size() const { return changed ? words.size() : 0; }
+    };
+}
+}
