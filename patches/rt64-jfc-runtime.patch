+        void writeJournalEvent(std::ostream &output, const Event &event) {
+
+            thread_local std::string line;
+            if (line.capacity() < 2048) line.reserve(2048);
+            line.clear();
+            line += "{\"record\":\"event\",\"name\":\"";
+            appendJsonEscape(line, event.name.data());
+            line += "\",\"category\":\"";
+            line += categoryName(event.category);
+            line += "\",\"kind\":";
+            appendTraceInteger(line, unsigned(event.kind));
+            line += ",\"timestamp_ns\":";
+            appendTraceInteger(line, event.timestampNanoseconds);
+            line += ",\"duration_ns\":";
+            appendTraceInteger(line, event.durationNanoseconds);
+            line += ",\"thread_cpu_duration_ns\":";
+            appendTraceInteger(line, event.threadCpuDurationNanoseconds);
+            line += ",\"correlation_id\":";
+            appendTraceInteger(line, event.correlationId);
+            line += ",\"argument0\":";
+            appendTraceInteger(line, event.argument0);
+            line += ",\"argument1\":";
+            appendTraceInteger(line, event.argument1);
+            line += ",\"producer_sequence\":";
+            appendTraceInteger(line, event.producerSequence);
+            line += ",\"producer_thread_id\":";
+            appendTraceInteger(line, event.threadId);
+            line += ",\"gpu_start_ns\":";
+            appendTraceInteger(line, event.gpuStartNanoseconds);
+            line += ",\"gpu_end_ns\":";
+            appendTraceInteger(line, event.gpuEndNanoseconds);
+            line += ",\"value\":";
+            appendTraceCounter(line, event.value);
+            line += ",\"thread_id\":";
+            appendTraceInteger(line, event.threadId);
+            line += ",\"os_thread_id\":";
+            appendTraceInteger(line, event.osThreadId);
+            line += ",\"thread_name\":\"";
+            const auto &profiler = state();
+            if (event.threadId > 0 && event.threadId <= profiler.maximumThreads &&
+                profiler.threadNamesReady[event.threadId - 1].load(std::memory_order_acquire))
+                appendJsonEscape(line, profiler.passiveThreadNames[event.threadId - 1].data());
+            line += "\",\"gpu_clock\":";
+            line += event.gpuClock ? "true" : "false";
+            line += ",\"thread_cpu_measured\":";
+            line += event.threadCpuMeasured ? "true" : "false";
+            line += ",\"thread_scope\":";
+            line += event.threadScope ? "true" : "false";
+            line += "}\n";
+            output.write(line.data(), std::streamsize(line.size()));
+        }
