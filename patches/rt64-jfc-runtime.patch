+
+    constexpr bool displayListInRange(
+        uintptr_t begin,
+        uintptr_t end,
+        uintptr_t address,
+        size_t words = 1
+    ) {
+        return (address % alignof(DisplayList)) == 0 &&
+            address >= begin && address <= end &&
+            words <= (end - address) / sizeof(DisplayList);
+    }
+    inline void requireDisplayListRange(uintptr_t begin, uintptr_t end,
+        const DisplayList *command, size_t words) {
+        if (!words || !displayListInRange(begin, end, reinterpret_cast<uintptr_t>(command), words))
+            throw std::runtime_error("Truncated or invalid display-list command extent");
+    }
+
+    inline bool f3dTerminalFullSync(uintptr_t begin, uintptr_t end,
+        const DisplayList *command) {
+        const uintptr_t address = reinterpret_cast<uintptr_t>(command);
+        if (!displayListInRange(begin, end, address) ||
+            command->w0 != 0xE9000000U || command->w1 != 0) {
+            return false;
+        }
+        const uintptr_t next = address + sizeof(DisplayList);
+        if (next == end) {
+            return true;
+        }
+        if (!displayListInRange(begin, end, next)) {
+            return false;
+        }
+        const DisplayList *tail = reinterpret_cast<const DisplayList *>(next);
+        return tail->w0 == 0xB8000000U && tail->w1 == 0;
+    }
+};
