+            return false;
+        const bool rgba32 = tile.siz == G_IM_SIZ_32b && tile.fmt == G_IM_FMT_RGBA;
+        const uint32_t shift = rgba32 ? G_IM_SIZ_16b : tile.siz;
+        const uint32_t mask = rgba32 ? 2047 : 4095;
+        const uint32_t stride = uint32_t(tile.line) * 8;
+        const uint64_t sampledBytes = uint64_t(stride) * (height - 1) +
+            ((uint64_t(width) << shift) + 1) / 2;
+        if (sampledBytes > mask + 1) return false;
+        if (!(tile.fmt == G_IM_FMT_IA && tile.siz <= G_IM_SIZ_16b) &&
+            !(tile.fmt == G_IM_FMT_I && tile.siz <= G_IM_SIZ_8b) &&
+            !(tile.fmt == G_IM_FMT_RGBA && tile.siz >= G_IM_SIZ_16b))
+            return false;
+        for (uint32_t y = 0; y < height; ++y) {
+            for (uint32_t x = 0; x < width; ++x) {
+                const uint32_t address = ((uint32_t(tile.tmem) * 8 + y * stride +
+                    ((x << shift) >> 1)) ^ ((y & 1) ? 4 : 0)) & mask;
+                if (rgba32) {
+                    if (bytes[((address + 1) & mask) | 2048] != 255) return false;
+                }
+                else if (tile.siz == G_IM_SIZ_16b) {
+                    const uint8_t alpha = bytes[(address + 1) & mask];
+                    if (tile.fmt == G_IM_FMT_RGBA ? !(alpha & 1) : alpha != 255) return false;
+                }
+                else if (tile.siz == G_IM_SIZ_8b) {
+                    const uint8_t alphaMask = tile.fmt == G_IM_FMT_IA ? 15 : 255;
+                    if ((bytes[address] & alphaMask) != alphaMask) return false;
+                }
+                else {
+                    const uint8_t nibble = (bytes[address] >> ((x & 1) ? 0 : 4)) & 15;
+                    if (tile.fmt == G_IM_FMT_IA ? !(nibble & 1) : nibble != 15) return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    inline bool alignedSize(uint64_t size, uint32_t alignment, uint32_t &result) {
+        if (!alignment || size > UINT32_MAX) return false;
+        const uint64_t aligned = ((size + alignment - 1) / alignment) * alignment;
+        if (aligned > UINT32_MAX) return false;
+        result = uint32_t(aligned);
+        return true;
+    }
+
+    inline bool dimensions(uint32_t width, uint32_t height, uint32_t mips) {
+        if (!width || !height || width > MaxDimension || height > MaxDimension || !mips)
+            return false;
+        uint32_t levels = 1;
+        for (uint32_t size = std::max(width, height); size > 1; size >>= 1) ++levels;
+        return mips <= levels;
+    }
+
+    inline bool ddsHeader(const uint8_t *bytes, size_t count, ddspp::Descriptor &descriptor) {
+        constexpr size_t baseSize = sizeof(uint32_t) + sizeof(ddspp::Header);
+        if (!bytes || count < baseSize) return false;
+        ddspp::Header header;
+        uint32_t magic;
+        std::memcpy(&magic, bytes, sizeof(magic));
+        std::memcpy(&header, bytes + sizeof(magic), sizeof(header));
+        if (magic != ddspp::DDS_MAGIC || header.size != sizeof(header) ||
+            header.ddspf.size != sizeof(ddspp::PixelFormat) ||
+            !dimensions(header.width, header.height, std::max(header.mipMapCount, 1U))) return false;
+        const size_t headerBytes = baseSize + (ddspp::is_dxt10(header) ? sizeof(ddspp::HeaderDXT10) : 0);
+        if (count < headerBytes) return false;
+        std::array<uint32_t, ddspp::MAX_HEADER_SIZE / sizeof(uint32_t)> owned{};
+        std::memcpy(owned.data(), bytes, headerBytes);
+        if (ddspp::decode_header(reinterpret_cast<unsigned char *>(owned.data()), descriptor) != ddspp::Success)
+            return false;
+        if (descriptor.type != ddspp::Texture2D || descriptor.arraySize != 1 || descriptor.depth != 1 ||
+            !descriptor.bitsPerPixelOrBlock || !descriptor.blockWidth || !descriptor.blockHeight ||
+            !dimensions(descriptor.width, descriptor.height, descriptor.numMips)) return false;
+        return descriptor.headerSize == headerBytes;
+    }
+
+    inline bool ddsPayload(const ddspp::Descriptor &descriptor, uint64_t remaining) {
+        uint64_t total = 0;
+        for (uint32_t mip = 0; mip < descriptor.numMips; ++mip) {
+            const uint64_t width = std::max(descriptor.width >> mip, 1U);
+            const uint64_t height = std::max(descriptor.height >> mip, 1U);
+            const uint64_t rowBytes = ((width + descriptor.blockWidth - 1) / descriptor.blockWidth) *
+                (descriptor.bitsPerPixelOrBlock / 8U);
+            const uint64_t rows = (height + descriptor.blockHeight - 1) / descriptor.blockHeight;
+            const uint64_t bytesRequired = rowBytes * rows;
+
+            if (!rowBytes || bytesRequired > remaining || bytesRequired > UINT32_MAX - total) return false;
+            total += bytesRequired;
+            remaining -= bytesRequired;
+        }
+        return true;
+    }
+
+    inline bool dds(const uint8_t *bytes, size_t count, ddspp::Descriptor &descriptor) {
+        return ddsHeader(bytes, count, descriptor) &&
+            ddsPayload(descriptor, count - descriptor.headerSize);
+    }
+}
