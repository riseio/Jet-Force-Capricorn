diff --git a/src/common/rt64_runtime_health.cpp b/src/common/rt64_runtime_health.cpp
new file mode 100644
index 0000000..b78c428
--- /dev/null
+++ b/src/common/rt64_runtime_health.cpp
@@ -0,0 +1,150 @@
+#include "rt64_runtime_health.h"
+
+#include <algorithm>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <thread>
+
+namespace RT64 {
+    namespace {
+        constexpr std::array StageNames{
+            "display_list", "producer_slot", "workload", "frame_match", "render_frame",
+            "gpu_fence_wait", "shader_compile", "raster_pipeline", "present_batch", "frame_latency_wait",
+            "driver_present", "presented", "present_failed"
+        };
+        static_assert(StageNames.size() == size_t(HealthStage::Count));
+        std::array<HealthCounter, size_t(HealthStage::Count)> counters;
+        std::array<std::atomic<uint64_t>, size_t(HealthValue::Count)> values{};
+        std::atomic<bool> running{false};
+        std::mutex reporterMutex;
+        std::condition_variable reporterWake;
+
+        struct Reporter {
+            std::thread thread;
+            void stop() {
+                {
+                    std::lock_guard lock(reporterMutex);
+                    running.store(false, std::memory_order_release);
+                }
+                reporterWake.notify_all();
+                if (thread.joinable()) thread.join();
+            }
+            ~Reporter() { stop(); }
+        } reporter;
+
+        void reportLoop() {
+            using Clock = std::chrono::steady_clock;
+            std::array<HealthCounter::Snapshot, StageNames.size()> previous{};
+            auto started = Clock::now(), last = started;
+            std::array<Clock::time_point, StageNames.size()> previousTime;
+            previousTime.fill(started);
+
+            for (;;) {
+                {
+                    std::unique_lock lock(reporterMutex);
+                    reporterWake.wait_for(lock, std::chrono::seconds(2), [&] { return !running.load(std::memory_order_acquire); });
+                }
+                const bool final = !running.load(std::memory_order_acquire);
+                const auto now = Clock::now();
+                const double interval = std::chrono::duration<double>(now - last).count();
+                last = now;
+
+                std::array<char, 4096> line{};
+                int used = std::snprintf(line.data(), line.size(),
+                    "RT64_HEALTH elapsed_s=%.3f interval_s=%.3f final=%u target_hz=%llu display_hz=%llu output_width=%llu output_height=%llu shader_pending=%llu shader_ready=%llu",
+                    std::chrono::duration<double>(now - started).count(), interval, unsigned(final),
+                    static_cast<unsigned long long>(values[size_t(HealthValue::TargetHz)].load(std::memory_order_relaxed)),
+                    static_cast<unsigned long long>(values[size_t(HealthValue::DisplayHz)].load(std::memory_order_relaxed)),
+                    static_cast<unsigned long long>(values[size_t(HealthValue::OutputWidth)].load(std::memory_order_relaxed)),
+                    static_cast<unsigned long long>(values[size_t(HealthValue::OutputHeight)].load(std::memory_order_relaxed)),
+                    static_cast<unsigned long long>(values[size_t(HealthValue::ShaderPending)].load(std::memory_order_relaxed)),
+                    static_cast<unsigned long long>(values[size_t(HealthValue::ShaderReady)].load(std::memory_order_relaxed)));
+                for (size_t i = 0; i < counters.size(); ++i) {
+                    if (used < 0 || size_t(used) >= line.size()) break;
+                    HealthCounter::Snapshot current;
+                    const bool available = counters[i].snapshot(current);
+                    const uint64_t count = available ? current.count - previous[i].count : 0;
+                    const uint64_t us = available ? current.microseconds - previous[i].microseconds : 0;
+                    const double span = std::chrono::duration<double>(now - previousTime[i]).count();
+                    if (available) { previous[i] = current; previousTime[i] = now; }
+                    const int appended = std::snprintf(line.data() + used, line.size() - size_t(used),
+                        " %s_n=%llu %s_hz=%.2f %s_ms=%.3f %s_active=%u %s_available=%u", StageNames[i], static_cast<unsigned long long>(count),
+                        StageNames[i], span > 0 ? count / span : 0.0,
+                        StageNames[i], count ? double(us) / (1000.0 * count) : 0.0,
+                        StageNames[i], counters[i].inFlight.load(std::memory_order_relaxed),
+                        StageNames[i], unsigned(available));
+                    if (appended < 0) { used = -1; break; }
+                    used += appended;
+                }
+                if (used >= 0 && size_t(used) + 1 < line.size()) {
+                    line[size_t(used)] = '\n';
+                    ++used;
+                    if (std::fwrite(line.data(), 1, size_t(used), stderr) != size_t(used) || std::fflush(stderr) != 0) {
+                        std::fprintf(stderr, "RT64_HEALTH write_failed=1\n");
+                    }
+                }
+                else std::fprintf(stderr, "RT64_HEALTH format_failed=1\n");
+                if (final) break;
+            }
+        }
+    }
+
+    void HealthCounter::record(uint64_t elapsed) noexcept {
+        publishers.fetch_add(1, std::memory_order_acq_rel);
+        count.fetch_add(1, std::memory_order_relaxed);
+        microseconds.fetch_add(elapsed, std::memory_order_relaxed);
+        revision.fetch_add(1, std::memory_order_release);
+        publishers.fetch_sub(1, std::memory_order_release);
+    }
+
+    bool HealthCounter::snapshot(Snapshot &output) const noexcept {
+        for (unsigned attempt = 0; attempt < 3; ++attempt) {
+            const uint64_t before = revision.load(std::memory_order_acquire);
+            if (publishers.load(std::memory_order_acquire) != 0) continue;
+            const Snapshot sample{count.load(std::memory_order_relaxed), microseconds.load(std::memory_order_relaxed)};
+            std::atomic_thread_fence(std::memory_order_acq_rel);
+            if (publishers.load(std::memory_order_acquire) != 0) continue;
+            if (before == revision.load(std::memory_order_acquire)) { output = sample; return true; }
+        }
+        return false;
+    }
+
+    void RuntimeHealth::start() {
+
+        if (running.load(std::memory_order_acquire)) return;
+        const char *requested = std::getenv("RT64_RUNTIME_HEALTH");
+        if (!requested || std::strcmp(requested, "1") != 0) return;
+        for (auto &c : counters) { c.count = 0; c.microseconds = 0; c.revision = 0; c.publishers = 0; c.inFlight = 0; }
+        for (auto &v : values) v = 0;
+        running.store(true, std::memory_order_release);
+        try { reporter.thread = std::thread(reportLoop); }
+        catch (...) { running.store(false, std::memory_order_release); throw; }
+    }
+
+    void RuntimeHealth::stop() {
+        reporter.stop();
+    }
+
+    bool RuntimeHealth::enabled() noexcept { return running.load(std::memory_order_acquire); }
+    HealthCounter &RuntimeHealth::counter(HealthStage stage) noexcept { return counters[size_t(stage)]; }
+    void RuntimeHealth::event(HealthStage stage) noexcept { if (enabled()) counter(stage).record(0); }
+    void RuntimeHealth::value(HealthValue key, uint64_t value) noexcept { if (enabled()) values[size_t(key)].store(value, std::memory_order_relaxed); }
+    HealthScope::HealthScope(HealthStage stage) noexcept {
+        if (RuntimeHealth::enabled()) {
+            destination = &RuntimeHealth::counter(stage);
+            destination->inFlight.fetch_add(1, std::memory_order_relaxed);
+            begin = std::chrono::steady_clock::now();
+        }
+    }
+    void HealthScope::end() noexcept {
+        if (destination) {
+            const auto us = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - begin).count();
+            destination->record(uint64_t(std::max<int64_t>(us, 0)));
+            destination->inFlight.fetch_sub(1, std::memory_order_relaxed);
+            destination = nullptr;
+        }
+    }
+}
diff --git a/src/common/rt64_runtime_health.h b/src/common/rt64_runtime_health.h
new file mode 100644
index 0000000..3da7df1
--- /dev/null
+++ b/src/common/rt64_runtime_health.h
@@ -0,0 +1,45 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+namespace RT64 {
+    enum class HealthStage : uint8_t {
+        DisplayList, ProducerSlot, Workload, FrameMatch, RenderFrame,
+        GPUFence, ShaderCompile, RasterPipeline, PresentBatch, FrameLatency, DriverPresent,
+        Presented, PresentFailed, Count
+    };
+    enum class HealthValue : uint8_t { TargetHz, DisplayHz, OutputWidth, OutputHeight, ShaderPending, ShaderReady, Count };
+
+    struct alignas(64) HealthCounter {
+        static_assert(std::atomic<uint64_t>::is_always_lock_free);
+        struct Snapshot { uint64_t count = 0, microseconds = 0; };
+        std::atomic<uint64_t> count{0}, microseconds{0}, revision{0};
+        std::atomic<uint32_t> publishers{0};
+        std::atomic<uint32_t> inFlight{0};
+        void record(uint64_t microseconds) noexcept;
+        bool snapshot(Snapshot &output) const noexcept;
+    };
+
+    struct RuntimeHealth {
+        static void start();
+        static void stop();
+        static bool enabled() noexcept;
+        static void event(HealthStage stage) noexcept;
+        static void value(HealthValue key, uint64_t value) noexcept;
+        static HealthCounter &counter(HealthStage stage) noexcept;
+    };
+
+    class HealthScope {
+        HealthCounter *destination = nullptr;
+        std::chrono::steady_clock::time_point begin;
+    public:
+        explicit HealthScope(HealthStage stage) noexcept;
+        ~HealthScope() { end(); }
+        HealthScope(const HealthScope &) = delete;
+        HealthScope &operator=(const HealthScope &) = delete;
+        void end() noexcept;
+    };
+}
