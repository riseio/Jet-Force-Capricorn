+    void PerformanceProfiler::recordRuntimeVI(uint64_t wakeLatenessNanoseconds,
+        uint64_t skippedRetraces, bool wakeLatenessMeasured) {
+        static std::atomic<uint64_t> previous{0}, sequence{0};
+        static const bool declared = [wakeLatenessMeasured]() {
+            setMetadata("producer.runtime_vi.supported", "1");
+            setMetadata("producer.runtime_vi.enabled", mode() != PerformanceCaptureMode::Disabled ? "1" : "0");
+            setMetadata("runtime_vi_owner", "N64ModernRuntime host timer callback; guest consumption unobserved");
+            setMetadata("runtime_vi_wake_lateness_measured", wakeLatenessMeasured ? "1" : "0");
+            return true;
+        }();
+        (void)declared;
+        if (!captureEnabled()) { previous.store(0, std::memory_order_relaxed); return; }
+        const uint64_t now = nowNanoseconds();
+        const uint64_t before = previous.exchange(now, std::memory_order_acq_rel);
+        const uint64_t identity = sequence.fetch_add(1, std::memory_order_relaxed) + 1;
+        recordCriticalInstant(PerformanceCategory::Frame, "FrameProduction.RuntimeVI", identity,
+            skippedRetraces, wakeLatenessMeasured ? wakeLatenessNanoseconds : 0);
+        if (before && before < now && before >= state().resumeTimestamp.load(std::memory_order_acquire)) {
+            recordDuration(PerformanceCategory::Wait, "FrameProduction.RuntimeVIInterval", before, now, identity);
+        }
+        if (wakeLatenessMeasured && wakeLatenessNanoseconds && wakeLatenessNanoseconds <= now) {
+            recordDuration(PerformanceCategory::Wait, "FrameProduction.RuntimeVIWakeDeadlineMiss",
+                now - wakeLatenessNanoseconds, now, identity, skippedRetraces);
+        }
+    }
