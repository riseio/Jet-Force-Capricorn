diff --git a/src/hle/rt64_framebuffer_cache_keys.h b/src/hle/rt64_framebuffer_cache_keys.h
new file mode 100644
index 0000000..d2c2417
--- /dev/null
+++ b/src/hle/rt64_framebuffer_cache_keys.h
@@ -0,0 +1,114 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace RT64 {
+    inline constexpr uint64_t framebufferCacheHashCombine(
+        uint64_t hash, uint64_t value) {
+        return hash ^ (value + 0x9E3779B97F4A7C15ULL +
+            (hash << 6U) + (hash >> 2U));
+    }
+
+    struct FramebufferTile {
+        uint32_t address;
+        uint8_t siz;
+        uint8_t fmt;
+        uint32_t left;
+        uint32_t top;
+        uint32_t right;
+        uint32_t bottom;
+        uint32_t lineWidth;
+        uint32_t ditherPattern;
+
+        bool valid() const {
+            return (bottom > top) && (right > left);
+        }
+
+        uint64_t hash() const {
+            uint64_t result = 0x6A09E667F3BCC909ULL;
+            result = framebufferCacheHashCombine(result, address);
+            result = framebufferCacheHashCombine(result, siz);
+            result = framebufferCacheHashCombine(result, fmt);
+            result = framebufferCacheHashCombine(result, left);
+            result = framebufferCacheHashCombine(result, top);
+            result = framebufferCacheHashCombine(result, right);
+            result = framebufferCacheHashCombine(result, bottom);
+            result = framebufferCacheHashCombine(result, lineWidth);
+            return framebufferCacheHashCombine(result, ditherPattern);
+        }
+
+        bool operator==(const FramebufferTile &other) const {
+            return (address == other.address) &&
+                (siz == other.siz) &&
+                (fmt == other.fmt) &&
+                (left == other.left) &&
+                (top == other.top) &&
+                (right == other.right) &&
+                (bottom == other.bottom) &&
+                (lineWidth == other.lineWidth) &&
+                (ditherPattern == other.ditherPattern);
+        }
+    };
+
+    struct FramebufferTileHash {
+        size_t operator()(const FramebufferTile &tile) const {
+            return static_cast<size_t>(tile.hash());
+        }
+    };
+
+    struct ReinterpretTileKey {
+        uint64_t tmemHashOrID = 0;
+        uint64_t tlutHash = 0;
+        uint8_t srcSiz = 0;
+        uint8_t srcFmt = 0;
+        uint8_t dstSiz = 0;
+        uint8_t dstFmt = 0;
+        bool ulScaleS = true;
+        bool ulScaleT = true;
+        uint32_t texelShiftX = 0;
+        uint32_t texelShiftY = 0;
+        uint32_t texelMaskX = UINT32_MAX;
+        uint32_t texelMaskY = UINT32_MAX;
+        uint32_t tlutFormat = 0;
+
+        uint64_t hash() const {
+            uint64_t result = 0xBB67AE8584CAA73BULL;
+            result = framebufferCacheHashCombine(result, tmemHashOrID);
+            result = framebufferCacheHashCombine(result, tlutHash);
+            result = framebufferCacheHashCombine(result, srcSiz);
+            result = framebufferCacheHashCombine(result, srcFmt);
+            result = framebufferCacheHashCombine(result, dstSiz);
+            result = framebufferCacheHashCombine(result, dstFmt);
+            result = framebufferCacheHashCombine(result, ulScaleS);
+            result = framebufferCacheHashCombine(result, ulScaleT);
+            result = framebufferCacheHashCombine(result, texelShiftX);
+            result = framebufferCacheHashCombine(result, texelShiftY);
+            result = framebufferCacheHashCombine(result, texelMaskX);
+            result = framebufferCacheHashCombine(result, texelMaskY);
+            return framebufferCacheHashCombine(result, tlutFormat);
+        }
+
+        bool operator==(const ReinterpretTileKey &other) const {
+            return (tmemHashOrID == other.tmemHashOrID) &&
+                (tlutHash == other.tlutHash) &&
+                (srcSiz == other.srcSiz) &&
+                (srcFmt == other.srcFmt) &&
+                (dstSiz == other.dstSiz) &&
+                (dstFmt == other.dstFmt) &&
+                (ulScaleS == other.ulScaleS) &&
+                (ulScaleT == other.ulScaleT) &&
+                (texelShiftX == other.texelShiftX) &&
+                (texelShiftY == other.texelShiftY) &&
+                (texelMaskX == other.texelMaskX) &&
+                (texelMaskY == other.texelMaskY) &&
+                (tlutFormat == other.tlutFormat);
+        }
+    };
+
+    struct ReinterpretTileKeyHash {
+        size_t operator()(const ReinterpretTileKey &key) const {
+            return static_cast<size_t>(key.hash());
+        }
+    };
+}
