diff --git a/src/hle/rt64_triangle_bounds.h b/src/hle/rt64_triangle_bounds.h
new file mode 100644
index 0000000..0b1ac7c
--- /dev/null
+++ b/src/hle/rt64_triangle_bounds.h
@@ -0,0 +1,83 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <stdexcept>
+#include "common/rt64_common.h"
+#include "shared/rt64_rsp_viewport.h"
+
+namespace RT64 {
+
+    inline FixedRect nativeTriangleBounds(const hlslpp::float4 (&triangle)[3],
+        const interop::RSPViewport &viewport, const FixedRect &clip, bool cull,
+        const hlslpp::float2 *screenOverrides = nullptr, uint8_t overrideMask = 0) {
+        if (clip.isNull()) return {};
+        using Point = std::array<double, 4>;
+        std::array<Point, 3> source;
+        for (unsigned i = 0; i < 3; ++i)
+            for (unsigned axis = 0; axis < 4; ++axis) {
+                source[i][axis] = double(triangle[i][axis]);
+                if (!std::isfinite(source[i][axis]))
+                    throw std::runtime_error("Non-finite native triangle position");
+            }
+        if (overrideMask != 0) {
+            if (screenOverrides == nullptr)
+                throw std::runtime_error("Missing native screen overrides");
+
+            for (unsigned i = 0; i < 3; ++i) {
+                if (overrideMask & (1U << i)) {
+                    if (!std::isfinite(double(screenOverrides[i].x)) ||
+                        !std::isfinite(double(screenOverrides[i].y)))
+                        throw std::runtime_error("Non-finite native screen override");
+                    source[i][0] = double(screenOverrides[i].x) * source[i][3];
+                    source[i][1] = double(screenOverrides[i].y) * source[i][3];
+                } else {
+                    source[i][0] = source[i][0] * double(viewport.scale.x) + double(viewport.translate.x) * source[i][3];
+                    source[i][1] = -source[i][1] * double(viewport.scale.y) + double(viewport.translate.y) * source[i][3];
+                }
+            }
+        }
+        constexpr double minimumW = 1e-6;
+        std::array<Point, 4> clipped;
+        unsigned count = 0;
+        for (unsigned i = 0; i < 3; ++i) {
+            const Point &a = source[i], &b = source[(i + 1) % 3];
+            const bool aInside = a[3] >= minimumW, bInside = b[3] >= minimumW;
+            if (aInside) clipped[count++] = a;
+            if (aInside != bInside) {
+                const double weight = (minimumW - a[3]) / (b[3] - a[3]);
+                Point point;
+                for (unsigned axis = 0; axis < 3; ++axis)
+                    point[axis] = a[axis] + (b[axis] - a[axis]) * weight;
+                point[3] = minimumW;
+                clipped[count++] = point;
+            }
+        }
+        if (count < 3) return {};
+        double minimumX = INFINITY, minimumY = INFINITY;
+        double maximumX = -INFINITY, maximumY = -INFINITY;
+        std::array<std::array<double, 2>, 4> screen;
+        for (unsigned i = 0; i < count; ++i) {
+            screen[i][0] = overrideMask ? clipped[i][0] / clipped[i][3] :
+                clipped[i][0] / clipped[i][3] * double(viewport.scale.x) + double(viewport.translate.x);
+            screen[i][1] = overrideMask ? clipped[i][1] / clipped[i][3] :
+                -clipped[i][1] / clipped[i][3] * double(viewport.scale.y) + double(viewport.translate.y);
+            minimumX = std::min(minimumX, screen[i][0]);
+            minimumY = std::min(minimumY, screen[i][1]);
+            maximumX = std::max(maximumX, screen[i][0]);
+            maximumY = std::max(maximumY, screen[i][1]);
+        }
+        if (cull) {
+            const double ux = screen[1][0] - screen[0][0], uy = screen[1][1] - screen[0][1];
+            const double vx = screen[2][0] - screen[0][0], vy = screen[2][1] - screen[0][1];
+            if (vx * uy - vy * ux < 0.0) return {};
+        }
+        const double left = std::max(std::floor(minimumX * 4.0), double(clip.ulx));
+        const double top = std::max(std::floor(minimumY * 4.0), double(clip.uly));
+        const double right = std::min(std::ceil(maximumX) * 4.0, double(clip.lrx));
+        const double bottom = std::min(std::ceil(maximumY) * 4.0, double(clip.lry));
+        if (left >= right || top >= bottom) return {};
+        return {int32_t(left), int32_t(top), int32_t(right), int32_t(bottom)};
+    }
+}
