+    bool readCaptureInteger(const char *name, uint64_t defaultValue,
+                            uint64_t minimum, uint64_t maximum,
+                            uint64_t &result) {
+        const char *text = std::getenv(name);
+        if ((text == nullptr) || (text[0] == '\0')) {
+            result = defaultValue;
+            return true;
+        }
+
+        const char *end = text + std::strlen(text);
+        uint64_t parsed = 0;
+        const auto conversion = std::from_chars(text, end, parsed);
+        if ((conversion.ec != std::errc()) || (conversion.ptr != end) ||
+            (parsed < minimum) || (parsed > maximum)) {
+            std::fprintf(stderr,
+                "%s must be an integer in [%" PRIu64 ", %" PRIu64 "]\n",
+                name, minimum, maximum);
+            return false;
+        }
+
+        result = parsed;
+        return true;
+    }
+
+    uint64_t diagnosticElapsedMicroseconds(
+        const RT64::Timestamp start,
+        const RT64::Timestamp end) {
+        return static_cast<uint64_t>(std::max<int64_t>(
+            RT64::Timer::deltaMicroseconds(start, end), 0));
+    }
+
+    uint64_t diagnosticTimestampNanoseconds(
+        const RT64::Timestamp timestamp) {
+        return static_cast<uint64_t>(std::max<int64_t>(
+            std::chrono::duration_cast<std::chrono::nanoseconds>(
+                timestamp.time_since_epoch()).count(),
+            0));
+    }
+
+    void writeLittleEndian16(std::array<uint8_t, 54> &header,
+                             size_t offset, uint16_t value) {
+        header[offset] = static_cast<uint8_t>(value);
+        header[offset + 1] = static_cast<uint8_t>(value >> 8);
+    }
+
+    void writeLittleEndian32(std::array<uint8_t, 54> &header,
+                             size_t offset, uint32_t value) {
+        for (size_t byte = 0; byte < sizeof(value); byte++) {
+            header[offset + byte] = static_cast<uint8_t>(value >> (byte * 8));
+        }
+    }
+}
