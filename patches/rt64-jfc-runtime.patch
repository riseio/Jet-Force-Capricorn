diff --git a/src/shared/rt64_texture_atlas.h b/src/shared/rt64_texture_atlas.h
new file mode 100644
index 0000000..7deddbe
--- /dev/null
+++ b/src/shared/rt64_texture_atlas.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#ifdef HLSL_CPU
+#include <algorithm>
+#include <cmath>
+#endif
+
+namespace TextureAtlas {
+#ifdef HLSL_CPU
+    using uint = unsigned;
+    using std::min;
+    using std::max;
+    using std::floor;
+#endif
+
+    inline uint maximumMip(uint cellPixels, uint imagePixels, uint levels) {
+        uint level = 0;
+        while (level + 1 < levels && level < 15 &&
+                cellPixels > 1 && imagePixels > 1 &&
+                (cellPixels & 1) == 0 && (imagePixels & 1) == 0) {
+            cellPixels >>= 1;
+            imagePixels >>= 1;
+            ++level;
+        }
+        return level;
+    }
+
+    inline float cellStart(float nativeU, float cellWidth, float imageWidth) {
+        return floor(max(0.0f, min(nativeU, imageWidth - 0.001f)) / cellWidth) * cellWidth;
+    }
+
+    inline float primitiveCellStart(float nativeU, float edgeA, float edgeB,
+                                   float cellWidth, float imageWidth) {
+        const float low = min(edgeA, edgeB), high = max(edgeA, edgeB);
+        const float start = cellStart((low + high) * 0.5f, cellWidth, imageWidth);
+        return low < high && low >= start && high <= min(start + cellWidth, imageWidth)
+            ? start : cellStart(nativeU, cellWidth, imageWidth);
+    }
+
+    inline float sampleU(float pixelU, float start, float width, float imageWidth, uint level) {
+        const float scale = float(1U << level);
+        const float low = start / scale + 0.5f;
+        const float high = min(start + width, imageWidth) / scale - 0.5f;
+        return max(low, min(pixelU / scale, high));
+    }
+}
diff --git a/src/shared/rt64_texture_footprint.h b/src/shared/rt64_texture_footprint.h
new file mode 100644
