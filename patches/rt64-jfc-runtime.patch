diff --git a/src/render/rt64_cpu_framebuffer_renderer.cpp b/src/render/rt64_cpu_framebuffer_renderer.cpp
new file mode 100644
index 0000000..0a6265d
--- /dev/null
+++ b/src/render/rt64_cpu_framebuffer_renderer.cpp
@@ -0,0 +1,143 @@
+#include "rt64_cpu_framebuffer_renderer.h"
+#include "rt64_shader_library.h"
+#include "common/rt64_performance_profiler.h"
+#include "include/rt64_cpu_framebuffer_effects.h"
+
+#include <cmath>
+#include <cstring>
+#include <stdexcept>
+
+namespace RT64 {
+    bool CpuFramebufferRenderer::prepare(RenderDevice *device, const RenderTarget &target,
+        const std::vector<uint32_t> &words, uint64_t presentId) {
+        PerformanceScope prepareScope(PerformanceCategory::CPU, "Present.CpuEffects.Prepare", presentId);
+        if (!target.width || !target.height || target.width > INT32_MAX || target.height > INT32_MAX ||
+            target.format == RenderFormat::UNKNOWN || presentId == UINT64_MAX)
+            throw std::invalid_argument("Invalid CPU framebuffer replay target");
+        const uint64_t bytes = uint64_t(words.size()) * sizeof(uint32_t);
+        if (preparedPresent != presentId) {
+            PerformanceScope scope(PerformanceCategory::CPU, "Present.CpuEffects.Validate", presentId, bytes);
+            CpuFramebufferEffects::validateReplay(words.data(), words.size());
+        }
+        if (bytes == 0) throw std::invalid_argument("Empty CPU framebuffer operation upload");
+        bool storageChanged = false;
+        if (bytes > capacity) {
+            PerformanceScope scope(PerformanceCategory::CPU, "Present.CpuEffects.AllocateBuffers", presentId, bytes, capacity);
+            const uint64_t nextCapacity = CpuFramebufferEffects::replayBufferCapacity(bytes);
+            auto nextUpload = device->createBuffer(RenderBufferDesc::UploadBuffer(nextCapacity));
+            auto nextOperations = device->createBuffer(RenderBufferDesc::DefaultBuffer(nextCapacity, RenderBufferFlag::STORAGE));
+            if (!nextUpload || !nextOperations)
+                throw std::runtime_error("Cannot allocate CPU framebuffer replay buffers");
+
+            upload = std::move(nextUpload);
+            operations = std::move(nextOperations);
+            capacity = nextCapacity;
+            preparedPresent = UINT64_MAX;
+            uploadedPresent = UINT64_MAX;
+            storageChanged = true;
+        }
+        if (!descriptors) {
+            PerformanceScope scope(PerformanceCategory::CPU, "Present.CpuEffects.AllocateDescriptors", presentId);
+            descriptors = std::make_unique<CpuFramebufferEffectDescriptorSet>(device);
+        }
+        if (preparedPresent != presentId) {
+            PerformanceScope scope(PerformanceCategory::CPU, "Present.CpuEffects.Upload", presentId, bytes);
+            void *mapped = upload->map();
+            if (!mapped) throw std::runtime_error("Cannot map CPU framebuffer operation upload");
+            std::memcpy(mapped, words.data(), size_t(bytes));
+            upload->unmap();
+        }
+        else if (bytes != preparedBytes) {
+            throw std::invalid_argument("CPU framebuffer replay changed within a Present");
+        }
+        if (target.width > width || target.height > height || format != target.format) {
+            PerformanceScope scope(PerformanceCategory::CPU, "Present.CpuEffects.AllocateBackground", presentId, target.width, target.height);
+            const uint32_t nextWidth = format == target.format ? std::max(width, target.width) : target.width;
+            const uint32_t nextHeight = format == target.format ? std::max(height, target.height) : target.height;
+            auto nextBackground = device->createTexture(RenderTextureDesc::Texture2D(nextWidth, nextHeight, 1, target.format));
+            if (!nextBackground) throw std::runtime_error("Cannot allocate CPU framebuffer replay background");
+            background = std::move(nextBackground);
+            width = nextWidth;
+            height = nextHeight;
+            format = target.format;
+            storageChanged = true;
+        }
+        descriptors->setTexture(descriptors->background, background.get(), RenderTextureLayout::SHADER_READ);
+        descriptors->setBuffer(descriptors->operations, operations.get(), RenderBufferStructuredView(sizeof(uint32_t)));
+        preparedWidth = target.width;
+        preparedHeight = target.height;
+        preparedPresent = presentId;
+        preparedBytes = bytes;
+        capturedWidth = capturedHeight = 0;
+        return storageChanged;
+    }
+
+    void CpuFramebufferRenderer::capture(RenderWorker *worker, RenderTarget &target,
+        uint64_t presentId, const ShaderLibrary *shaders) {
+        PerformanceScope captureScope(PerformanceCategory::CPU, "Present.CpuEffects.Capture", presentId);
+        if (preparedPresent != presentId || preparedWidth != target.width || preparedHeight != target.height ||
+            format != target.format || !background)
+            throw std::logic_error("CPU framebuffer replay was not prepared for this target");
+        if (uploadedPresent != presentId) {
+            worker->commandList->barriers(RenderBarrierStage::COPY, RenderBufferBarrier(operations.get(), RenderBufferAccess::WRITE));
+            worker->commandList->copyBufferRegion(operations.get(), upload.get(), preparedBytes);
+            worker->commandList->barriers(RenderBarrierStage::GRAPHICS, RenderBufferBarrier(operations.get(), RenderBufferAccess::READ));
+            uploadedPresent = presentId;
+        }
+        PerformanceScope backgroundScope(PerformanceCategory::CPU, "Present.CpuEffects.CopyBackground", presentId);
+        target.resolveTarget(worker, shaders);
+        RenderTextureBarrier barriers[] = {
+            RenderTextureBarrier(target.getResolvedTexture(), RenderTextureLayout::COPY_SOURCE),
+            RenderTextureBarrier(background.get(), RenderTextureLayout::COPY_DEST)
+        };
+        worker->commandList->barriers(RenderBarrierStage::COPY, barriers, 2);
+        const RenderBox validImage(0, 0, int32_t(target.width), int32_t(target.height));
+        worker->commandList->copyTextureRegion(RenderTextureCopyLocation::Subresource(background.get()),
+            RenderTextureCopyLocation::Subresource(target.getResolvedTexture()), 0, 0, 0, &validImage);
+        worker->commandList->barriers(RenderBarrierStage::GRAPHICS,
+            RenderTextureBarrier(background.get(), RenderTextureLayout::SHADER_READ));
+        capturedWidth = target.width;
+        capturedHeight = target.height;
+    }
+
+    void CpuFramebufferRenderer::draw(RenderWorker *worker, RenderTarget &target,
+        uint32_t nativeWidth, uint32_t nativeHeight, const ShaderLibrary *shaders) {
+        if (!capturedWidth || !capturedHeight || capturedWidth != target.width || capturedHeight != target.height ||
+            format != target.format || !nativeWidth || !nativeHeight)
+            throw std::logic_error("CPU framebuffer replay has no matching captured image");
+        const ShaderRecord &shader = shaders->cpuFramebufferEffects;
