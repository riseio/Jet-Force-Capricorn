diff --git a/src/hle/rt64_game_frame_history.h b/src/hle/rt64_game_frame_history.h
new file mode 100644
index 0000000..5597748
--- /dev/null
+++ b/src/hle/rt64_game_frame_history.h
@@ -0,0 +1,47 @@
+#pragma once
+
+#include <cstdint>
+
+namespace RT64 {
+    constexpr uint32_t retainedWorkloadIndex(
+        uint32_t queueSize,
+        uint32_t frameIndex) {
+        return queueSize + frameIndex;
+    }
+
+    struct GameFrameHistorySelection {
+        uint32_t currentIndex = 0;
+        uint32_t previousIndex = 0;
+        bool scratch = false;
+    };
+
+    struct GameFrameHistoryCursor {
+        static constexpr uint32_t FrameCount = 2;
+
+        uint32_t previousIndex = FrameCount - 1;
+        uint32_t currentIndex = 0;
+
+        void reset() {
+            previousIndex = FrameCount - 1;
+            currentIndex = 0;
+        }
+
+        GameFrameHistorySelection select(
+            bool requiresFrameMatching,
+            bool paused,
+            bool sameCurrentWorkload
+        ) {
+
+            if (!requiresFrameMatching) {
+                return { 0, 0, true };
+            }
+
+            if (!paused || !sameCurrentWorkload) {
+                previousIndex = currentIndex;
+                currentIndex = (currentIndex + 1) % FrameCount;
+            }
+
+            return { currentIndex, previousIndex, false };
+        }
+    };
+}
diff --git a/src/hle/rt64_game_frame_interpolation.h b/src/hle/rt64_game_frame_interpolation.h
new file mode 100644
index 0000000..5951389
--- /dev/null
+++ b/src/hle/rt64_game_frame_interpolation.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+
+namespace RT64 {
+    inline constexpr bool interpolationVertexSpanValid(
+        size_t valueCount, uint32_t vertexIndex, uint32_t vertexCount,
+        uint32_t componentCount) {
+        if ((componentCount == 0U) || (vertexCount == 0U)) {
+            return false;
+        }
+        const size_t availableVertices = valueCount / componentCount;
+        return (vertexIndex <= availableVertices) &&
+            (vertexCount <= (availableVertices - vertexIndex));
+    }
+
+    inline float wrapInterpolationDelta(float delta, float modulus) {
+        if (!std::isfinite(delta) || !std::isfinite(modulus) ||
+            !(modulus > 0.0f)) {
+            return delta;
+        }
+        if (std::fabs(delta) > (modulus * 0.5f)) {
+            delta -= std::round(delta / modulus) * modulus;
+        }
+        return delta;
+    }
+}
diff --git a/src/hle/rt64_idle_maintenance.h b/src/hle/rt64_idle_maintenance.h
