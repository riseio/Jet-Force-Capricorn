+            float scale[2];
+            float offset[2];
+            uint32_t usesHDR, padding;
+            uint32_t backgroundExtent[2];
+        } constants{{nativeWidth, nativeHeight}, {scale, scale}, {
+            (nativeWidth * float(target.resolutionScale.x) - nativeWidth * scale) * 0.5f,
+            (nativeHeight * float(target.resolutionScale.y) - nativeHeight * scale) * 0.5f}, uint32_t(target.usesHDR), 0,
+            {capturedWidth, capturedHeight}};
+        static_assert(sizeof(Constants) == 40);
+        const float right = constants.offset[0] + nativeWidth * scale;
+        const float bottom = constants.offset[1] + nativeHeight * scale;
+        target.setupColorFramebuffer(worker);
+        worker->commandList->barriers(RenderBarrierStage::GRAPHICS,
+            RenderTextureBarrier(target.texture.get(), RenderTextureLayout::COLOR_WRITE));
