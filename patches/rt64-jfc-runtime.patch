+    bool PresentQueue::prepareDiagnosticCapture() {
+        if (!ext.swapChain->supportsTextureCopySource()) {
+            std::fprintf(stderr,
+                "RT64_CAPTURE is unavailable because this swap chain does "
+                "not support texture readback\n");
+            diagnosticCapture.attemptedCount =
+                diagnosticCapture.requestedCount;
+            return false;
+        }
+
+        const uint32_t width = ext.swapChain->getWidth();
+        const uint32_t height = ext.swapChain->getHeight();
+        constexpr uint32_t maximumDimension = 16'384;
+        constexpr uint32_t bytesPerPixel = 4;
+        constexpr uint32_t rowPitchAlignment = 256;
+        if ((width == 0) || (height == 0) || (width > maximumDimension) ||
+            (height > maximumDimension)) {
+            std::fprintf(stderr,
+                "RT64_CAPTURE rejected invalid swap-chain size %ux%u\n",
+                width, height);
+            diagnosticCapture.attemptedCount =
+                diagnosticCapture.requestedCount;
+            return false;
+        }
+
+        const uint64_t unalignedRowPitch =
+            static_cast<uint64_t>(width) * bytesPerPixel;
+        const uint64_t rowPitch = (unalignedRowPitch + rowPitchAlignment - 1) &
+            ~(static_cast<uint64_t>(rowPitchAlignment) - 1);
+        const uint64_t bufferSize = rowPitch * height;
+        if ((rowPitch > std::numeric_limits<uint32_t>::max()) ||
+            (bufferSize > std::numeric_limits<uint32_t>::max())) {
+
+            diagnosticCapture.attemptedCount =
+                diagnosticCapture.requestedCount;
+            return false;
+        }
+
+        if ((diagnosticCapture.readbackBuffer == nullptr) ||
+            (diagnosticCapture.width != width) ||
+            (diagnosticCapture.height != height)) {
+            diagnosticCapture.readbackBuffer = ext.device->createBuffer(
+                RenderBufferDesc::ReadbackBuffer(bufferSize));
+            diagnosticCapture.width = width;
+            diagnosticCapture.height = height;
+            diagnosticCapture.rowPitch = static_cast<uint32_t>(rowPitch);
+        }
+        if (diagnosticCapture.readbackBuffer == nullptr) {
+            std::fprintf(stderr,
+                "RT64_CAPTURE failed to allocate the readback buffer\n");
+            diagnosticCapture.attemptedCount =
+                diagnosticCapture.requestedCount;
+            return false;
+        }
+        return true;
+    }
