diff --git a/src/render/rt64_geometry_depth_profiler.cpp b/src/render/rt64_geometry_depth_profiler.cpp
new file mode 100644
index 0000000..9be1603
--- /dev/null
+++ b/src/render/rt64_geometry_depth_profiler.cpp
@@ -0,0 +1,181 @@
+#include "rt64_geometry_profiler.h"
+#include "rt64_render_target.h"
+#include "rt64_shader_library.h"
+#include "common/rt64_performance_profiler.h"
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <mutex>
+#include <thread>
+#include <condition_variable>
+
+namespace RT64 {
+GeometryDepthStorage::~GeometryDepthStorage() {
+    if (mapped && readback) readback->unmap();
+}
+
+struct GeometryDepthPool::Impl {
+    RenderDevice *device;
+    std::mutex mutex;
+    std::condition_variable ready;
+    std::array<std::shared_ptr<GeometryDepthStorage>, 8> slots{};
+    std::array<uint64_t, 8> requests{};
+    bool stopping = false;
+    std::thread worker;
+    explicit Impl(RenderDevice *value) : device(value), worker([this] { run(); }) {}
+    void run() {
+        PerformanceProfiler::setThreadName("Geometry Resources");
+        for (;;) {
+            size_t index = slots.size();
+            uint64_t bytes = 0;
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                ready.wait(lock, [&] {
+                    return stopping || std::any_of(requests.begin(), requests.end(), [](uint64_t n) { return n != 0; });
+                });
+                if (stopping) return;
+                for (size_t i = 0; i < requests.size(); ++i) if (requests[i]) { index = i; bytes = requests[i]; break; }
+            }
+            std::shared_ptr<GeometryDepthStorage> storage;
+            try {
+                PerformanceScope measure(PerformanceCategory::CPU, "Profiler.GeometryResourcePreparation");
+                storage = std::make_shared<GeometryDepthStorage>();
+                storage->bytes = bytes;
+                storage->gpu = device->createBuffer(RenderBufferDesc::DefaultBuffer(bytes,
+                    RenderBufferFlag::STORAGE | RenderBufferFlag::UNORDERED_ACCESS));
+                storage->readback = device->createBuffer(RenderBufferDesc::ReadbackBuffer(bytes));
+                storage->descriptors = std::make_unique<GeometryDepthDescriptorSet>(device);
+                if (!storage->gpu || !storage->readback) storage.reset();
+            }
+            catch (const std::exception &) { storage.reset(); }
+            if (!storage) PerformanceProfiler::recordCriticalInstant(PerformanceCategory::Counter,
+                "Profiler.GeometryResourceAllocationFailed", 0, bytes);
+            {
+                std::lock_guard<std::mutex> lock(mutex);
+                slots[index] = std::move(storage);
+                requests[index] = 0;
+            }
+        }
+    }
+    ~Impl() {
+        { std::lock_guard<std::mutex> lock(mutex); stopping = true; }
+        ready.notify_all();
+        worker.join();
+
+        PerformanceProfiler::drainAttachments();
+    }
+};
+
+GeometryDepthPool::GeometryDepthPool(RenderDevice *device) : impl(std::make_unique<Impl>(device)) {}
+GeometryDepthPool::~GeometryDepthPool() = default;
+std::shared_ptr<GeometryDepthStorage> GeometryDepthPool::acquire(uint64_t bytes) {
+    if (!bytes || bytes > 4194304ULL * 2 * sizeof(float)) return {};
+    std::unique_lock<std::mutex> lock(impl->mutex, std::try_to_lock);
+    if (!lock || impl->stopping) return {};
+    for (size_t i = 0; i < impl->slots.size(); ++i) {
+        auto &slot = impl->slots[i];
+        if (!impl->requests[i] && slot && slot->bytes == bytes && slot.use_count() == 1) {
+            if (slot->mapped) { slot->readback->unmap(); slot->mapped = false; }
+            return slot;
+        }
+    }
+
+    if (std::find(impl->requests.begin(), impl->requests.end(), bytes) != impl->requests.end()) return {};
+    for (size_t i = 0; i < impl->slots.size(); ++i) {
+        if (!impl->requests[i] && (!impl->slots[i] || impl->slots[i].use_count() == 1)) {
+            impl->requests[i] = bytes;
+            impl->ready.notify_one();
+            break;
+        }
+    }
+    return {};
+}
+
+namespace {
+uint64_t packed(uint32_t a, uint32_t b) { return (uint64_t(a) << 32) | b; }
+void event(GeometryReadback &capture, const char *name, uint32_t index, uint64_t value) {
+    if (std::strcmp(name, "Geometry.InvalidDepth") == 0) capture.succeeded = false;
+    PerformanceProfiler::recordAttachmentInstant(capture.group.id(), name,
+        capture.workloadId, packed(uint32_t(capture.output), index), value);
+}
+}
+
+bool geometryCoverageEnabled() {
+    static const bool enabled = [] {
+        const char *value = std::getenv("RT64_PROFILE_GEOMETRY_COVERAGE");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+void recordGeometryDepth(RenderWorker *worker, RenderTarget &target,
+        const ShaderLibrary &shaders, uint32_t framebuffer, GeometryReadback &capture,
+        RenderTextureLayout restoreLayout, GeometryDepthPool &pool) {
+    if (!geometryCoverageEnabled()) { return; }
+    PerformanceScope measure(PerformanceCategory::CPU, "Geometry.DepthRecord", capture.workloadId);
+    const uint64_t pixels = uint64_t(target.width) * target.height;
+    const auto &shader = target.multisampling.sampleCount > 1 ? shaders.geometryDepthMS : shaders.geometryDepth;
+    if (pixels == 0 || pixels > 4194304 || capture.depth.size() >= 8 || !shader.pipeline) {
+        event(capture, "Geometry.InvalidDepth", framebuffer, 1);
+        return;
+    }
+    GeometryDepthReadback item;
+    item.framebuffer = framebuffer;
+    item.width = target.width; item.height = target.height;
+    item.samples = uint32_t(target.multisampling.sampleCount);
+    const uint64_t bytes = pixels * 2 * sizeof(float);
+    item.storage = pool.acquire(bytes);
+    if (!item.storage) { event(capture, "Geometry.InvalidDepth", framebuffer, 4); return; }
+    auto &storage = *item.storage;
+    storage.descriptors->setTexture(storage.descriptors->source, target.texture.get(),
+        RenderTextureLayout::SHADER_READ, target.textureView.get());
+    storage.descriptors->setBuffer(storage.descriptors->destination, storage.gpu.get(), RenderBufferStructuredView(2 * sizeof(float)));
+    worker->commandList->barriers(RenderBarrierStage::COMPUTE,
+        RenderTextureBarrier(target.texture.get(), RenderTextureLayout::SHADER_READ));
+    worker->commandList->barriers(RenderBarrierStage::COMPUTE, RenderBufferBarrier(storage.gpu.get(), RenderBufferAccess::WRITE));
+    const uint32_t constants[] = {item.width, item.height, item.samples};
+    worker->commandList->setPipeline(shader.pipeline.get());
+    worker->commandList->setComputePipelineLayout(shader.pipelineLayout.get());
+    worker->commandList->setComputeDescriptorSet(storage.descriptors->get(), 0);
+    worker->commandList->setComputePushConstants(0, constants);
+    worker->commandList->dispatch((item.width + 7) / 8, (item.height + 7) / 8, 1);
+    const RenderBufferBarrier copies[] = {
+        RenderBufferBarrier(storage.gpu.get(), RenderBufferAccess::READ),
+        RenderBufferBarrier(storage.readback.get(), RenderBufferAccess::WRITE)};
+    worker->commandList->barriers(RenderBarrierStage::COPY, copies, 2);
+    worker->commandList->copyBufferRegion(storage.readback.get(), storage.gpu.get(), bytes);
+    worker->commandList->barriers(RenderBarrierStage::GRAPHICS,
+        RenderTextureBarrier(target.texture.get(), restoreLayout));
+    capture.depth.emplace_back(std::move(item));
+}
+
+void finishGeometryDepth(GeometryReadback &capture) {
+    const char *output = std::getenv("RT64_PROFILE_OUTPUT");
+    for (auto &item : capture.depth) {
+        const size_t bytes = size_t(item.width) * item.height * 2 * sizeof(float);
+        const RenderRange range{0, bytes};
+        const auto *data = static_cast<const uint8_t *>(item.storage->readback->map(0, &range));
+        item.storage->mapped = data != nullptr;
+        bool queued = false;
+        if (output && data) {
+            PerformanceScope measure(PerformanceCategory::CPU, "Geometry.DepthQueue", capture.workloadId);
+            const std::string suffix = ".depth-" + std::to_string(capture.workloadId) + "-" +
+                std::to_string(capture.output) + "-" + std::to_string(item.framebuffer) + ".f32";
+            try {
+
+                std::shared_ptr<const uint8_t> owned(item.storage, data);
+                queued = PerformanceProfiler::writeSharedAttachment(suffix, std::move(owned), bytes, bytes * 2,
+                    PerformanceAttachmentChecksum::Adler32HighWord,
+                    "Geometry.DepthContent", capture.workloadId,
+                    packed(uint32_t(capture.output), item.framebuffer), item.samples, "Geometry.InvalidDepth", capture.group.id());
+            }
+            catch (const std::bad_alloc &) { queued = false; }
+        }
+        if (!queued) { event(capture, "Geometry.InvalidDepth", item.framebuffer, 3); continue; }
+        event(capture, "Geometry.DepthShape", item.framebuffer, packed(item.width, item.height));
+    }
+    capture.depth.clear();
+}
+}
