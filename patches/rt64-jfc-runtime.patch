diff --git a/src/render/rt64_vi_bounds.h b/src/render/rt64_vi_bounds.h
new file mode 100644
index 0000000..8bf3e8f
--- /dev/null
+++ b/src/render/rt64_vi_bounds.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace RT64 {
+    struct PixelAlignedViewportBounds {
+        float left, top, right, bottom;
+    };
+
+    inline PixelAlignedViewportBounds pixelAlignedViewportBounds(
+        float left, float top, float right, float bottom
+    ) {
+        return {std::round(left), std::round(top), std::round(right), std::round(bottom)};
+    }
+
+    struct ConservativeScissorBounds {
+        int32_t left;
+        int32_t top;
+        int32_t right;
+        int32_t bottom;
+    };
+
+    inline ConservativeScissorBounds conservativeScissorBounds(
+        float left,
+        float top,
+        float right,
+        float bottom,
+        uint32_t outputWidth,
+        uint32_t outputHeight
+    ) {
+        const int32_t width = static_cast<int32_t>(outputWidth);
+        const int32_t height = static_cast<int32_t>(outputHeight);
+        return {
+            std::clamp(static_cast<int32_t>(std::floor(left)), 0, width),
+            std::clamp(static_cast<int32_t>(std::floor(top)), 0, height),
+            std::clamp(static_cast<int32_t>(std::ceil(right)), 0, width),
+            std::clamp(static_cast<int32_t>(std::ceil(bottom)), 0, height),
+        };
+    }
+}
