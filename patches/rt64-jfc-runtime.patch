diff --git a/src/gbi/rt64_gbi_f3ddkr.cpp b/src/gbi/rt64_gbi_f3ddkr.cpp
new file mode 100644
index 0000000..6668e19
--- /dev/null
+++ b/src/gbi/rt64_gbi_f3ddkr.cpp
@@ -0,0 +1,273 @@
+#include "rt64_gbi_f3ddkr.h"
+
+#include <cassert>
+
+#include "rt64_gbi.h"
+#include "rt64_gbi_f3d.h"
+#include "rt64_gbi_rdp.h"
+#include "hle/rt64_interpreter.h"
+
+namespace RT64 {
+    namespace GBI_F3DDKR {
+        static void matrix(State *state, DisplayList **dl) {
+            uint8_t index = (*dl)->p0(16, 4);
+            bool multiply = false;
+            if (index == 0) {
+                index = (*dl)->p0(22, 2);
+            }
+            else {
+                multiply = (*dl)->p0(23, 1) != 0;
+            }
+
+            state->rsp->setMatrixDKR(
+                (*dl)->w1, index, multiply, matrixInterpolationId((*dl)->w0, (*dl)->w1));
+        }
+
+        static void vertex(State *state, DisplayList **dl) {
+            RSP &rsp = *state->rsp;
+            if (((*dl)->w0 & F3DDKRTracerMarker) != 0) {
+                const uint32_t expected = 0x04200030U | (((*dl)->w1 & 6U) << 16) | F3DDKRTracerMarker;
+                if ((*dl)->w0 != expected)
+                    throw std::runtime_error("F3DDKR tracer: invalid vertex command shape");
+                rsp.setTracerDKR((*dl)->w1);
+                rsp.DKR.vertexIndex = 4;
+                return;
+            }
+            if (((*dl)->w0 & F3DDKR_VTX_APPEND) != 0) {
+                if (rsp.DKR.billboard) {
+                    rsp.DKR.vertexIndex = 1;
+                }
+            }
+            else {
+                rsp.DKR.vertexIndex = 0;
+            }
+
+            const uint32_t count = jfgVertexCount((*dl)->w0);
+            if (count == 0) {
+                throw std::runtime_error("F3DDKR vertex DMA has a zero vertex count");
+            }
+
+            const uint32_t dstIndex = rsp.DKR.vertexIndex + (*dl)->p0(9, 5);
+            if (((*dl)->w0 & ProceduralSkyVertexMarker) != 0) {
+                const uint32_t expected = 0x04480062U | (((*dl)->w1 & 6U) << 16) | ProceduralSkyVertexMarker;
+                if ((*dl)->w0 != expected || rsp.DKR.billboard || dstIndex != 0)
+                    throw std::runtime_error("F3DDKR procedural sky: invalid vertex ownership");
+                auto &group = rsp.extended.modelMatrixIdStack[rsp.extended.modelMatrixIdStackSize - 1];
+                const TransformGroup previous = group;
+                group.matrixId = ProceduralSkyMatrixId;
+                group.ordering = G_EX_ORDER_LINEAR;
+                group.vertexInterpolation = group.texcoordInterpolation = G_EX_COMPONENT_INTERPOLATE;
+                const auto &tile = state->rdp->tiles[rsp.textureState.tile];
+                group.texcoordWrapPoint[0] = textureCoordinatePeriod(tile.masks, tile.shifts, tile.cms);
+                group.texcoordWrapPoint[1] = textureCoordinatePeriod(tile.maskt, tile.shiftt, tile.cmt);
+                rsp.extended.modelMatrixIdStackChanged = true;
+                rsp.setVertexDKR((*dl)->w1, count, dstIndex);
+                group = previous;
+                rsp.extended.modelMatrixIdStackChanged = true;
+            }
+            else {
+                rsp.setVertexDKR((*dl)->w1, count, dstIndex);
+            }
+            rsp.DKR.vertexIndex += uint8_t(count);
+        }
+
+        static uint32_t packTexcoord(int16_t s, int16_t t) {
+            return (uint32_t(uint16_t(s)) << 16) | uint16_t(t);
+        }
+
+        static void triangles(State *state, DisplayList **dl) {
+            RSP &rsp = *state->rsp;
+            const uint32_t count = triangleCount((*dl)->w0);
+            const uint32_t address = rsp.fromSegmentedMasked((*dl)->w1);
+            if ((count > 16) || ((address + count * sizeof(Triangle)) > (RDRAMSize + 1))) {
+                throw std::runtime_error("F3DDKR triangle DMA is outside RDRAM");
+            }
+
+            rsp.textureState.on = (*dl)->p0(16, 4);
+            const Triangle *triangle = reinterpret_cast<const Triangle *>(state->fromRDRAM(address));
+            for (uint32_t i = 0; i < count; i++, triangle++) {
+                constexpr uint8_t DKRVertexCapacity = 24;
+                if ((triangle->v0 >= DKRVertexCapacity) ||
+                    (triangle->v1 >= DKRVertexCapacity) ||
+                    (triangle->v2 >= DKRVertexCapacity)) {
+                    throw std::runtime_error("F3DDKR triangle references an invalid vertex slot");
+                }
+
+                const int workloadCursor = state->ext.workloadQueue->writeCursor;
+                const Workload &workload = state->ext.workloadQueue->workloads[workloadCursor];
+                if ((rsp.indices[triangle->v0] >= workload.drawData.posTransformed.size()) ||
+                    (rsp.indices[triangle->v1] >= workload.drawData.posTransformed.size()) ||
+                    (rsp.indices[triangle->v2] >= workload.drawData.posTransformed.size())) {
+                    throw std::runtime_error("F3DDKR triangle references a vertex that was not loaded");
+                }
+
+                uint32_t cullMode = 0;
+                if ((triangle->flag & 0x40U) == 0) {
+                    const bool positiveViewportX = rsp.viewportStack[rsp.viewportStackSize - 1].scale.x > 0.0f;
+                    cullMode = positiveViewportX ? (rsp.cullBothMask ^ rsp.cullFrontMask) : rsp.cullFrontMask;
+                }
+
+                rsp.modifyGeometryMode(~rsp.cullBothMask, cullMode);
+                rsp.modifyVertex(triangle->v0, G_MWO_POINT_ST, packTexcoord(triangle->s0, triangle->t0));
+                rsp.modifyVertex(triangle->v1, G_MWO_POINT_ST, packTexcoord(triangle->s1, triangle->t1));
+                rsp.modifyVertex(triangle->v2, G_MWO_POINT_ST, packTexcoord(triangle->s2, triangle->t2));
+                rsp.drawIndexedTri(triangle->v0, triangle->v1, triangle->v2);
+                const uint32_t primitiveAddress = address + i * sizeof(Triangle);
+                auto scroll = std::upper_bound(state->taskTextureScrolls.begin(), state->taskTextureScrolls.end(), primitiveAddress,
+                    [](uint32_t key, const TextureScrollRange &range) { return key < range.begin; });
+                if (scroll != state->taskTextureScrolls.begin()) {
+                    --scroll;
+                    if (primitiveAddress >= scroll->begin && primitiveAddress + sizeof(Triangle) <= scroll->end &&
+                        (primitiveAddress - scroll->begin) % sizeof(Triangle) == 0 && !rsp.DKR.billboard) {
+                        auto &data = state->ext.workloadQueue->workloads[workloadCursor].drawData;
+
+                        data.textureScrollTriangles.push_back({primitiveAddress, scroll->generation,
+                            {rsp.indices[triangle->v0], rsp.indices[triangle->v1], rsp.indices[triangle->v2]},
+                            state->drawCall.tileIndex, state->drawCall.tileCount,
+                            {scroll->wrap[0] / 32.0f, scroll->wrap[1] / 32.0f}, {scroll->phase[0], scroll->phase[1]}});
+                    }
+                }
+            }
+
+            rsp.DKR.vertexIndex = 0;
+        }
+
+        static void dmaDisplayList(State *state, DisplayList **dl) {
+            RSP &rsp = *state->rsp;
+            const uint32_t count = dmaDisplayListCount((*dl)->w0);
+            const uint32_t address = rsp.fromSegmentedMasked((*dl)->w1);
+            if ((count == 0) || (address % alignof(DisplayList)) || ((address + count * sizeof(DisplayList)) > (RDRAMSize + 1))) {
+                throw std::runtime_error("F3DDKR display-list DMA is outside RDRAM");
+            }
+
+            Interpreter &interpreter = *state->ext.interpreter;
+            DisplayList *command = reinterpret_cast<DisplayList *>(state->fromRDRAM(address));
+            uint32_t consumed = 0;
+            while (consumed < count) {
+                DisplayList *executed = command;
+                const uint8_t opcode = uint8_t(command->w0 >> 24);
+
+                if ((opcode & 0xC0U) == 0xC0U) {
+                    requireDisplayListRange(reinterpret_cast<uintptr_t>(command),
+                        reinterpret_cast<uintptr_t>(command) + (count - consumed) * sizeof(DisplayList),
+                        command, interpreter.commandWords(command, interpreter.hleGBI, false));
+                    GBIFunction function = interpreter.hleGBI->map[opcode];
+                    if (function != nullptr) {
+                        function(state, &executed);
+                    }
+                }
+
+                if (executed == nullptr) {
+                    throw std::runtime_error("F3DDKR RDP DMA command produced a null cursor");
+                }
+
+                const uintptr_t commandPointer = reinterpret_cast<uintptr_t>(command);
+                const uintptr_t executedPointer = reinterpret_cast<uintptr_t>(executed);
+                if ((executedPointer < commandPointer) ||
+                    (((executedPointer - commandPointer) % sizeof(DisplayList)) != 0)) {
+                    throw std::runtime_error("F3DDKR RDP DMA command advanced to an invalid cursor");
+                }
+
+                const uint64_t length =
+                    ((executedPointer - commandPointer) / sizeof(DisplayList)) + 1;
+                if (length > (count - consumed)) {
+                    throw std::runtime_error("F3DDKR RDP DMA command exceeds its counted payload");
+                }
+
+                command = executed + 1;
+                consumed += uint32_t(length);
+            }
+        }
+
+        static void dmaOffsets(State *state, DisplayList **dl) {
+            state->rsp->setDMAOffsetsDKR((*dl)->w0, (*dl)->w1);
+        }
+
+        static void textureOffset(State *state, DisplayList **dl) {
+            RSP &rsp = *state->rsp;
+            rsp.DKR.textureOffset = rsp.fromSegmentedMasked((*dl)->w1);
+            rsp.DKR.textureShift = 0;
+            rsp.DKR.textureCount = 0;
+        }
+
+        static void moveWord(State *state, DisplayList **dl) {
+            switch ((*dl)->p0(0, 8)) {
+            case F3DDKR_G_MW_BILLBOARD:
+                state->rsp->DKR.billboard = ((*dl)->w1 & 1U) != 0;
+                break;
+            case F3DDKR_G_MW_MVPMATRIX:
+                state->rsp->selectMatrixDKR((*dl)->p1(6, 2));
+                break;
+            default:
+                GBI_F3D::moveWord(state, dl);
+                break;
+            }
+        }
+
+        static void setTextureImage(State *state, DisplayList **dl) {
+            RSP &rsp = *state->rsp;
+            const uint8_t fmt = (*dl)->p0(21, 3);
+            const uint8_t siz = (*dl)->p0(19, 2);
+            const uint16_t width = (*dl)->p0(0, 12) + 1;
+            uint32_t address = rsp.fromSegmented((*dl)->w1);
+            if (rsp.DKR.textureOffset != 0) {
+                if (fmt == G_IM_FMT_RGBA) {
+                    const uint32_t tableIndex = rsp.DKR.textureCount ^ 1U;
+                    const uint64_t entryAddress = uint64_t(rsp.DKR.textureOffset) + uint64_t(tableIndex) * sizeof(uint16_t);
+                    if ((entryAddress % alignof(uint16_t)) || (entryAddress + sizeof(uint16_t)) > (RDRAMSize + 1)) {
+                        throw std::runtime_error("F3DDKR texture-offset table is outside RDRAM");
+                    }
+
+                    rsp.DKR.textureShift = *reinterpret_cast<const uint16_t *>(state->fromRDRAM(entryAddress));
+                    address += rsp.DKR.textureShift;
+                }
+                else {
+                    rsp.DKR.textureOffset = 0;
+                    rsp.DKR.textureShift = 0;
+                    rsp.DKR.textureCount = 0;
+                }
+            }
+
+            state->rdp->setTextureImage(fmt, siz, width, address);
+        }
+
+        static void loadBlock(State *state, DisplayList **dl) {
+            RSP &rsp = *state->rsp;
+            if (rsp.DKR.textureOffset != 0) {
+                const uint32_t lrs = (*dl)->p1(12, 12);
+                const uint32_t byteCount = ((lrs >> 2) + 1) << 3;
+                if ((rsp.DKR.textureShift % byteCount) != 0) {
+                    state->rdp->texture.address = state->rdp->maskAddress(
+                        state->rdp->texture.address - rsp.DKR.textureShift);
+                    rsp.DKR.textureOffset = 0;
+                    rsp.DKR.textureShift = 0;
+                    rsp.DKR.textureCount = 0;
+                }
+                else {
+                    rsp.DKR.textureCount++;
+                }
+            }
+
+            GBI_RDP::loadBlock(state, dl);
+        }
+
+        static void reset(State *state) {
+            GBI_F3D::reset(state);
+            state->rsp->resetDKR();
+        }
+
+        void setup(GBI *gbi) {
+            GBI_F3D::setup(gbi);
+            gbi->map[F3D_G_MTX] = &matrix;
+            gbi->map[F3DDKR_G_DMA_TEX_OFFSET] = &textureOffset;
+            gbi->map[F3D_G_VTX] = &vertex;
+            gbi->map[F3DDKR_G_TRI] = &triangles;
+            gbi->map[F3DDKR_G_DMA_DL] = &dmaDisplayList;
+            gbi->map[F3D_G_MOVEWORD] = &moveWord;
+            gbi->map[F3DDKR_G_DMA_OFFSETS] = &dmaOffsets;
+            gbi->map[G_SETTIMG] = &setTextureImage;
+            gbi->map[G_LOADBLOCK] = &loadBlock;
+            gbi->resetFromTask = &reset;
+        }
+    };
+};
diff --git a/src/gbi/rt64_gbi_f3ddkr.h b/src/gbi/rt64_gbi_f3ddkr.h
new file mode 100644
index 0000000..309a868
--- /dev/null
+++ b/src/gbi/rt64_gbi_f3ddkr.h
@@ -0,0 +1,178 @@
+#pragma once
+
+#include <cstdint>
+
+#define F3DDKR_G_DMA_TEX_OFFSET 0x02
+#define F3DDKR_G_TRI 0x05
+#define F3DDKR_G_DMA_DL 0x07
+#define F3DDKR_G_DMA_OFFSETS 0xBF
+#define F3DDKR_G_MW_BILLBOARD 0x02
+#define F3DDKR_G_MW_MVPMATRIX 0x0A
+#define F3DDKR_VTX_APPEND 0x00010000
+
+namespace RT64 {
+    struct GBI;
+
+    namespace GBI_F3DDKR {
+        struct Triangle {
+            uint8_t v2;
+            uint8_t v1;
+            uint8_t v0;
+            uint8_t flag;
+            int16_t t0;
+            int16_t s0;
+            int16_t t1;
+            int16_t s1;
+            int16_t t2;
+            int16_t s2;
+        };
+
+        static_assert(sizeof(Triangle) == 16);
+
+        constexpr uint32_t jfgVertexCount(uint32_t w0) {
+            return (w0 >> 19) & 0x1FU;
+        }
+
+        constexpr uint32_t triangleCount(uint32_t w0) {
+            return ((w0 >> 20) & 0xFU) + 1;
+        }
+
+        constexpr uint32_t dmaDisplayListCount(uint32_t w0) {
+            return (w0 >> 16) & 0xFFU;
+        }
+
+        constexpr uint8_t clipCode(float, float y, float w) {
+            return uint8_t((y > w ? 0x04 : 0) | (y < -w ? 0x08 : 0) |
+                (w < 0.01f ? 0x10 : 0));
+        }
+
+        constexpr uint32_t MatrixTagIdMask = 0x001FFFFFU;
+        constexpr uint32_t MatrixTagMarker = 0x00400000U;
+        constexpr uint32_t MatrixMultiply = 0x00800000U;
+        constexpr uint32_t MatrixTagW0Mask = 0x0070FFFFU;
+        constexpr uint32_t MatrixTagW1Mask = 0x00000007U;
+        constexpr uint32_t CameraMatrixTag = 0x1U;
+        constexpr uint32_t CameraMatrixId = 0x80000001U;
+        constexpr uint32_t SpriteMatrixIdNamespace = 0x20000000U;
+
+        constexpr uint32_t SkyMatrixTagW1 = 0x10000000U;
+        constexpr uint32_t SkyMatrixIdNamespace = 0x10000000U;
+        constexpr uint32_t ProceduralSkyVertexMarker = 0x00004000U;
+        constexpr uint32_t ProceduralSkyMatrixId = SkyMatrixIdNamespace | 0x08000000U;
+
+        constexpr float textureCoordinatePeriod(uint8_t mask, uint8_t shift, uint8_t mode) {
+            if (mask == 0 || (mode & 2U) != 0) return 0.0f;
+            const float period = float(1U << (mask + ((mode & 1U) ? 1U : 0U)));
+            return shift <= 10 ? period * float(1U << shift) : period / float(1U << (16U - shift));
+        }
+
+        constexpr bool isSkyMatrixId(uint32_t id) {
+            return (id & SkyMatrixIdNamespace) != 0 && id != 0xFFFFFFFFU;
+        }
+
+        constexpr bool hasMatrixTag(uint32_t w0) {
+            return (w0 & MatrixTagMarker) != 0;
+        }
+
+        constexpr uint32_t matrixTagId(uint32_t w0, uint32_t w1) {
+            return (w0 & 0xFFFFU) |
+                ((w0 & 0x00300000U) >> 4) |
+                ((w1 & 0x7U) << 18);
+        }
+
+        constexpr uint32_t matrixInterpolationId(uint32_t w0, uint32_t w1) {
+            if (hasMatrixTag(w0)) {
+
+                const bool sprite = ((w0 >> 16) & 0xFU) == 2U &&
+                    (w0 & MatrixMultiply) == 0;
+                return matrixTagId(w0, w1) |
+                    (sprite ? SpriteMatrixIdNamespace : 0U) |
+                    ((w1 & SkyMatrixTagW1) ? SkyMatrixIdNamespace : 0U);
+            }
+            const bool slot0 = ((w0 >> 16) & 0xFU) == 0U &&
+                ((w0 >> 22) & 0x3U) == 0U;
+            return slot0 && (w1 & MatrixTagW1Mask) == CameraMatrixTag
+                ? CameraMatrixId : 0U;
+        }
+
+        constexpr uint32_t withCameraMatrixTagW1(uint32_t w1) {
+            return (w1 & ~MatrixTagW1Mask) | CameraMatrixTag;
+        }
+
+        constexpr uint32_t withMatrixTagW0(uint32_t w0, uint32_t id) {
+            id &= MatrixTagIdMask;
+            return (w0 & ~MatrixTagW0Mask) | MatrixTagMarker |
+                (id & 0xFFFFU) | ((id & 0x00030000U) << 4);
+        }
+
+        constexpr uint32_t withMatrixTagW1(uint32_t w1, uint32_t id) {
+            id &= MatrixTagIdMask;
+            return (w1 & ~MatrixTagW1Mask) |
+                ((id & 0x001C0000U) >> 18);
+        }
+
+        constexpr uint32_t withMatrixMultiplyW0(uint32_t w0) {
+            return w0 | MatrixMultiply;
+        }
+
+        constexpr uint32_t BoneMatrixIdNamespace = 0x40000000U;
+        constexpr bool hasBoneDMA(uint32_t w1) {
+            return (w1 & 0x40000000U) != 0;
+        }
+
+        constexpr uint32_t boneDMAW0(uint32_t w0, uint32_t count, bool bank1) {
+            return (w0 & ~7U) | ((count | (bank1 ? 0x80U : 0U)) >> 6);
+        }
+
+        constexpr uint32_t boneDMAW1(uint32_t w1, uint32_t count) {
+            return (w1 & 0x00FFFFFFU) | 0x40000000U | ((count & 0x3FU) << 24);
+        }
+
+        struct BoneDMA {
+            uint32_t bank0 = 0;
+            uint32_t current = 0;
+            uint32_t count = 0;
+            bool sky = false;
+
+            bool decode(uint32_t w0, uint32_t w1, uint32_t rdramBytes) {
+                *this = {};
+                if (!hasBoneDMA(w1)) {
+                    return true;
+                }
+                const uint32_t payload = ((w0 & 3U) << 6) | ((w1 >> 24) & 0x3FU);
+                const uint32_t bones = payload & 0x7FU;
+                const uint32_t span = bones * 64U;
+                const uint32_t base = w0 & 0x00FFFFF8U;
+                const uint32_t previousSpan = (payload & 0x80U) ? span : 0U;
+                if ((w0 >> 24) != F3DDKR_G_DMA_OFFSETS || (w0 & 4U) ||
+                    bones == 0 || base < previousSpan) {
+                    return false;
+                }
+                const uint32_t canonical = base - previousSpan;
+                if (canonical == 0 || canonical > rdramBytes ||
+                    2U * span > rdramBytes - canonical) {
+                    return false;
+                }
+                bank0 = canonical;
+                current = base;
+                count = bones;
+                sky = (w1 & 0x80000000U) != 0;
+                return true;
+            }
+
+            uint32_t matrixId(uint32_t physicalAddress) const {
+                if (count == 0 || physicalAddress < current) {
+                    return 0;
+                }
+                const uint32_t offset = physicalAddress - current;
+                if ((offset % 64U) != 0 || offset >= count * 64U) {
+                    return 0;
+                }
+                return BoneMatrixIdNamespace | ((bank0 + offset) >> 3) |
+                    (sky ? SkyMatrixIdNamespace : 0U);
+            }
+        };
+
+        void setup(GBI *gbi);
+    };
+};
