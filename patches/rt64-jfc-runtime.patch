index 0000000..900beba
--- /dev/null
+++ b/src/render/rt64_state_texture.cpp
@@ -0,0 +1,246 @@
+#include "rt64_state_texture.h"
+#include "rt64_descriptor_sets.h"
+#include <algorithm>
+#include <cstring>
+#include <stdexcept>
+#include <zstd.h>
+
+#include "shaders/StateReadCS.hlsl.spirv.h"
+#include "shaders/StateReadCSMS.hlsl.spirv.h"
+#include "shaders/StateWritePS.hlsl.spirv.h"
+#include "shaders/StateWriteDepthPS.hlsl.spirv.h"
+#include "shaders/FullScreenVS.hlsl.spirv.h"
+#ifdef _WIN32
+#include "shaders/StateReadCS.hlsl.dxil.h"
+#include "shaders/StateReadCSMS.hlsl.dxil.h"
+#include "shaders/StateWritePS.hlsl.dxil.h"
+#include "shaders/StateWriteDepthPS.hlsl.dxil.h"
+#include "shaders/FullScreenVS.hlsl.dxil.h"
+#endif
+
+namespace RT64 {
+namespace {
+constexpr uint32_t TransferBytes = 4 * 1024 * 1024;
+constexpr uint64_t MaxCompressedBytes = 120ull * 1024 * 1024;
+constexpr uint32_t PixelBytes = 16;
+struct Constants { uint32_t width, rows, firstRow, sample; };
+
+void require(bool condition, const char *message) {
+    if (!condition) throw std::runtime_error(message);
+}
+uint32_t rowsPerBlock(uint32_t width) { return TransferBytes / (width * PixelBytes); }
+uint32_t validateShape(const StateTexture &s) {
+    require(s.width && s.height && s.width <= 16384 && s.height <= 16384,
+        "Invalid save-state GPU texture dimensions");
+    require(s.format == RenderFormat::R8G8B8A8_UNORM ||
+        s.format == RenderFormat::R16G16B16A16_UNORM || s.format == RenderFormat::D32_FLOAT,
+        "Unsupported save-state GPU texture format");
+    const uint32_t samples = s.multisampling.sampleCount;
+    require(samples == 1 || samples == 2 || samples == 4 || samples == 8,
+        "Unsupported save-state GPU sample count");
+    if (s.multisampling.sampleLocationsEnabled) {
+        for (uint32_t i = 0; i < samples; ++i) {
+            const auto &p = s.multisampling.sampleLocations[i];
+            require(p.x >= -8 && p.x <= 7 && p.y >= -8 && p.y <= 7,
+                "Invalid save-state GPU sample location");
+        }
+    }
+    return rowsPerBlock(s.width);
+}
+std::vector<uint8_t> unpack(const std::vector<uint8_t> &block, size_t bytes) {
+    require(!block.empty() && block.size() <= ZSTD_compressBound(bytes),
+        "Invalid save-state GPU block length");
+    require(ZSTD_getFrameContentSize(block.data(), block.size()) == bytes &&
+        ZSTD_findFrameCompressedSize(block.data(), block.size()) == block.size(),
+        "Invalid save-state GPU compressed extent");
+    std::vector<uint8_t> result(bytes);
+    const auto decoded = ZSTD_decompress(result.data(), bytes, block.data(), block.size());
+    require(!ZSTD_isError(decoded) && decoded == bytes, "Corrupt save-state GPU block");
+    return result;
+}
+struct ReadSet : RenderDescriptorSetBase {
+    uint32_t source, destination;
+    explicit ReadSet(RenderDevice *device) {
+        builder.begin(); source = builder.addTexture(1);
+        destination = builder.addReadWriteStructuredBuffer(2); builder.end(); create(device);
+    }
+};
+struct WriteSet : RenderDescriptorSetBase {
+    uint32_t source;
+    explicit WriteSet(RenderDevice *device) {
+        builder.begin(); source = builder.addStructuredBuffer(1); builder.end(); create(device);
+    }
+};
+#ifdef _WIN32
+#define STATE_SHADER(name, entry) device->createShader( \
+    shaders == RenderShaderFormat::DXIL ? name##BlobDXIL : name##BlobSPIRV, \
+    shaders == RenderShaderFormat::DXIL ? sizeof(name##BlobDXIL) : sizeof(name##BlobSPIRV), entry, shaders)
+#else
+#define STATE_SHADER(name, entry) device->createShader(name##BlobSPIRV, sizeof(name##BlobSPIRV), entry, shaders)
+#endif
+void validateBackend(RenderShaderFormat shaders) {
+    require(shaders == RenderShaderFormat::SPIRV
+#ifdef _WIN32
+        || shaders == RenderShaderFormat::DXIL
+#endif
+        , "Unsupported save-state GPU shader backend");
+
+    const uint32_t endian = 1;
+    require(*reinterpret_cast<const uint8_t *>(&endian) == 1 && sizeof(float) == 4,
+        "Unsupported save-state GPU sample representation");
+}
+void finish(RenderWorker *worker) {
+    worker->commandList->end();
+    require(worker->execute() != 0, "Save-state GPU submission failed");
+    worker->waitIfPending();
+}
+}
+
+StateTexture captureStateTexture(RenderWorker *worker, RenderShaderFormat shaders,
+        RenderTexture *texture, uint32_t width, uint32_t height, RenderFormat format,
+        const RenderMultisampling &multisampling) {
+    require(worker && texture, "Missing save-state GPU texture owner");
+    validateBackend(shaders);
+    StateTexture result;
+    result.width = width; result.height = height; result.format = format;
+    result.multisampling = multisampling;
+    const uint32_t blockRows = validateShape(result);
+    auto *device = worker->device;
+    worker->waitIfPending();
+    ReadSet descriptors(device);
+    RenderPipelineLayoutBuilder builder;
+    builder.begin(); builder.addDescriptorSet(descriptors);
+    builder.addPushConstant(0, 0, sizeof(Constants), RenderShaderStageFlag::COMPUTE); builder.end();
+    auto layout = builder.create(device);
+    auto shader = multisampling.sampleCount > 1 ? STATE_SHADER(StateReadCSMS, "CSMain") : STATE_SHADER(StateReadCS, "CSMain");
+    require(layout && shader, "Cannot create save-state GPU read shader");
+    auto pipeline = device->createComputePipeline(RenderComputePipelineDesc(layout.get(), shader.get(), 8, 8, 1));
+    auto gpu = device->createBuffer(RenderBufferDesc::DefaultBuffer(TransferBytes,
+        RenderBufferFlag::STORAGE | RenderBufferFlag::UNORDERED_ACCESS));
+    auto readback = device->createBuffer(RenderBufferDesc::ReadbackBuffer(TransferBytes));
+    auto view = texture->createTextureView(RenderTextureViewDesc::Texture2D(format));
+    require(pipeline && gpu && readback && view, "Cannot allocate save-state GPU readback");
+    descriptors.setTexture(descriptors.source, texture, RenderTextureLayout::SHADER_READ, view.get());
+    descriptors.setBuffer(descriptors.destination, gpu.get(), RenderBufferStructuredView(PixelBytes));
+    uint64_t compressedTotal = 0;
+    for (uint32_t sample = 0; sample < multisampling.sampleCount; ++sample) {
+        for (uint32_t y = 0; y < height; y += blockRows) {
+            const Constants cb{width, std::min(blockRows, height - y), y, sample};
+            const size_t bytes = size_t(width) * cb.rows * PixelBytes;
+
+            std::vector<uint8_t> compressed(ZSTD_compressBound(bytes));
+            worker->commandList->begin();
+            worker->commandList->barriers(RenderBarrierStage::COMPUTE,
+                RenderTextureBarrier(texture, RenderTextureLayout::SHADER_READ));
+            worker->commandList->barriers(RenderBarrierStage::COMPUTE, RenderBufferBarrier(gpu.get(), RenderBufferAccess::WRITE));
+            worker->commandList->setPipeline(pipeline.get());
+            worker->commandList->setComputePipelineLayout(layout.get());
+            worker->commandList->setComputeDescriptorSet(descriptors.get(), 0);
+            worker->commandList->setComputePushConstants(0, &cb);
+            worker->commandList->dispatch((width + 7) / 8, (cb.rows + 7) / 8, 1);
+            const RenderBufferBarrier barriers[] = {
+                {gpu.get(), RenderBufferAccess::READ}, {readback.get(), RenderBufferAccess::WRITE}};
+            worker->commandList->barriers(RenderBarrierStage::COPY, barriers, 2);
+            worker->commandList->copyBufferRegion(readback.get(), gpu.get(), bytes);
+            finish(worker);
+            const RenderRange range{0, bytes};
+            const void *data = readback->map(0, &range);
+            require(data != nullptr, "Cannot map save-state GPU readback");
+            const size_t count = ZSTD_compress(compressed.data(), compressed.size(), data, bytes, 1);
+            readback->unmap();
+            require(!ZSTD_isError(count), "Cannot compress save-state GPU samples");
+            compressedTotal += count;
+            require(compressedTotal <= MaxCompressedBytes, "Save-state GPU data exceeds file budget");
+            compressed.resize(count);
+            result.blocks.emplace_back(std::move(compressed));
+        }
+    }
+    return result;
+}
+
+void validateStateTexture(const StateTexture &state) {
+    const uint32_t rows = validateShape(state);
+    require(state.blocks.size() == size_t((state.height + rows - 1) / rows) * state.multisampling.sampleCount,
+        "Invalid save-state GPU block count");
+    uint64_t total = 0;
+    size_t index = 0;
+    for (uint32_t sample = 0; sample < state.multisampling.sampleCount; ++sample) {
+        for (uint32_t y = 0; y < state.height; y += rows) {
+            const auto &block = state.blocks[index++];
+            total += block.size();
+            require(total <= MaxCompressedBytes, "Save-state GPU data exceeds file budget");
+            unpack(block, size_t(state.width) * std::min(rows, state.height - y) * PixelBytes);
+        }
+    }
+}
+
+std::unique_ptr<RenderTexture> prepareStateTexture(RenderWorker *worker,
+        RenderShaderFormat shaders, const StateTexture &state, RenderTextureFlags extraFlags) {
+    require(worker != nullptr, "Missing save-state GPU worker");
+    validateBackend(shaders);
+    validateStateTexture(state);
+    worker->waitIfPending();
+    const bool depth = state.format == RenderFormat::D32_FLOAT;
+    const uint32_t blockRows = rowsPerBlock(state.width);
+    auto *device = worker->device;
+    auto texture = device->createTexture(depth ?
+        RenderTextureDesc::DepthTarget(state.width, state.height, state.format, state.multisampling) :
+        RenderTextureDesc::ColorTarget(state.width, state.height, state.format, state.multisampling, nullptr, extraFlags));
+    require(texture != nullptr, "Cannot allocate restored GPU texture");
+    const RenderTexture *color = depth ? nullptr : texture.get();
+    auto framebuffer = device->createFramebuffer(RenderFramebufferDesc(depth ? nullptr : &color,
+        depth ? 0 : 1, depth ? texture.get() : nullptr));
+    WriteSet descriptors(device);
+    RenderPipelineLayoutBuilder builder;
+    builder.begin(); builder.addDescriptorSet(descriptors);
+    builder.addPushConstant(0, 0, sizeof(Constants), RenderShaderStageFlag::PIXEL); builder.end();
+    auto layout = builder.create(device);
+    auto vertex = STATE_SHADER(FullScreenVS, "VSMain");
+    auto pixel = depth ? STATE_SHADER(StateWriteDepthPS, "PSMain") : STATE_SHADER(StateWritePS, "PSMain");
+    require(framebuffer && layout && vertex && pixel, "Cannot create save-state GPU write shader");
+    RenderGraphicsPipelineDesc desc;
+    desc.pipelineLayout = layout.get(); desc.vertexShader = vertex.get(); desc.pixelShader = pixel.get();
+    desc.multisampling = state.multisampling;
+    desc.depthEnabled = depth; desc.depthWriteEnabled = depth;
+    desc.depthFunction = RenderComparisonFunction::ALWAYS;
+    desc.depthTargetFormat = depth ? state.format : RenderFormat::UNKNOWN;
+    desc.renderTargetCount = depth ? 0 : 1;
+    desc.renderTargetFormat[0] = depth ? RenderFormat::UNKNOWN : state.format;
