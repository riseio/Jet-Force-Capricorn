+        void prepareProducerStorage(ProfilerState &profiler) {
+            profiler.retainedArenaEvents =
+                ((profiler.maximumEvents + EventChunkSize - 1) / EventChunkSize) * EventChunkSize;
+            profiler.retainedArena = std::make_unique<Event[]>(profiler.retainedArenaEvents);
+            touchEventStorage(profiler.retainedArena.get(), profiler.retainedArenaEvents);
+            const uint64_t slots = std::min(profiler.maximumThreads,
+                profiler.maximumStreamBytes / (64 * sizeof(Event)));
+            const uint64_t capacity = std::min(profiler.maximumStreamedEvents,
+                profiler.maximumStreamBytes / (slots * sizeof(Event)));
+            profiler.threadBuffers.reserve(size_t(slots));
+            for (uint64_t slot = 0; slot < slots; ++slot) {
+                auto buffer = std::make_unique<ThreadBuffer>(profiler.maximumEvents, capacity);
+                buffer->name = "Thread";
+                buffer->id = uint32_t(slot + 1);
+                profiler.threadBuffers.push_back(buffer.release());
+            }
+            profiler.allocatedStreamBytes.store(slots * capacity * sizeof(Event));
+            profiler.metadata["producer_storage_policy"] = "preallocated_pretouched_bounded_slots_v1";
+            profiler.metadata["producer_storage_slots"] = std::to_string(slots);
+            profiler.metadata["producer_stream_capacity_per_slot"] = std::to_string(capacity);
+            profiler.metadata["producer_retained_arena_bytes"] = std::to_string(profiler.retainedArenaEvents * sizeof(Event));
+            profiler.metadata["observer_frame_path_allocation_scope"] =
+                "explicit_consumer_reports_only_not_an_allocator_census";
+        }
+
+        ThreadBuffer *claimProducerStorage(ProfilerState &profiler) {
+
+            for (ThreadBuffer *candidate : profiler.threadBuffers) {
+                bool available = true;
+                if (candidate->retired.compare_exchange_strong(available, false, std::memory_order_acquire)) {
+                    candidate->durationSamplingSlots = {};
+                    return candidate;
+                }
+            }
+            return nullptr;
+        }
