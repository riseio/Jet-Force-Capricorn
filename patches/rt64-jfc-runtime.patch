+        double parsePositiveDouble(const char *name, double fallback) {
+            const char *text = std::getenv(name);
+            if ((text == nullptr) || (text[0] == '\0')) {
+                return fallback;
+            }
+
+            char *end = nullptr;
+            const double value = std::strtod(text, &end);
+            return ((end != text) && (end != nullptr) && (*end == '\0') &&
+                std::isfinite(value) && (value > 0.0)) ? value : fallback;
+        }
+
+        uint64_t parsePositiveInteger(const char *name, uint64_t fallback) {
+            const char *text = std::getenv(name);
+            if ((text == nullptr) || (text[0] == '\0')) {
+                return fallback;
+            }
+
+            uint64_t value = 0;
+            const char *end = text + std::strlen(text);
+            const auto parsed = std::from_chars(text, end, value);
+            return parsed.ec == std::errc() && parsed.ptr == end && value > 0 ? value : fallback;
+        }
+
+        uint64_t parseNonNegativeInteger(const char *name, uint64_t fallback) {
+            const char *text = std::getenv(name);
+            if ((text == nullptr) || (text[0] == '\0')) {
+                return fallback;
+            }
+
+            uint64_t value = 0;
+            const char *end = text + std::strlen(text);
+            const auto parsed = std::from_chars(text, end, value);
+            return parsed.ec == std::errc() && parsed.ptr == end ? value : fallback;
+        }
+
+        bool parseEnabledFlag(const char *name) {
+            const char *text = std::getenv(name);
+            return (text != nullptr) && (text[0] != '\0') &&
+                (text[0] != '0');
+        }
+
+        bool validUTF8(std::string_view text, bool allowNull = true) {
+            for (size_t i = 0; i < text.size();) {
+                const auto first = static_cast<unsigned char>(text[i++]);
+                if (first < 0x80) {
+                    if (!allowNull && first == 0) return false;
+                    continue;
+                }
+                const size_t extra = first >= 0xc2 && first <= 0xdf ? 1 :
+                    first >= 0xe0 && first <= 0xef ? 2 :
+                    first >= 0xf0 && first <= 0xf4 ? 3 : 0;
+                if (!extra || extra > text.size() - i) return false;
+                const auto second = static_cast<unsigned char>(text[i]);
+                if ((first == 0xe0 && second < 0xa0) || (first == 0xed && second >= 0xa0) ||
+                    (first == 0xf0 && second < 0x90) || (first == 0xf4 && second >= 0x90)) return false;
+                for (size_t j = 0; j < extra; ++j) {
+                    const auto continuation = static_cast<unsigned char>(text[i++]);
+                    if (continuation < 0x80 || continuation > 0xbf) return false;
+                }
+            }
+            return true;
+        }
+
+        void appendJsonEscape(std::string &escaped, std::string_view text) {
+            static constexpr char hex[] = "0123456789abcdef";
+            for (const unsigned char character : text) {
+                switch (character) {
+                case '"': escaped += "\\\""; break;
+                case '\\': escaped += "\\\\"; break;
+                case '\b': escaped += "\\b"; break;
+                case '\f': escaped += "\\f"; break;
+                case '\n': escaped += "\\n"; break;
+                case '\r': escaped += "\\r"; break;
+                case '\t': escaped += "\\t"; break;
+                default:
+                    if (character < 0x20) {
+                        escaped += "\\u00";
+                        escaped += hex[character >> 4];
+                        escaped += hex[character & 15];
+                    }
+                    else {
+                        escaped += char(character);
+                    }
+                    break;
+                }
+            }
+
+        }
+
+        std::string jsonEscape(std::string_view text) {
+            std::string escaped;
+            escaped.reserve(text.size());
+            appendJsonEscape(escaped, text);
+            return escaped;
+        }
+
+        void appendTraceInteger(std::string &line, uint64_t value) {
+            char buffer[32];
+            const auto converted = std::to_chars(buffer, buffer + sizeof(buffer), value);
+            line.append(buffer, converted.ptr);
+        }
+
+        void appendTraceMicroseconds(std::string &line, uint64_t nanoseconds) {
+            appendTraceInteger(line, nanoseconds / 1000);
+            line += '.';
+            const uint32_t fraction = uint32_t(nanoseconds % 1000);
+            line += char('0' + fraction / 100);
+            line += char('0' + (fraction / 10) % 10);
+            line += char('0' + fraction % 10);
+        }
+
+        void appendTraceCounter(std::string &line, double value) {
+            char buffer[64];
+            const auto converted = std::to_chars(buffer, buffer + sizeof(buffer), value,
+                std::chars_format::general, std::numeric_limits<double>::max_digits10);
+            if (converted.ec == std::errc{} && std::isfinite(value)) line.append(buffer, converted.ptr);
+            else line += "null";
+        }
