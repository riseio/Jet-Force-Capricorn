index 0000000..ecdaa44
--- /dev/null
+++ b/src/hle/rt64_save_state.cpp
@@ -0,0 +1,580 @@
+#include "rt64_save_state.h"
+#include "rt64_state_codec.h"
+#include "rt64_application.h"
+#include "rt64_state.h"
+#include "render/rt64_state_texture.h"
+#include <algorithm>
+#include <cmath>
+#include <zstd.h>
+
+namespace RT64 {
+namespace {
+using StateIO::check;
+constexpr uint32_t RamBytes = 8 * 1024 * 1024;
+template<class A> void rect(A &a, FixedRect &r) { a.fields(r.ulx, r.uly, r.lrx, r.lry); }
+template<class A, class V> void vector2(A &a, V &v) {
+    auto x = v[0], y = v[1]; a.fields(x, y);
+    if constexpr (A::reading) v = {x, y};
+}
+template<class A> void vector3(A &a, hlslpp::float3 &v) {
+    float x = v[0], y = v[1], z = v[2]; a.fields(x, y, z);
+    check(std::isfinite(x) && std::isfinite(y) && std::isfinite(z), "Non-finite saved renderer vector");
+    if constexpr (A::reading) v = {x, y, z};
+}
+template<class A> void vector4(A &a, hlslpp::float4 &v) {
+    float x = v[0], y = v[1], z = v[2], w = v[3]; a.fields(x, y, z, w);
+    check(std::isfinite(x) && std::isfinite(y) && std::isfinite(z) && std::isfinite(w), "Non-finite saved renderer color");
+    if constexpr (A::reading) v = {x, y, z, w};
+}
+template<class A> void tile(A &a, LoadTile &t) {
+    a.fields(t.fmt, t.siz, t.line, t.tmem, t.palette, t.cms, t.cmt, t.masks,
+        t.maskt, t.shifts, t.shiftt, t.uls, t.ult, t.lrs, t.lrt);
+    check(t.fmt <= 4 && t.siz <= 3 && t.tmem < 512 && t.line < 512 &&
+        t.palette < 16 && t.cms < 4 && t.cmt < 4 && t.masks < 16 && t.maskt < 16 &&
+        t.shifts < 16 && t.shiftt < 16, "Invalid saved RDP tile");
+}
+template<class A> void loadTexture(A &a, LoadTexture &t) {
+    a.fields(t.address, t.fmt, t.siz, t.width);
+    check(t.address <= 0xFFFFFF && t.fmt <= 4 && t.siz <= 3, "Invalid saved RDP texture image");
+}
+template<class A> void loadOperation(A &a, LoadOperation &o) {
+    a.scalar(o.type); tile(a, o.tile); loadTexture(a, o.texture);
+    switch (o.type) {
+    case LoadOperation::Type::Tile:
+        a.fields(o.operationTile.tile, o.operationTile.uls, o.operationTile.ult, o.operationTile.lrs, o.operationTile.lrt);
+        check(o.operationTile.tile < 8, "Invalid saved RDP load tile index"); break;
+    case LoadOperation::Type::Block:
+        a.fields(o.operationBlock.tile, o.operationBlock.uls, o.operationBlock.ult, o.operationBlock.lrs, o.operationBlock.dxt);
+        check(o.operationBlock.tile < 8, "Invalid saved RDP load block index"); break;
+    case LoadOperation::Type::TLUT:
+        a.fields(o.operationTLUT.tile, o.operationTLUT.uls, o.operationTLUT.ult, o.operationTLUT.lrs, o.operationTLUT.lrt);
+        check(o.operationTLUT.tile < 8, "Invalid saved RDP palette index"); break;
+    default: throw std::runtime_error("Invalid saved RDP load operation");
+    }
+}
+template<class A> void alignment(A &a, ExtendedAlignment &v) {
+    a.fields(v.leftOrigin, v.rightOrigin, v.leftOffset, v.topOffset, v.rightOffset,
+        v.bottomOffset, v.leftBound, v.topBound, v.rightBound, v.bottomBound);
+}
+template<class A> void rdpState(A &a, RDP &r) {
+    for (auto &v : r.TMEM) a.scalar(v);
+    loadTexture(a, r.texture);
+    for (auto &v : r.tiles) tile(a, v);
+    for (auto &v : r.tileReplacementHashes) a.scalar(v);
+    a.fields(r.colorImage.address, r.colorImage.fmt, r.colorImage.siz, r.colorImage.width,
+        r.colorImage.changed, r.depthImage.address, r.depthImage.changed);
+    check(r.colorImage.address <= 0xFFFFFF && r.depthImage.address <= 0xFFFFFF &&
+        r.colorImage.fmt <= 4 && r.colorImage.siz <= 3, "Invalid saved RDP framebuffer image");
+    alignment(a, r.extended.global.rect); alignment(a, r.extended.global.scissor);
+    a.scalar(r.extended.global.rectAspect);
+    auto &f = r.extended.drawExtendedFlags;
+    uint32_t up = f.forceUpscale2D, bilerp = f.forceTrueBilerp, lod = f.forceScaleLOD,
+        scale = f.drawScale, horizontal = f.drawScaleHorizontalOrigin, vertical = f.drawScaleVerticalOrigin;
+    a.fields(up, bilerp, lod, scale, horizontal, vertical);
+    check(up < 2 && bilerp < 4 && lod < 2 && scale < 512 && horizontal < 4096 && vertical < 4,
+        "Invalid saved RDP extended flags");
+    if constexpr (A::reading) {
+        f.forceUpscale2D = up; f.forceTrueBilerp = bilerp; f.forceScaleLOD = lod;
+        f.drawScale = scale; f.drawScaleHorizontalOrigin = horizontal; f.drawScaleVerticalOrigin = vertical;
+    }
+    for (auto &v : r.rice.lastLoadOpByTMEM) loadOperation(a, v);
+    a.fields(r.otherMode.L, r.otherMode.H);
+    auto stack = [&](int &size, auto visit) {
+        a.scalar(size); check(size >= 1 && size <= RDP_EXTENDED_STACK_SIZE, "Invalid saved RDP stack size");
+        for (int i = 0; i < size; ++i) visit(i);
+    };
+    stack(r.colorCombinerStackSize, [&](int i) { a.fields(r.colorCombinerStack[i].L, r.colorCombinerStack[i].H); });
+    stack(r.envColorStackSize, [&](int i) { vector4(a, r.envColorStack[i]); });
+    stack(r.primColorStackSize, [&](int i) { vector4(a, r.primColorStack[i]); vector2(a, r.primLODStack[i]); });
+    stack(r.primDepthStackSize, [&](int i) { vector2(a, r.primDepthStack[i]); });
+    stack(r.blendColorStackSize, [&](int i) { vector4(a, r.blendColorStack[i]); });
+    stack(r.fogColorStackSize, [&](int i) { vector4(a, r.fogColorStack[i]); });
+    stack(r.fillColorStackSize, [&](int i) { a.scalar(r.fillColorStack[i]); });
+    stack(r.scissorStackSize, [&](int i) {
+        rect(a, r.scissorRectStack[i]); a.fields(r.scissorModeStack[i],
+            r.extended.scissorLeftOriginStack[i], r.extended.scissorRightOriginStack[i]);
+        check(r.scissorModeStack[i] <= 3, "Invalid saved RDP scissor mode");
+    });
+    for (auto &v : r.convertK) a.scalar(v);
+    vector3(a, r.keyCenter); vector3(a, r.keyScale);
+    a.fields(r.pendingCommandCurrentBytes, r.pendingCommandRemainingBytes);
+    check(r.pendingCommandCurrentBytes <= 256 && r.pendingCommandRemainingBytes <= 256 - r.pendingCommandCurrentBytes,
+        "Invalid saved partial RDP command");
+    for (uint32_t i = 0; i < r.pendingCommandCurrentBytes; ++i) a.scalar(r.pendingCommandBuffer[i]);
+    a.fields(r.rectBatchActive, r.drawSuppressed, r.modernLightingScene, r.crashed, r.crashReason);
+    check(!r.crashed && r.crashReason == RDP::CrashReason::None, "Cannot restore crashed RDP state");
+}
+template<class A> void vi(A &a, VI &v) {
+    a.fields(v.status.word, v.origin, v.width, v.intr, v.vCurrentLine, v.burst.word,
+        v.vSync, v.hSync.word, v.leap.word, v.hRegion.word, v.vRegion.word, v.vBurst.word,
+        v.xTransform.word, v.yTransform.word);
+    if (v.visible()) {
+        check((v.status.type == VI_STATUS_TYPE_16_BIT || v.status.type == VI_STATUS_TYPE_32_BIT) &&
+            v.width > 0 && v.width <= 4096 && v.xTransform.xScale && v.yTransform.yScale &&
+            v.hRegion.hEnd > v.hRegion.hStart && v.vRegion.vEnd > v.vRegion.vStart,
+            "Invalid saved visible VI geometry");
+        const auto size = v.fbSize();
+        check(v.fbAddress() < RamBytes && size[0] <= 4096 && size[1] <= 4096 &&
+            (uint64_t(size[0]) * size[1] << (v.fbSiz() - 1)) <= RamBytes - v.fbAddress(),
+            "Saved VI extends outside game RAM");
+    }
+}
+template<class A> void history(A &a, VIHistory &h) {
+    for (auto &v : h.history) { vi(a, v.vi); a.scalar(v.fbWidth); }
+    for (auto &v : h.factors) a.scalar(v);
+    a.fields(h.historyCursor, h.factorCursor, h.logicalRate);
+    check(h.historyCursor >= 0 && h.historyCursor < 3 && h.factorCursor >= 0 && h.factorCursor < 3,
+        "Invalid saved VI history cursor");
+}
+template<class A> void sampling(A &a, RenderMultisampling &v) {
+    a.fields(v.sampleCount, v.sampleLocationsEnabled);
+    check(v.sampleCount == 1 || v.sampleCount == 2 || v.sampleCount == 4 || v.sampleCount == 8,
+        "Invalid saved GPU sample count");
+    for (uint32_t i = 0; i < v.sampleCount; ++i) {
+        a.fields(v.sampleLocations[i].x, v.sampleLocations[i].y);
+        check(v.sampleLocations[i].x >= -8 && v.sampleLocations[i].x <= 7 &&
+            v.sampleLocations[i].y >= -8 && v.sampleLocations[i].y <= 7, "Invalid saved sample location");
+    }
+}
+RenderShaderFormat shaderFormat(State &s) { return s.ext.app->renderInterface->getCapabilities().shaderFormat; }
+template<class A> void textureImage(A &a, State &s, std::unique_ptr<RenderTexture> &texture,
+        uint32_t width, uint32_t height, RenderFormat format, const RenderMultisampling &ms,
+        RenderTextureFlags flags = RenderTextureFlag::NONE) {
+    bool exists = texture != nullptr; a.scalar(exists);
+    if (!exists) return;
+    StateTexture image;
+    auto *worker = s.ext.framebufferGraphicsWorker;
+    if constexpr (!A::reading) image = captureStateTexture(worker, shaderFormat(s), texture.get(), width, height, format, ms);
+    else { image.width = width; image.height = height; image.format = format; image.multisampling = ms;
+        a.gpuBytes(uint64_t(width) * height * ms.sampleCount * (format == RenderFormat::R16G16B16A16_UNORM ? 8 : 4)); }
+    const auto n = StateIO::count(a, image.blocks.size(), 8192);
+    if constexpr (A::reading) image.blocks.resize(n);
+    for (auto &block : image.blocks) a.bytes(block);
+    if constexpr (A::reading) texture = prepareStateTexture(worker, shaderFormat(s), image, flags);
+}
+void executeCopy(RenderWorker *worker) {
+    worker->commandList->end();
+    check(worker->execute() != 0, "Renderer state buffer submission failed");
+    worker->waitIfPending();
+}
+template<class A> void bufferImage(A &a, State &s, std::unique_ptr<RenderBuffer> &buffer,
+        uint32_t &bytes, bool readback) {
+    a.scalar(bytes); check(bytes <= RamBytes, "Invalid native framebuffer buffer size");
+    if (!bytes) return;
+    auto *worker = s.ext.framebufferGraphicsWorker;
+    std::vector<uint8_t> packed;
+    if constexpr (!A::reading) {
+        check(buffer != nullptr, "Native framebuffer buffer has no owner");
+        std::unique_ptr<RenderBuffer> copy;
+        RenderBuffer *source = buffer.get();
+        if (!readback) {
+            copy = worker->device->createBuffer(RenderBufferDesc::ReadbackBuffer(bytes));
+            check(copy != nullptr, "Cannot allocate native framebuffer snapshot");
+            worker->commandList->begin();
+            const RenderBufferBarrier barriers[] = {{buffer.get(), RenderBufferAccess::READ}, {copy.get(), RenderBufferAccess::WRITE}};
+            worker->commandList->barriers(RenderBarrierStage::COPY, barriers, 2);
+            worker->commandList->copyBufferRegion(copy.get(), buffer.get(), bytes);
+            executeCopy(worker); source = copy.get();
+        }
+        packed.resize(ZSTD_compressBound(bytes));
+        const RenderRange range{0, bytes};
+        const auto data = source->map(0, &range);
+        check(data != nullptr, "Cannot map native framebuffer snapshot");
+        const auto size = ZSTD_compress(packed.data(), packed.size(), data, bytes, 1);
+        source->unmap();
+        check(!ZSTD_isError(size), "Cannot compress native framebuffer state");
+        packed.resize(size);
+    }
+    a.bytes(packed);
+    if constexpr (A::reading) {
+        a.gpuBytes(bytes);
+        check(ZSTD_getFrameContentSize(packed.data(), packed.size()) == bytes &&
+            ZSTD_findFrameCompressedSize(packed.data(), packed.size()) == packed.size(), "Invalid native framebuffer compressed extent");
+        std::vector<uint8_t> decoded(bytes);
+        check(ZSTD_decompress(decoded.data(), bytes, packed.data(), packed.size()) == bytes, "Corrupt native framebuffer state");
+        buffer = worker->device->createBuffer(readback ? RenderBufferDesc::ReadbackBuffer(bytes) :
+            RenderBufferDesc::DefaultBuffer(bytes, RenderBufferFlag::STORAGE | RenderBufferFlag::UNORDERED_ACCESS | RenderBufferFlag::FORMATTED));
+        auto upload = worker->device->createBuffer(RenderBufferDesc::UploadBuffer(bytes));
+        check(buffer && upload, "Cannot allocate restored native framebuffer buffer");
+        auto data = upload->map(); check(data != nullptr, "Cannot map native framebuffer upload");
+        std::memcpy(data, decoded.data(), bytes); upload->unmap();
+        worker->commandList->begin();
+        worker->commandList->barriers(RenderBarrierStage::COPY, RenderBufferBarrier(buffer.get(), RenderBufferAccess::WRITE));
+        worker->commandList->copyBufferRegion(buffer.get(), upload.get(), bytes);
+        executeCopy(worker);
+    }
+}
+template<class A> void nativeTarget(A &a, State &s, NativeTarget &n) {
+    a.fields(n.readBufferHistoryCount, n.writeBufferHistoryCount, n.writeBufferHistoryIndex);
+    check(n.readBufferHistoryCount <= 4096 && n.writeBufferHistoryCount <= 4096 &&
+        n.writeBufferHistoryIndex <= n.writeBufferHistoryCount, "Invalid saved native buffer history");
+    if constexpr (A::reading) { n.readBufferHistory.resize(n.readBufferHistoryCount); n.writeBufferHistory.resize(n.writeBufferHistoryCount); }
+    else check(n.readBufferHistoryCount <= n.readBufferHistory.size() && n.writeBufferHistoryCount <= n.writeBufferHistory.size(),
+        "Native buffer history exceeds owned resources");
+    for (uint32_t i = 0; i < n.readBufferHistoryCount; ++i)
+        bufferImage(a, s, n.readBufferHistory[i].nativeBuffer, n.readBufferHistory[i].nativeBufferSize, false);
+    for (uint32_t i = 0; i < n.writeBufferHistoryCount; ++i)
+        bufferImage(a, s, n.writeBufferHistory[i].nativeReadbackBuffer, n.writeBufferHistory[i].nativeReadbackBufferSize, true);
+
+}
+
+template<class A> void quantizationHistory(A &a, FramebufferManager &frames) {
+    const auto count = StateIO::count(a, frames.framebuffers.size(), 4096);
+    check(count == frames.framebuffers.size(), "Saved quantization owner count mismatch");
+    auto conversion = [&](NativeTarget &n) {
+        a.scalar(n.legacyQuantizationHistory);
+        a.scalar(n.quantizationWidth);
+        const auto rows = StateIO::count(a, n.colorQuantizationRows.size(), 16384);
+        check(n.quantizationWidth <= 16384 && (rows == 0 || n.quantizationWidth != 0),
+            "Invalid saved quantization extent");
+        if constexpr (A::reading) n.colorQuantizationRows.resize(rows);
+        for (auto &row : n.colorQuantizationRows) {
+            a.fields(row.pattern, row.seed);
+            check(row.pattern <= 3 || row.pattern == UINT32_MAX, "Invalid saved quantization pattern");
+        }
+        for (uint32_t i = 0; i < n.writeBufferHistoryCount; ++i) {
+            auto &buffer = n.writeBufferHistory[i];
+            a.fields(buffer.ditherPattern, buffer.ditherRandomSeed);
+            check(buffer.ditherPattern <= 3 ||
+                (n.legacyQuantizationHistory && buffer.ditherPattern == UINT32_MAX),
+                "Invalid saved native write conversion");
+        }
+    };
+    if constexpr (A::reading) {
+        std::vector<uint32_t> seen;
+        seen.reserve(count);
+        for (uint32_t i = 0; i < count; ++i) {
+            uint32_t address; a.scalar(address);
+            auto found = frames.framebuffers.find(address);
+            check(found != frames.framebuffers.end(), "Unknown saved quantization owner");
+            seen.push_back(address);
+            conversion(found->second.nativeTarget);
+        }
+        std::sort(seen.begin(), seen.end());
+        check(std::adjacent_find(seen.begin(), seen.end()) == seen.end(), "Duplicate saved quantization owner");
+    } else {
+        for (auto &pair : frames.framebuffers) {
+            a.scalar(pair.first);
+            conversion(pair.second.nativeTarget);
+        }
+    }
+}
+
+template<class A> void framebufferTile(A &a, FramebufferTile &t) {
+    a.fields(t.address, t.siz, t.fmt, t.left, t.top, t.right, t.bottom, t.lineWidth, t.ditherPattern);
+    check(t.address < RamBytes && t.siz <= 3 && t.fmt <= 5 && t.right <= 16384 && t.bottom <= 16384 &&
+        t.left <= t.right && t.top <= t.bottom && t.lineWidth <= 16384 && t.ditherPattern < 4,
+        "Invalid saved framebuffer tile");
+}
+template<class A> void framebuffer(A &a, State &s, Framebuffer &f) {
+    a.fields(f.addressStart, f.addressEnd, f.siz, f.width, f.height, f.maxHeight, f.readHeight);
+    check(f.addressStart < RamBytes && f.addressEnd <= RamBytes && f.addressStart <= f.addressEnd && f.siz <= 3 &&
+        f.width > 0 && f.width <= 16384 && f.height <= 16384 && f.maxHeight <= 16384 && f.readHeight <= 16384 &&
+        (uint64_t(f.width) << f.siz >> 1) * f.height == f.addressEnd - f.addressStart,
+        "Invalid saved framebuffer RAM extent");
+    rect(a, f.lastWriteRect);
+    a.fields(f.lastWriteFmt, f.lastWriteType, f.lastWriteTimestamp, f.modifiedBytes, f.RAMBytes, f.RAMHash);
+    check(f.RAMBytes <= RamBytes - f.addressStart && f.lastWriteFmt <= 5 &&
+        f.lastWriteType >= Framebuffer::Type::None && f.lastWriteType <= Framebuffer::Type::Depth,
+        "Invalid saved framebuffer metadata");
+    for (auto &v : f.ditherPatterns) a.scalar(v);
+    a.fields(f.widthChanged, f.sizChanged, f.rdramChanged, f.interpolationEnabled, f.everUsedAsDepth);
+
+    nativeTarget(a, s, f.nativeTarget);
+    a.fields(f.tileCopyCache.usedTimestamp, f.tileCopyCache.writeTimestamp);
+    const auto count = StateIO::count(a, f.tileCopyCache.tileCopies.size(), 65536);
+    if constexpr (A::reading) {
+        for (uint32_t i = 0; i < count; ++i) {
+            FramebufferTile t{}; uint64_t id = 0; framebufferTile(a, t); a.scalar(id);
+            check(f.tileCopyCache.tileCopies.emplace(t, id).second, "Duplicate saved framebuffer tile cache entry");
+        }
+    } else for (auto &pair : f.tileCopyCache.tileCopies) { auto key = pair.first; framebufferTile(a, key); a.scalar(pair.second); }
+}
+template<class A> void targetKey(A &a, RenderTargetKey &k) {
+    a.fields(k.address, k.width, k.siz, k.fbType);
+    check(k.address < RamBytes && k.width <= 16384 && k.siz <= 3 &&
+        (k.fbType == Framebuffer::Type::Color || k.fbType == Framebuffer::Type::Depth), "Invalid saved render target key");
+}
+template<class A> void target(A &a, State &s, RenderTarget &t) {
+    a.fields(t.width, t.height, t.textureRevision, t.downsampleMultiplier, t.misalignX, t.invMisalignX);
+    vector2(a, t.resolutionScale);
+    check(t.width <= 16384 && t.height <= 16384 && t.downsampleMultiplier >= 1 && t.downsampleMultiplier <= 16384 &&
+        std::isfinite(float(t.resolutionScale[0])) && std::isfinite(float(t.resolutionScale[1])) &&
+        t.resolutionScale[0] > 0 && t.resolutionScale[1] > 0, "Invalid saved render target geometry");
+    textureImage(a, s, t.texture, t.width, t.height, t.format, t.multisampling);
+    if constexpr (A::reading) {
+        if (t.texture) {
+            t.textureView = t.texture->createTextureView(RenderTextureViewDesc::Texture2D(t.format));
+            check(t.textureView != nullptr, "Cannot create restored target view");
+            if (t.type == Framebuffer::Type::Color && t.multisampling.sampleCount > 1) {
+                a.gpuBytes(uint64_t(t.width) * t.height * (t.usesHDR ? 8 : 4));
+                t.resolvedTexture = s.ext.device->createTexture(RenderTextureDesc::ColorTarget(t.width, t.height, t.format));
+                check(t.resolvedTexture != nullptr, "Cannot allocate restored resolve target");
+                t.resolvedTextureView = t.resolvedTexture->createTextureView(RenderTextureViewDesc::Texture2D(t.format));
+                check(t.resolvedTextureView != nullptr, "Cannot create restored resolve view");
+                t.resolvedTextureDirty = true;
+            }
+        }
+    }
+}
+template<class A> void managers(A &a, State &s, RenderTargetManager &targets, FramebufferManager &frames) {
+    sampling(a, targets.multisampling); a.scalar(targets.usesHDR);
+    check(targets.overrideMap.empty(), "Cannot save temporary render target overrides");
+    a.fields(frames.usedTimestamp, frames.writeTimestamp);
+    auto count = StateIO::count(a, targets.targetMap.size(), 4096);
+    auto makeTarget = [&](RenderTargetKey key) {
+        auto t = std::make_unique<RenderTarget>(key.address, key.fbType, targets.multisampling, targets.usesHDR);
+        t->format = key.fbType == Framebuffer::Type::Depth ? RenderTarget::depthBufferFormat() : RenderTarget::colorBufferFormat(targets.usesHDR);
+        return t;
+    };
+    if constexpr (A::reading) {
+        for (uint32_t i = 0; i < count; ++i) {
+            RenderTargetKey k; targetKey(a, k); auto t = makeTarget(k); target(a, s, *t);
+            check(targets.targetMap.emplace(k, std::move(t)).second, "Duplicate saved render target");
+        }
+    } else for (auto &pair : targets.targetMap) { auto key = pair.first; targetKey(a, key); target(a, s, *pair.second); }
+    count = StateIO::count(a, frames.framebuffers.size(), 4096);
+    if constexpr (A::reading) {
+        for (uint32_t i = 0; i < count; ++i) {
+            uint32_t key = 0; a.scalar(key); auto entry = frames.framebuffers.try_emplace(key);
+            check(entry.second, "Duplicate saved framebuffer"); framebuffer(a, s, entry.first->second);
+            check(key == entry.first->second.addressStart, "Saved framebuffer key mismatch");
+        }
+    } else for (auto &pair : frames.framebuffers) { a.scalar(pair.first); framebuffer(a, s, pair.second); }
+    auto tileCopy = [&](FramebufferManager::TileCopy &t) {
+        a.fields(t.id, t.textureWidth, t.textureHeight, t.address, t.left, t.top, t.usedWidth,
+            t.usedHeight, t.usedTimestamp, t.ulScaleS, t.ulScaleT, t.ditherPattern, t.sampleScale,
+            t.readColorFromStorage, t.readDepthFromStorage, t.needsDiscard, t.ignore);
+        vector2(a, t.texelShift); vector2(a, t.texelMask); vector2(a, t.ditherOffset);
+        check(t.textureWidth <= 16384 && t.textureHeight <= 16384 && t.usedWidth <= t.textureWidth &&
+            t.usedHeight <= t.textureHeight && std::isfinite(t.sampleScale) && t.sampleScale > 0,
+            "Invalid saved GPU tile geometry");
+        textureImage(a, s, t.texture, t.textureWidth, t.textureHeight, RenderTarget::colorBufferFormat(targets.usesHDR),
+            RenderMultisampling(), RenderTextureFlag::STORAGE | RenderTextureFlag::UNORDERED_ACCESS);
+    };
+    count = StateIO::count(a, frames.tileCopies.size(), 65536);
+    if constexpr (A::reading) {
+        for (uint32_t i = 0; i < count; ++i) {
+            uint64_t key = 0; a.scalar(key); auto entry = frames.tileCopies.try_emplace(key);
+            check(entry.second && key != 0, "Duplicate or zero saved GPU tile ID");
+            tileCopy(entry.first->second); check(key == entry.first->second.id, "Saved GPU tile ID mismatch");
+        }
+    } else for (auto &pair : frames.tileCopies) { a.scalar(pair.first); tileCopy(pair.second); }
+    count = StateIO::count(a, frames.activeRegionsTMEM.size(), 4096);
+    if constexpr (A::reading) frames.activeRegionsTMEM.resize(count);
+    for (auto &region : frames.activeRegionsTMEM) {
+        a.fields(region.tmemStart, region.tmemEnd, region.tileCopyId, region.syncRequired);
+        framebufferTile(a, region.fbTile);
+        check(region.tmemStart <= region.tmemEnd && region.tmemEnd <= RDP_TMEM_WORDS &&
+            (region.tileCopyId == 0 || frames.tileCopies.count(region.tileCopyId)), "Invalid saved TMEM framebuffer reference");
+    }
+    auto reinterpretKey = [&](ReinterpretTileKey &k) {
+        a.fields(k.tmemHashOrID, k.tlutHash, k.srcSiz, k.srcFmt, k.dstSiz, k.dstFmt, k.ulScaleS,
+            k.ulScaleT, k.texelShiftX, k.texelShiftY, k.texelMaskX, k.texelMaskY, k.tlutFormat);
+        check(k.srcSiz <= 3 && k.dstSiz <= 3 && k.srcFmt <= 5 && k.dstFmt <= 5 && k.tlutFormat <= 3,
+            "Invalid saved tile reinterpretation key");
+    };
+    count = StateIO::count(a, frames.reinterpretTileCache.size(), 65536);
+    if constexpr (A::reading) {
+        for (uint32_t i = 0; i < count; ++i) {
+            ReinterpretTileKey k; uint64_t id = 0; reinterpretKey(k); a.scalar(id);
+            check(frames.tileCopies.count(id) && frames.reinterpretTileCache.emplace(k, id).second,
+                "Invalid saved tile reinterpretation reference");
+        }
+    } else for (auto &pair : frames.reinterpretTileCache) { auto k = pair.first; reinterpretKey(k); a.scalar(pair.second); }
+    for (auto &pair : frames.framebuffers) for (auto &cache : pair.second.tileCopyCache.tileCopies)
+        check(frames.tileCopies.count(cache.second) != 0, "Saved framebuffer cache references missing GPU tile");
+}
+
+struct CoreState {
+    Microcode microcode{};
+    State::Extended extended{};
+    uint32_t ditherRandomSeed = 0;
+    uint64_t displayListCounter = 0;
+    uint32_t displayListAddress = 0;
+    bool rdramCheckPending = false;
+    bool displayListRepresentsGameFrame = true;
+    uint16_t displayListRefreshRate = UINT16_MAX;
+    VI lastScreenVI{};
+    uint64_t lastScreenHash = 0;
+    uint32_t lastScreenFactorCounter = 0;
+    VIHistory viHistory, presentHistory;
+    uint32_t sharedOriginalRate = 0;
+    uint32_t nativeFrameCount = 0, enhancedFrameCount = 0;
+    std::array<uint32_t, 9> regs{};
+    std::array<uint8_t, 8192> rspMemory{};
+};
+std::array<uint32_t*, 9> registers(State &s) {
+    auto &c = s.ext.app->core;
+    return {c.MI_INTR_REG, c.DPC_START_REG, c.DPC_END_REG, c.DPC_CURRENT_REG, c.DPC_STATUS_REG,
+        c.DPC_CLOCK_REG, c.DPC_BUFBUSY_REG, c.DPC_PIPEBUSY_REG, c.DPC_TMEM_REG};
+}
+CoreState captureCore(State &s) {
+    CoreState c;
+    c.microcode = s.microcode; c.extended = s.extended; c.ditherRandomSeed = s.ditherRandomSeed;
+    c.displayListCounter = s.displayListCounter; c.displayListAddress = s.displayListAddress;
+    c.rdramCheckPending = s.rdramCheckPending; c.displayListRepresentsGameFrame = s.displayListRepresentsGameFrame;
+    c.displayListRefreshRate = s.displayListRefreshRate; c.lastScreenVI = s.lastScreenVI;
+    c.lastScreenHash = s.lastScreenHash; c.lastScreenFactorCounter = s.lastScreenFactorCounter;
+    c.viHistory = s.viHistory; c.presentHistory = s.ext.presentQueue->viHistory;
+    c.sharedOriginalRate = s.ext.sharedQueueResources->viOriginalRate;
+    c.nativeFrameCount = s.framebufferRenderer->frameParams.frameCount;
+    c.enhancedFrameCount = s.ext.workloadQueue->framebufferRenderer->frameParams.frameCount;
+    const auto regs = registers(s);
+    for (size_t i = 0; i < regs.size(); ++i) c.regs[i] = *regs[i];
+    std::memcpy(c.rspMemory.data(), s.ext.app->core.DMEM, 4096);
+    std::memcpy(c.rspMemory.data() + 4096, s.ext.app->core.IMEM, 4096);
+    return c;
+}
+template<class A> void coreState(A &a, CoreState &c) {
+    a.fields(c.microcode.half1, c.microcode.half2, c.extended.refreshRate, c.extended.renderToRAM,
+        c.extended.vertexTestZActive, c.extended.ditherNoiseStrength, c.extended.extendRDRAM);
+    vector2(a, c.extended.texcoordWrapPoint);
+    a.fields(c.ditherRandomSeed, c.displayListCounter, c.displayListAddress, c.rdramCheckPending,
+        c.displayListRepresentsGameFrame, c.displayListRefreshRate, c.lastScreenHash, c.lastScreenFactorCounter);
+    vi(a, c.lastScreenVI); history(a, c.viHistory); history(a, c.presentHistory); a.scalar(c.sharedOriginalRate);
+    a.fields(c.nativeFrameCount, c.enhancedFrameCount);
+    for (auto &v : c.regs) a.scalar(v);
+    for (auto &v : c.rspMemory) a.scalar(v);
+    check(!c.extended.extendRDRAM, "Extended renderer RAM is not part of this game state ABI");
+    check(std::isfinite(c.extended.ditherNoiseStrength) &&
+        std::isfinite(float(c.extended.texcoordWrapPoint[0])) && std::isfinite(float(c.extended.texcoordWrapPoint[1])) &&
+        c.extended.texcoordWrapPoint[0] > 0 && c.extended.texcoordWrapPoint[1] > 0,
+        "Invalid saved extended renderer parameters");
+}
+void validateCut(State &s) {
+    auto &w = s.ext.workloadQueue->workloads[s.ext.workloadQueue->writeCursor];
+    check(!s.cpuFramebufferPresentPending && !s.nextWorkloadPending &&
+        !s.taskCompleteCallback && s.returnAddressStack.empty() && s.drawCall.triangleCount == 0 &&
+        s.rdp->uiAlphaDepth == 0 &&
+        !s.hasFramebufferOperationsPending() && w.fbPairCount == 0 && w.gameCallCount == 0,
+        "Renderer has an unfinished display list at save-state boundary");
+    check(!s.debuggerInspector.paused && s.scriptLights.empty(),
+        "Exit renderer debugger/script execution before using game save states");
+}
+void swapManagers(RenderTargetManager &liveTargets, FramebufferManager &liveFrames,
+        RenderTargetManager &savedTargets, FramebufferManager &savedFrames) noexcept {
+    liveTargets.targetMap.swap(savedTargets.targetMap);
+    liveFrames.framebuffers.swap(savedFrames.framebuffers);
+    liveFrames.tileCopies.swap(savedFrames.tileCopies);
+    liveFrames.activeRegionsTMEM.swap(savedFrames.activeRegionsTMEM);
+    liveFrames.reinterpretTileCache.swap(savedFrames.reinterpretTileCache);
+    std::swap(liveFrames.usedTimestamp, savedFrames.usedTimestamp);
+    std::swap(liveFrames.writeTimestamp, savedFrames.writeTimestamp);
+    for (auto &sets : liveFrames.descriptorReinterpretSets) sets.clear();
+    liveFrames.descriptorReinterpretSetsCount.fill(0);
+    liveFrames.scratchChangePool.reset();
+}
+}
+
+std::vector<uint8_t> captureRendererState(State &s) {
+    validateCut(s);
+    StateIO::Writer writer;
+    writer.fields(uint32_t(2));
+    auto core = captureCore(s); coreState(writer, core); rdpState(writer, *s.rdp);
+    managers(writer, s, s.renderTargetManager, s.framebufferManager);
+    managers(writer, s, s.ext.sharedQueueResources->renderTargetManager, s.ext.sharedQueueResources->framebufferManager);
+    quantizationHistory(writer, s.framebufferManager);
+    quantizationHistory(writer, s.ext.sharedQueueResources->framebufferManager);
+    return std::move(writer.data);
+}
+
+struct PreparedRendererState::Impl {
+    State &live;
+    CoreState core;
+    std::unique_ptr<RDP> rdp;
+    RenderTargetManager nativeTargets, enhancedTargets;
+    FramebufferManager nativeFrames, enhancedFrames;
+    explicit Impl(State &s) : live(s), rdp(std::make_unique<RDP>(&s)) { rdp->reset(); rdp->setGBI(); }
+};
+PreparedRendererState::PreparedRendererState(State &s, const std::vector<uint8_t> &image) : impl(std::make_unique<Impl>(s)) {
+    validateCut(s);
+    StateIO::Reader reader(image);
+    uint32_t version = 0; reader.scalar(version); check(version == 1 || version == 2, "Unsupported renderer state schema");
+    coreState(reader, impl->core); rdpState(reader, *impl->rdp);
+    managers(reader, s, impl->nativeTargets, impl->nativeFrames);
+    managers(reader, s, impl->enhancedTargets, impl->enhancedFrames);
+    if (version >= 2) {
+        quantizationHistory(reader, impl->nativeFrames);
+        quantizationHistory(reader, impl->enhancedFrames);
+    } else {
+        for (auto *frames : {&impl->nativeFrames, &impl->enhancedFrames}) {
+            for (auto &pair : frames->framebuffers) {
+                auto &native = pair.second.nativeTarget;
+                native.legacyQuantizationHistory = true;
+                for (auto &buffer : native.writeBufferHistory)
+                    buffer.ditherPattern = UINT32_MAX;
+            }
+        }
+    }
+    reader.end();
+    auto compatible = [](const RenderTargetManager &saved, const RenderTargetManager &live) {
+        check(saved.usesHDR == live.usesHDR && saved.multisampling.sampleCount == live.multisampling.sampleCount &&
+            saved.multisampling.sampleLocationsEnabled == live.multisampling.sampleLocationsEnabled,
+            "Restore requires the saved framebuffer precision and anti-aliasing setting");
+        for (uint32_t i = 0; i < saved.multisampling.sampleCount; ++i)
+            check(saved.multisampling.sampleLocations[i] == live.multisampling.sampleLocations[i],
+                "Restore requires the saved anti-aliasing sample pattern");
+    };
+    compatible(impl->nativeTargets, s.renderTargetManager);
+    compatible(impl->enhancedTargets, s.ext.sharedQueueResources->renderTargetManager);
+}
+PreparedRendererState::~PreparedRendererState() = default;
+
+void PreparedRendererState::commit() noexcept {
+    auto &s = impl->live;
+    auto &c = impl->core;
+    auto &shared = *s.ext.sharedQueueResources;
+    auto &queue = *s.ext.workloadQueue;
+
+    s.renderFramebufferManager->destroyAll(); queue.renderFramebufferManager->destroyAll();
+    swapManagers(s.renderTargetManager, s.framebufferManager, impl->nativeTargets, impl->nativeFrames);
+    swapManagers(shared.renderTargetManager, shared.framebufferManager, impl->enhancedTargets, impl->enhancedFrames);
+    s.rdp.swap(impl->rdp);
+    s.microcode = c.microcode; s.extended = c.extended; s.ditherRandomSeed = c.ditherRandomSeed;
+    s.displayListCounter = c.displayListCounter; s.displayListAddress = c.displayListAddress;
+    s.rdramCheckPending = c.rdramCheckPending; s.displayListRepresentsGameFrame = c.displayListRepresentsGameFrame;
+    s.displayListRefreshRate = c.displayListRefreshRate; s.lastScreenVI = c.lastScreenVI;
+    s.lastScreenHash = c.lastScreenHash; s.lastScreenFactorCounter = c.lastScreenFactorCounter;
+    s.viHistory = c.viHistory; s.ext.presentQueue->viHistory = c.presentHistory;
+    shared.viOriginalRate = c.sharedOriginalRate;
+    s.framebufferRenderer->frameParams.frameCount = c.nativeFrameCount;
+    queue.framebufferRenderer->frameParams.frameCount = c.enhancedFrameCount;
+    auto regs = registers(s);
+    for (size_t i = 0; i < regs.size(); ++i) *regs[i] = c.regs[i];
+    std::memcpy(s.ext.app->core.DMEM, c.rspMemory.data(), 4096);
+    std::memcpy(s.ext.app->core.IMEM, c.rspMemory.data() + 4096, 4096);
+    s.ext.interpreter->UCode = {UINT32_MAX, UINT32_MAX};
+    s.ext.interpreter->hleGBI = nullptr;
+    s.rsp->reset(); s.rsp->resetDKR();
+    s.resetDrawCall();
+    s.rdp->colorImage.changed = true; s.rdp->depthImage.changed = true;
+    s.addLightsOnFlush = false; s.activeSpriteCommand.replacementHash = 0;
+    s.differentFbs.clear();
+    s.resetExtendedGBI();
+
+    auto clearFrame = [](GameFrame &frame) {
+        frame.workloads.clear(); frame.frameMap.clear(); frame.perspectiveScenes.clear();
+        frame.orthographicScenes.clear(); frame.matched = false;
+    };
+    for (auto &frame : queue.gameFrames) clearFrame(frame);
+    clearFrame(queue.unmatchedGameFrame); queue.gameFrameHistory.reset();
+    for (auto &frames : shared.interpolatedFrames) frames = {};
+
+    for (auto &edges : shared.interpolatedTargetReadySemaphores) edges.clear();
+    for (auto &edges : shared.interpolatedTargetPresentedSemaphores) edges.clear();
+    for (auto &submissions : shared.interpolatedTargetSubmissions) submissions.clear();
+    for (auto &targets : shared.interpolatedColorTargets) targets.clear();
+    auto clearBindings = [](FramebufferRenderer &renderer) {
