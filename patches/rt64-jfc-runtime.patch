+        void copyEventName(Event &event, std::string_view name) {
+            if (name.empty() || name.size() >= event.name.size() || !validUTF8(name, false)) {
+                event.name[0] = '\0';
+                return;
+            }
+            const size_t count = std::min(name.size(), event.name.size() - 1);
+            std::copy_n(name.data(), count, event.name.data());
+            event.name[count] = '\0';
+        }
+
+        void updateSubmissionIntegrity(
+            ProfilerState &profiler,
+            const Event &event
+        ) {
+            const std::string_view name(event.name.data());
+            if (event.kind == EventKind::Instant &&
+                name == "Host.Context.World") {
+                const std::scoped_lock lock(
+                    profiler.submissionIntegrityMutex
+                );
+                SubmissionIntegrityTracker &tracker =
+                    profiler.submissionIntegrity;
+                tracker.worldContextActive = event.argument0 != 0u;
+                if (!tracker.worldContextActive) {
+                    tracker.consecutiveCollapsedSamples = 0u;
+                    tracker.collapseCandidateTimestamp = 0u;
+                    tracker.pendingSamples.clear();
+                }
+                return;
+            }
+
+            if (event.kind != EventKind::Counter ||
+                (name != "Work.DrawCalls" &&
+                 name != "Work.Triangles" &&
+                 name != "Work.SpecializedPipelines.World")) {
+                return;
+            }
+
+            const std::scoped_lock lock(profiler.submissionIntegrityMutex);
+            SubmissionIntegrityTracker &tracker = profiler.submissionIntegrity;
+            if (!tracker.worldContextActive) {
+                return;
+            }
+
+            if (tracker.pendingSamples.size() >= 4096 &&
+                tracker.pendingSamples.find(event.correlationId) == tracker.pendingSamples.end()) {
+                profiler.invalidEvents.fetch_add(1, std::memory_order_relaxed);
+                return;
+            }
+            SubmissionIntegritySample &sample =
+                tracker.pendingSamples[event.correlationId];
+            sample.timestampNanoseconds = std::max(
+                sample.timestampNanoseconds,
+                event.timestampNanoseconds
+            );
+            sample.correlationId = event.correlationId;
+            if (name == "Work.DrawCalls") {
+                sample.drawCalls = event.value;
+            }
+            else if (name == "Work.Triangles") {
+                sample.triangles = event.value;
+            }
+            else {
+                sample.worldPipelines = event.value;
+            }
+            if (sample.drawCalls < 0.0 || sample.triangles < 0.0 ||
+                sample.worldPipelines < 0.0) {
+                return;
+            }
+
+            const SubmissionIntegritySample completeSample = sample;
+            ++tracker.completeSamples;
+            tracker.pendingSamples.erase(event.correlationId);
+            const bool establishedWorld =
+                tracker.peakGameplayDrawCalls >= 128.0 &&
+                tracker.peakGameplayTriangles >= 1'024.0;
+            const bool drawCollapse = establishedWorld &&
+                completeSample.drawCalls <= std::max(
+                    16.0,
+                    tracker.peakGameplayDrawCalls * 0.05
+                );
+            const bool triangleCollapse =
+                completeSample.triangles <= std::max(
+                    128.0,
+                    tracker.peakGameplayTriangles * 0.05
+                );
+            const bool worldPipelineCollapse =
+                completeSample.worldPipelines <= 1.0;
+            if (drawCollapse && triangleCollapse && worldPipelineCollapse) {
+                if (tracker.consecutiveCollapsedSamples == 0u) {
+                    tracker.collapseCandidateTimestamp =
+                        completeSample.timestampNanoseconds;
+                    tracker.firstCollapsedSubmission = completeSample;
+                }
+                ++tracker.consecutiveCollapsedSamples;
+                ++tracker.collapsedSampleCount;
+                if (tracker.consecutiveCollapsedSamples >=
+                        RequiredCollapsedSubmissionSamples &&
+                    !tracker.collapseDetected) {
+                    tracker.collapseDetected = true;
+                    tracker.detectedCollapseTimestamp =
+                        tracker.collapseCandidateTimestamp;
+                    tracker.detectedHealthySubmission =
+                        tracker.lastHealthySubmission;
+                    tracker.detectedCollapsedSubmission =
+                        tracker.firstCollapsedSubmission;
+                }
+                return;
+            }
+
+            tracker.consecutiveCollapsedSamples = 0u;
+            tracker.collapseCandidateTimestamp = 0u;
+            if (completeSample.drawCalls >= 32.0) {
+                tracker.lastHealthySubmission = completeSample;
+                tracker.peakGameplayDrawCalls = std::max(
+                    tracker.peakGameplayDrawCalls,
+                    completeSample.drawCalls
+                );
+                tracker.peakGameplayTriangles = std::max(
+                    tracker.peakGameplayTriangles,
+                    completeSample.triangles
+                );
+            }
+        }
+
+        bool appendStreamedJournalEvent(
+            ProfilerState &profiler,
+            ThreadBuffer &buffer,
+            Event event
+        ) {
+
+            if (profiler.checkpointStarted.load(std::memory_order_acquire) &&
+                !profiler.checkpointRunning.load(std::memory_order_acquire)) {
+                buffer.droppedEvents.fetch_add(1, std::memory_order_relaxed);
+                return false;
+            }
+            const uint64_t timestamp = event.timestampNanoseconds;
+            const uint64_t write = buffer.streamWrite.load(std::memory_order_relaxed);
+            const uint64_t read = buffer.streamRead.load(std::memory_order_acquire);
+            if (write - read >= buffer.streamCapacity) {
+                buffer.droppedEvents.fetch_add(1, std::memory_order_relaxed);
+                return false;
+            }
+            buffer.streamEvents[write % buffer.streamCapacity] = event;
+            buffer.streamWrite.store(write + 1, std::memory_order_release);
+            uint64_t high = profiler.backlogHighWater.load(std::memory_order_relaxed);
+            const uint64_t size = write - read + 1;
+            while (size > high && !profiler.backlogHighWater.compare_exchange_weak(high, size, std::memory_order_relaxed)) {}
+            buffer.latestTimestampNanoseconds.store(
+                timestamp,
+                std::memory_order_release
+            );
+            buffer.streamedEventCount.fetch_add(1, std::memory_order_release);
+            return true;
+        }
+
+        void appendEvent(Event event, bool admittedAttachment = false) {
+            ProfilerState &profiler = state();
+            struct Lease {
+                ProfilerState &state;
+                explicit Lease(ProfilerState &s) : state(s) { state.activeWriters.fetch_add(1, std::memory_order_acq_rel); }
+                ~Lease() { state.activeWriters.fetch_sub(1, std::memory_order_release); }
+            } lease(profiler);
+            if (!profiler.accepting.load(std::memory_order_acquire)) {
+                return;
+            }
+            if (!std::isfinite(event.value) || event.name[0] == '\0') {
+                profiler.invalidEvents.fetch_add(1, std::memory_order_relaxed);
+                profiler.droppedEvents.fetch_add(1, std::memory_order_relaxed);
+                return;
+            }
+            if (!profiler.recording.load(std::memory_order_acquire) && !admittedAttachment) return;
+            event.producerSequence = nextProducerSequence();
+            if (profiler.passiveRing) {
+                const uint32_t id = passiveThreadId(profiler);
+                event.threadId = id;
+                event.osThreadId = nativeThreadId();
+                profiler.passiveRing->append(event);
+                return;
+            }
+
+            ThreadBuffer *buffer = threadBuffer();
+            if (buffer == nullptr) {
+                profiler.droppedEvents.fetch_add(1, std::memory_order_relaxed);
+                return;
+            }
+
+            event.threadId = passiveThreadId(profiler);
+            event.osThreadId = nativeThreadId();
+            if (profiler.incidentRing) profiler.incidentRing->append(event);
+            if (buffer->retentionExhausted) {
+                appendStreamedJournalEvent(
+                    profiler,
+                    *buffer,
+                    std::move(event)
+                );
+                return;
+            }
+
+            const uint64_t eventCount = buffer->eventCount.load(std::memory_order_relaxed);
+            const uint64_t chunkIndex = eventCount / EventChunkSize;
+            if (buffer->reservedEventsRemaining == 0) {
+                const uint64_t reservationStart = profiler.reservedEvents.fetch_add(
+                    EventChunkSize, std::memory_order_relaxed);
+                if (reservationStart >= profiler.maximumEvents || chunkIndex >= buffer->eventChunkCapacity) {
+                    buffer->retentionExhausted = true;
+                    appendStreamedJournalEvent(profiler, *buffer, std::move(event));
+                    return;
+                }
+                buffer->reservedEventsRemaining = std::min(EventChunkSize, profiler.maximumEvents - reservationStart);
+                buffer->eventChunks[chunkIndex].store(profiler.retainedArena.get() + reservationStart,
+                    std::memory_order_release);
+            }
+
+            Event *chunk = buffer->eventChunks[chunkIndex].load(
+                std::memory_order_acquire
+            );
+            if (chunk == nullptr) {
+                buffer->droppedEvents.fetch_add(
+                    1,
+                    std::memory_order_relaxed
+                );
+                return;
+            }
+            Event &destination = chunk[eventCount % EventChunkSize];
+            destination = std::move(event);
+            buffer->eventCount.store(
+                eventCount + 1,
+                std::memory_order_release
+            );
+            buffer->latestTimestampNanoseconds.store(
+                destination.timestampNanoseconds,
+                std::memory_order_release
+            );
+            --buffer->reservedEventsRemaining;
+        }
+
+        void appendCounterSample(std::string_view name, double value,
+            uint64_t correlationId) {
+            Event event;
+            copyEventName(event, name);
+            event.timestampNanoseconds = PerformanceProfiler::nowNanoseconds();
+            event.correlationId = correlationId;
+            event.value = value;
+            event.category = PerformanceCategory::Counter;
+            event.kind = EventKind::Counter;
+            appendEvent(std::move(event));
+        }
