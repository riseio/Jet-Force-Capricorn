+    static bool jfcWaterTraceEnabled() {
+        static const bool enabled = []() {
+            const char *value = std::getenv("JFC_WATER_TRACE");
+            return (value != nullptr) && (value[0] != '\0') &&
+                !((value[0] == '0') && (value[1] == '\0'));
+        }();
+
+        return enabled;
+    }
+
+    static bool jfcWaterTraceAllTwoCycle() {
+        static const bool enabled = []() {
+            const char *value = std::getenv("JFC_WATER_TRACE");
+            return (value != nullptr) && (std::strcmp(value, "all") == 0);
+        }();
+
+        return enabled;
+    }
+
+    static uint64_t jfcWaterTraceStartWorkload() {
+        static const uint64_t startWorkload = []() {
+            const char *value = std::getenv("JFC_WATER_TRACE_START_WORKLOAD");
+            if ((value == nullptr) || (value[0] == '\0')) {
+                return uint64_t(0);
+            }
+
+            char *end = nullptr;
+            const unsigned long long parsed = std::strtoull(value, &end, 10);
+            return ((end != value) && (end[0] == '\0')) ?
+                uint64_t(parsed) : uint64_t(0);
+        }();
+
+        return startWorkload;
+    }
+
+    static bool jfcMatchesWaterSecondCycle(
+        const interop::ColorCombiner &colorCombiner
+    ) {
+
+        constexpr uint32_t SecondCycleHighMask = 0x000001FFU;
+        constexpr uint32_t SecondCycleHighValue = 0x000000ACU;
+        constexpr uint32_t SecondCycleLowMask = 0x0FFC01FFU;
+        constexpr uint32_t SecondCycleLowValue = 0x0010003FU;
+        return ((colorCombiner.L & SecondCycleHighMask) ==
+                SecondCycleHighValue) &&
+            ((colorCombiner.H & SecondCycleLowMask) ==
+                SecondCycleLowValue);
+    }
+
+    static void jfcTraceWaterDraw(
+        const State &state,
+        const Workload &workload,
+        const FramebufferPair &fbPair,
+        const DrawCall &drawCall
+    ) {
+        if (!jfcWaterTraceEnabled() ||
+            (state.workloadId < jfcWaterTraceStartWorkload())) {
+            return;
+        }
+
+        const bool traceAllTwoCycle = jfcWaterTraceAllTwoCycle();
+        const bool exactWaterSecondCycle =
+            jfcMatchesWaterSecondCycle(drawCall.colorCombiner);
+        if (!exactWaterSecondCycle &&
+             !(traceAllTwoCycle &&
+               (drawCall.otherMode.cycleType() == G_CYC_2CYCLE))) {
+            return;
+        }
+
+        static uint32_t traceCount = 0;
+        const uint32_t traceLimit = traceAllTwoCycle ? 2048U : 256U;
+        if (traceCount >= traceLimit) {
+            return;
+        }
+
+        const size_t indexCount = size_t(drawCall.triangleCount) * 3U;
+        const auto &faceIndices = workload.drawData.faceIndices;
+        const auto &posScreen = workload.drawData.posScreen;
+        bool validIndices = indexCount <= faceIndices.size();
+        float minX = std::numeric_limits<float>::infinity();
+        float minY = std::numeric_limits<float>::infinity();
+        float minZ = std::numeric_limits<float>::infinity();
+        float maxX = -std::numeric_limits<float>::infinity();
+        float maxY = -std::numeric_limits<float>::infinity();
+        float maxZ = -std::numeric_limits<float>::infinity();
+        if (validIndices) {
+            const size_t firstIndex = faceIndices.size() - indexCount;
+            for (size_t i = firstIndex; i < faceIndices.size(); i++) {
+                const uint32_t vertexIndex = faceIndices[i];
+                if (vertexIndex >= posScreen.size()) {
+                    validIndices = false;
+                    break;
+                }
+
+                const hlslpp::float3 &position = posScreen[vertexIndex];
+                minX = std::min(minX, position[0]);
+                minY = std::min(minY, position[1]);
+                minZ = std::min(minZ, position[2]);
+                maxX = std::max(maxX, position[0]);
+                maxY = std::max(maxY, position[1]);
+                maxZ = std::max(maxZ, position[2]);
+            }
+        }
+
+        const interop::RSPViewport &viewport =
+            state.rsp->viewportStack[state.rsp->viewportStackSize - 1];
+        const FixedRect viewportRect = viewport.rect(state.rsp->clipRatios.data());
+
+        traceCount++;
+    }
