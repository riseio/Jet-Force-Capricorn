+    void PerformanceProfiler::noteDisplaySubmission() {
+#ifdef _WIN32
+        ProfilerState &profiler = state();
+        if (!profiler.accepting.load(std::memory_order_acquire) ||
+            !profiler.displayObservationRunning.load(
+                std::memory_order_acquire
+            )) {
+            return;
+        }
+
+        uint32_t queueDepth = profiler.estimatedDisplayQueueDepth.load(
+            std::memory_order_acquire
+        );
+        const uint32_t queueCapacity = std::max(
+            profiler.estimatedDisplayQueueCapacity,
+            1u
+        );
+        while (queueDepth < queueCapacity &&
+            !profiler.estimatedDisplayQueueDepth.compare_exchange_weak(
+                queueDepth,
+                queueDepth + 1u,
+                std::memory_order_acq_rel,
+                std::memory_order_acquire
+            )) {
+        }
+#endif
+    }
+
+    uint64_t PerformanceProfiler::nowNanoseconds() {
+        const ProfilerState &profiler = state();
+        if (!profiler.accepting.load(std::memory_order_acquire)) {
+            return 0;
+        }
+        return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+            Clock::now() - profiler.origin
+        ).count());
+    }
+
+    uint64_t PerformanceProfiler::currentThreadCpuNanoseconds() {
+#ifdef _WIN32
+        FILETIME creationTime{};
+        FILETIME exitTime{};
+        FILETIME kernelTime{};
+        FILETIME userTime{};
+        if (!GetThreadTimes(
+                GetCurrentThread(),
+                &creationTime,
+                &exitTime,
+                &kernelTime,
+                &userTime
+            )) {
+            return 0;
+        }
+        ULARGE_INTEGER kernel{};
+        kernel.LowPart = kernelTime.dwLowDateTime;
+        kernel.HighPart = kernelTime.dwHighDateTime;
+        ULARGE_INTEGER user{};
+        user.LowPart = userTime.dwLowDateTime;
+        user.HighPart = userTime.dwHighDateTime;
+        return (kernel.QuadPart + user.QuadPart) * 100u;
+#elif defined(__linux__)
+        timespec value{};
+        if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &value) != 0) {
+            return 0;
+        }
+        return uint64_t(value.tv_sec) * 1'000'000'000ULL +
+            uint64_t(value.tv_nsec);
+#else
+        return 0;
+#endif
+    }
+
+    bool PerformanceProfiler::shouldMeasureThreadCpu(std::string_view name) {
+        if (state().passiveRing) return false;
+#ifdef _WIN32
+
+        return false;
+#else
+        return (name == "Application.ProcessDisplayLists") ||
+            (name == "State.FullSync") ||
+            (name == "Workload.InterpolationBatch") ||
+            (name == "Renderer.Frame") ||
+            (name == "Backend.Vulkan.DriverSubmit") ||
+            (name == "Backend.Vulkan.QueueMutexWait") ||
+            (name == "Present.OutputFrame") ||
+            (name == "Geometry.DepthRecord") ||
+            (name == "Geometry.DepthQueue") ||
+            (name == "Present.CommandBuildAndSubmit");
+#endif
+    }
+
+    void PerformanceProfiler::setThreadName(std::string_view name) {
+        auto &profiler = state();
+        profiler.activeWriters.fetch_add(1, std::memory_order_acq_rel);
+        if (profiler.accepting.load(std::memory_order_acquire)) {
+            if (name.size() >= profiler.passiveThreadNames[0].size() || !validUTF8(name, false)) {
+                profiler.invalidEvents.fetch_add(1, std::memory_order_relaxed);
+                profiler.activeWriters.fetch_sub(1, std::memory_order_release);
+                return;
+            }
+            const uint32_t id = passiveThreadId(profiler);
+            if (id <= profiler.maximumThreads && !profiler.threadNamesReady[id - 1].load(std::memory_order_acquire)) {
+                auto &storage = profiler.passiveThreadNames[id - 1];
+                const size_t count = std::min(name.size(), storage.size() - 1);
+                std::copy_n(name.data(), count, storage.data());
+                storage[count] = '\0';
+
+                profiler.threadNamesReady[id - 1].store(true, std::memory_order_release);
+            }
+        }
+        profiler.activeWriters.fetch_sub(1, std::memory_order_release);
+    }
+
+    void PerformanceProfiler::setMetadata(
+        std::string_view key,
+        std::string_view value
+    ) {
+        ProfilerState &profiler = state();
+        if (!profiler.accepting.load(std::memory_order_acquire)) {
+            return;
+        }
+
+        const std::scoped_lock lock(profiler.metadataMutex);
+        if (!profiler.accepting.load(std::memory_order_acquire)) return;
+        if (key.size() > 256 || value.size() > 4096 || !validUTF8(key) || !validUTF8(value) ||
+            (profiler.metadata.size() >= 2048 && profiler.metadata.find(std::string(key)) == profiler.metadata.end())) {
+            profiler.invalidEvents.fetch_add(1, std::memory_order_relaxed);
+            return;
+        }
+        if (key == "session_id" || key == "process_id" || key == "process_start_ticks" ||
+            key == "steady_origin_ns" || key == "recorder_revision" || key == "observation_policy" ||
+            key == "terminal_integrity") {
+            const auto existing = profiler.metadata.find(std::string(key));
+            if (existing != profiler.metadata.end() && existing->second != value) {
+                profiler.invalidEvents.fetch_add(1, std::memory_order_relaxed);
+                return;
+            }
+        }
+        profiler.metadata[std::string(key)] = std::string(value);
+    }
+
+    void PerformanceProfiler::recordDuration(
+        PerformanceCategory category,
+        std::string_view name,
+        uint64_t startNanoseconds,
+        uint64_t endNanoseconds,
+        uint64_t correlationId,
+        uint64_t argument0,
+        uint64_t argument1
+    ) {
+        if (!shouldRecordDuration(name)) {
+            return;
+        }
+
+        recordAcceptedDuration(
+            category,
+            name,
+            startNanoseconds,
+            endNanoseconds,
+            correlationId,
+            argument0,
+            argument1
+        );
+    }
+
+    void PerformanceProfiler::recordAcceptedDuration(
+        PerformanceCategory category,
+        std::string_view name,
+        uint64_t startNanoseconds,
+        uint64_t endNanoseconds,
+        uint64_t correlationId,
+        uint64_t argument0,
+        uint64_t argument1,
+        uint64_t threadCpuDurationNanoseconds,
+        bool threadCpuMeasured,
+        bool threadScope
+    ) {
+        if (endNanoseconds < startNanoseconds) {
+            return;
+        }
+
+        const uint64_t durationNanoseconds =
+            endNanoseconds - startNanoseconds;
+        ProfilerState &profiler = state();
+        if (!profiler.accepting.load(std::memory_order_acquire)) return;
+        if (!profiler.recording.load(std::memory_order_acquire)) return;
+        if (startNanoseconds < profiler.resumeTimestamp.load(std::memory_order_acquire)) {
+            profiler.interruptedScopes.fetch_add(1, std::memory_order_relaxed);
+            return;
+        }
+        if (name.empty() || name.size() >= Event{}.name.size() || !validUTF8(name, false)) {
+            profiler.invalidEvents.fetch_add(1, std::memory_order_relaxed);
+            profiler.droppedEvents.fetch_add(1, std::memory_order_relaxed);
+            return;
+        }
+        profiler.aggregates.observe(name, uint8_t(category), durationNanoseconds);
+        if (!profiler.controlPath.empty() && profiler.spikeNanoseconds && durationNanoseconds >= profiler.spikeNanoseconds &&
+            category != PerformanceCategory::Wait && category != PerformanceCategory::Pacing) {
+            uint64_t empty = 0;
+            profiler.incidentDeadline.compare_exchange_strong(empty, nowNanoseconds() + profiler.incidentPostNanoseconds);
+        }
+        if (profiler.lowOverhead) {
+            const bool retainEverySample =
+                (name == "FrameProduction.ScreenUpdateActionWork") ||
+                (name == "FrameProduction.GraphicsTaskActionWork") ||
+                (name == "FrameProduction.RuntimeVIInterval") ||
+                (name == "FrameProduction.GuestGraphicsTaskInterval") ||
+                (name == "FrameProduction.GuestGraphicsWaitAfterCompletion") ||
+                (name == "FrameProduction.PresentQueueStarvation") ||
+                (name == "Workload.InterpolationBatch") ||
+                (name == "Renderer.Frame") ||
+                (name == "Present.ActualScanoutInterval") ||
+                (name == "Present.DesktopOutputChangeInterval") ||
+                (name == "Present.DisplayVBlankInterval") ||
+                (name == "Present.EstimatedDisplayedFrameInterval") ||
+                (name == "Present.PresentWaitCompletionInterval") ||
+                (name ==
+                    "Present.SwapChainImageReleaseObservationInterval");
+            if (!retainEverySample &&
+                (durationNanoseconds <
+                    profiler.lowOverheadMinimumDurationNanoseconds)) {
+                return;
+            }
+
+            Event event;
+            copyEventName(event, name);
+            event.timestampNanoseconds = startNanoseconds;
+            event.durationNanoseconds = durationNanoseconds;
+            event.threadCpuDurationNanoseconds =
+                threadCpuDurationNanoseconds;
+            event.threadCpuMeasured = threadCpuMeasured;
+            event.threadScope = threadScope;
+            event.correlationId = correlationId;
+            event.argument0 = argument0;
+            event.argument1 = argument1;
+            event.category = category;
+            event.kind = EventKind::Duration;
+            appendEvent(std::move(event));
+            return;
+        }
+
+        const bool presentationCriticalRecord =
+            (name.substr(0, 8) == "Present.") ||
+            (name == "RenderWorker.QueueMutexWait") ||
+            (name == "RenderWorker.QueueSubmitWithSemaphores") ||
+            (name == "Renderer.InterpolationBatchFenceDrain") ||
+            (name == "Renderer.InterpolationWorkerReuseWait") ||
+            (name == "Workload.InterpolationTargetWait") ||
+            (name == "Workload.PresentationQueueHandoff") ||
+            (name == "Workload.PresentationTargetClaimWait") ||
+            (name == "Workload.PresentationEventQueueWait") ||
+            (name == "Workload.PresentationSetCommitWait") ||
+            (name == "Workload.FirstPresentationQueueWait") ||
+            (name == "Workload.PreviousPresentWait");
+        const bool timingCriticalRecord =
+            (name == "Present.ActualScanoutInterval") ||
+            (name == "Present.DesktopOutputChangeInterval") ||
+            (name == "Present.DisplayVBlankInterval") ||
+            (name == "Present.EstimatedDisplayedFrameInterval") ||
+            (name == "Present.PresentWaitCompletionInterval") ||
+            (name ==
+                "Present.SwapChainImageReleaseObservationInterval") ||
+            (name == "FrameProduction.ScreenUpdateActionQueueDelay") ||
+            (name == "FrameProduction.GraphicsTaskActionQueueDelay") ||
+            (name == "FrameProduction.ScreenUpdateActionWork") ||
+            (name == "FrameProduction.GraphicsTaskActionWork") ||
+            (name == "FrameProduction.WorkloadProducerBackpressure") ||
+            (name == "Workload.InterpolationBatch");
+
+        const bool submissionCriticalRecord =
+            (name == "RenderWorker.QueueSubmit") || (name.substr(0, 8) == "Backend.");
+        const bool alwaysRecord = timingCriticalRecord ||
+            (submissionCriticalRecord && durationNanoseconds >= profiler.minimumDurationNanoseconds) ||
+            presentationCriticalRecord ||
+            category == PerformanceCategory::GPU ||
+            category == PerformanceCategory::Compile ||
+            category == PerformanceCategory::IO;
+        if (!alwaysRecord &&
+            durationNanoseconds < state().minimumDurationNanoseconds) {
+            return;
+        }
+
+        if (!alwaysRecord &&
+            durationNanoseconds < state().slowDurationNanoseconds) {
+            const uint64_t durationInterval = state().durationInterval;
+            if (durationInterval > 1) {
+                profiler.routineDurationEligible.fetch_add(1, std::memory_order_relaxed);
+
+                ThreadBuffer *samplingBuffer = threadBuffer();
+                if (!samplingBuffer) {
+                    profiler.droppedEvents.fetch_add(1, std::memory_order_relaxed);
+                    return;
+                }
+                auto &slots = samplingBuffer->durationSamplingSlots;
+                uint64_t hash = 1469598103934665603ULL;
+                for (char c : name) hash = (hash ^ uint8_t(c)) * 1099511628211ULL;
+                SamplingSlot *slot = nullptr;
+                for (size_t probe = 0; probe < slots.size(); ++probe) {
+                    auto &candidate = slots[(hash + probe) % slots.size()];
+                    if (!candidate.name[0]) {
+                        std::memcpy(candidate.name.data(), name.data(), name.size());
+                        candidate.category = category;
+                        candidate.random = hash ^ nowNanoseconds() ^ uint64_t(reinterpret_cast<uintptr_t>(&slots));
+                        if (!candidate.random) candidate.random = 1;
+                    }
+                    if (candidate.category == category && name == candidate.name.data()) {
+                        slot = &candidate;
+                        break;
+                    }
+                }
+                if (slot) {
+                    if (!slot->position) {
+                        slot->random ^= slot->random >> 12;
+                        slot->random ^= slot->random << 25;
+                        slot->random ^= slot->random >> 27;
+                        slot->selected = (slot->random * 2685821657736338717ULL) % durationInterval;
+                    }
+                    const bool selected = slot->position == slot->selected;
+                    slot->position = slot->position == durationInterval - 1 ? 0 : slot->position + 1;
+                    if (!selected) return;
+                }
+                else {
+
+                    profiler.routineSamplingFallback.fetch_add(1, std::memory_order_relaxed);
+                }
+                profiler.routineDurationSelected.fetch_add(1, std::memory_order_relaxed);
+            }
+        }
+
+        Event event;
+        copyEventName(event, name);
+        event.timestampNanoseconds = startNanoseconds;
+        event.durationNanoseconds = durationNanoseconds;
+        event.threadCpuDurationNanoseconds = threadCpuDurationNanoseconds;
+        event.threadCpuMeasured = threadCpuMeasured;
+        event.threadScope = threadScope;
+        event.correlationId = correlationId;
+        event.argument0 = argument0;
+        event.argument1 = argument1;
+        event.category = category;
+        event.kind = EventKind::Duration;
+        appendEvent(std::move(event));
+    }
+
+    void PerformanceProfiler::recordGPUDuration(
+        std::string_view name,
+        uint64_t gpuStartNanoseconds,
+        uint64_t gpuEndNanoseconds,
+        uint64_t cpuCompletionNanoseconds,
+        uint64_t correlationId,
+        uint64_t argument0,
+        uint64_t argument1
+    ) {
+        auto &profiler = state();
+        struct Lease {
+            ProfilerState &state;
+            explicit Lease(ProfilerState &value) : state(value) { state.activeWriters.fetch_add(1, std::memory_order_acq_rel); }
+            ~Lease() { state.activeWriters.fetch_sub(1, std::memory_order_release); }
+        } lease(profiler);
+        if (!profiler.accepting.load(std::memory_order_acquire) || !profiler.recording.load(std::memory_order_acquire) || !profiler.gpuInstrumentation) return;
+        if (gpuEndNanoseconds < gpuStartNanoseconds) {
+            profiler.invalidEvents.fetch_add(1); profiler.droppedEvents.fetch_add(1);
+            return;
+        }
+
+        const uint64_t duration = gpuEndNanoseconds - gpuStartNanoseconds;
+        profiler.aggregates.observe(name, uint8_t(PerformanceCategory::GPU), duration);
+        Event event;
+        copyEventName(event, name);
+        event.timestampNanoseconds = cpuCompletionNanoseconds > duration
+            ? cpuCompletionNanoseconds - duration
+            : 0;
+        event.durationNanoseconds = duration;
+        event.correlationId = correlationId;
+        event.argument0 = argument0;
+        event.argument1 = argument1;
+        event.gpuStartNanoseconds = gpuStartNanoseconds;
+        event.gpuEndNanoseconds = gpuEndNanoseconds;
+        event.category = PerformanceCategory::GPU;
+        event.kind = EventKind::Duration;
+        event.gpuClock = true;
+        appendEvent(std::move(event));
+    }
+
+    void PerformanceProfiler::recordInstant(
+        PerformanceCategory category,
+        std::string_view name,
+        uint64_t correlationId,
+        uint64_t argument0,
+        uint64_t argument1
+    ) {
+        if (!captureEnabled()) {
+            return;
+        }
+        if (lowOverheadEnabled() &&
+            !((name.size() >= 13u) &&
+                (name.substr(0, 13u) == "Host.Context.")) &&
+            (name != "Present.Submitted") &&
+            (name != "Present.Enqueued") &&
+            (name != "Present.Dequeued") &&
+            (name != "Present.InterpolationResolved") &&
+            (name != "Present.SwapChainConfigured") &&
+            (name != "Present.CompletionObservation") &&
+            (name != "Present.PendingDepthChanged") &&
+            (name != "Present.CoalescedDuplicateWorkload") &&
+            (name != "Present.ManualPacingResult") &&
+            (name != "Present.FifoRateCalibrationObservation") &&
+            (name != "Present.FifoRateCalibrated") &&
+            (name != "Present.DiagnosticCaptureQueued") &&
+            (name != "Present.DiagnosticCaptureCompleted") &&
+            (name != "Host.DiagnosticCaptureContent") &&
+            (name != "Workload.InterpolationDecision") &&
+            (name != "Workload.InterpolationCoverage") &&
+            (name != "Workload.InterpolationDynamicVertices") &&
+            (name != "Workload.InterpolationDynamicVertexCounts") &&
+            (name != "Workload.InterpolationSetPublished") &&
+            (name != "State.FullSyncEarlyPresentDecision") &&
+            (name != "Workload.InterpolationReuseBlocked") &&
+            (name != "Present.InterpolationBlocked")) {
+            return;
+        }
+
+        Event event;
+        copyEventName(event, name);
+        event.timestampNanoseconds = nowNanoseconds();
+        event.correlationId = correlationId;
+        event.argument0 = argument0;
+        event.argument1 = argument1;
+        event.category = category;
+        event.kind = EventKind::Instant;
+        appendEvent(std::move(event));
+    }
+
+    void PerformanceProfiler::recordCriticalInstant(
+        PerformanceCategory category,
+        std::string_view name,
+        uint64_t correlationId,
+        uint64_t argument0,
