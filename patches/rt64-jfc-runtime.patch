+        ThreadBuffer *threadBuffer() {
+            ProfilerState &profiler = state();
+            if (!profiler.accepting.load(std::memory_order_acquire)) {
+                return nullptr;
+            }
+
+            struct Registration {
+                ThreadBuffer *buffer = nullptr;
+                ~Registration() { if (buffer) buffer->retired.store(true, std::memory_order_release); }
+            };
+            thread_local Registration registration;
+            ThreadBuffer *&buffer = registration.buffer;
+            if (buffer == nullptr) buffer = claimProducerStorage(profiler);
+
+            return buffer;
+        }
