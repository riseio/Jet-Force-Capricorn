+        recordRuntimeTaskBoundary(1, sequence, displayList);
+    }
+    void PerformanceProfiler::recordRuntimeGraphicsTaskCompleted(uint64_t sequence, uint32_t displayList) {
+        recordRuntimeTaskBoundary(2, sequence, displayList);
