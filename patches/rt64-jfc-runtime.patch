+            worker->commandList->setPipeline(pipeline.get());
+            worker->commandList->setGraphicsPipelineLayout(layout.get());
+            worker->commandList->setGraphicsDescriptorSet(descriptors.get(), 0);
+            worker->commandList->setGraphicsPushConstants(0, &cb);
+            worker->commandList->setViewports(RenderViewport(0, 0, float(state.width), float(state.height)));
+            worker->commandList->setScissors(RenderRect(0, y, state.width, y + cb.rows));
+            worker->commandList->setVertexBuffers(0, nullptr, 0, nullptr);
+            worker->commandList->drawInstanced(3, 1, 0, 0);
+            finish(worker);
+        }
+    }
+    return texture;
+}
+}
