diff --git a/src/common/rt64_profiler_native_sha256.h b/src/common/rt64_profiler_native_sha256.h
new file mode 100644
index 0000000..c8fd719
--- /dev/null
+++ b/src/common/rt64_profiler_native_sha256.h
@@ -0,0 +1,102 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <limits>
+#include <stdexcept>
+#include <string>
+
+#ifdef _WIN32
+#include <windows.h>
+#include <bcrypt.h>
+#else
+#include <openssl/evp.h>
+#endif
+
+namespace RT64::ProfilerDetail {
+
+    class NativeSha256 {
+        uint64_t length = 0;
+        bool healthy = false;
+#ifdef _WIN32
+        BCRYPT_ALG_HANDLE algorithm = nullptr;
+        BCRYPT_HASH_HANDLE context = nullptr;
+#else
+        EVP_MD_CTX *context = nullptr;
+#endif
+    public:
+        NativeSha256() {
+#ifdef _WIN32
+            healthy = BCryptOpenAlgorithmProvider(&algorithm, BCRYPT_SHA256_ALGORITHM,
+                nullptr, 0) >= 0 &&
+                BCryptCreateHash(algorithm, &context, nullptr, 0, nullptr, 0, 0) >= 0;
+#else
+            context = EVP_MD_CTX_new();
+            healthy = context && EVP_DigestInit_ex(context, EVP_sha256(), nullptr) == 1;
+#endif
+        }
+        NativeSha256(const NativeSha256 &) = delete;
+        NativeSha256 &operator=(const NativeSha256 &) = delete;
+        ~NativeSha256() {
+#ifdef _WIN32
+            if (context) BCryptDestroyHash(context);
+            if (algorithm) BCryptCloseAlgorithmProvider(algorithm, 0);
+#else
+            EVP_MD_CTX_free(context);
+#endif
+        }
+        void update(const void *input, size_t size) {
+            if (!healthy || size > (std::numeric_limits<uint64_t>::max)() - length ||
+                (size && !input)) {
+                healthy = false;
+                throw std::runtime_error("Profiler SHA-256 input or initialization failed");
+            }
+            if (!size) return;
+#ifdef _WIN32
+            auto *data = static_cast<const unsigned char *>(input);
+            size_t remaining = size;
+            while (healthy && remaining) {
+                const auto part = static_cast<ULONG>((std::min)(remaining,
+                    size_t((std::numeric_limits<ULONG>::max)())));
+                healthy = BCryptHashData(context, const_cast<PUCHAR>(data), part, 0) >= 0;
+                data += part;
+                remaining -= part;
+            }
+#else
+            healthy = EVP_DigestUpdate(context, input, size) == 1;
+#endif
+            if (!healthy) throw std::runtime_error("Profiler SHA-256 update failed");
+            length += size;
+        }
+        uint64_t bytes() const { return length; }
+        std::string hex() const {
+            if (!healthy) return {};
+            std::array<unsigned char, 32> digest{};
+            bool complete = false;
+#ifdef _WIN32
+            BCRYPT_HASH_HANDLE snapshot = nullptr;
+            if (BCryptDuplicateHash(context, &snapshot, nullptr, 0, 0) >= 0) {
+                complete = BCryptFinishHash(snapshot, digest.data(), ULONG(digest.size()), 0) >= 0;
+                BCryptDestroyHash(snapshot);
+            }
+#else
+            EVP_MD_CTX *snapshot = EVP_MD_CTX_new();
+            if (snapshot) {
+                unsigned int size = 0;
+                complete = EVP_MD_CTX_copy_ex(snapshot, context) == 1 &&
+                    EVP_DigestFinal_ex(snapshot, digest.data(), &size) == 1 && size == digest.size();
+                EVP_MD_CTX_free(snapshot);
+            }
+#endif
+            if (!complete) return {};
+            constexpr char digits[] = "0123456789abcdef";
+            std::string result(64, '0');
+            for (size_t i = 0; i < digest.size(); ++i) {
+                result[2 * i] = digits[digest[i] >> 4];
+                result[2 * i + 1] = digits[digest[i] & 15];
+            }
+            return result;
+        }
+    };
+}
diff --git a/src/common/rt64_profiler_ring.h b/src/common/rt64_profiler_ring.h
new file mode 100644
index 0000000..705868e
--- /dev/null
+++ b/src/common/rt64_profiler_ring.h
@@ -0,0 +1,61 @@
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+namespace RT64::RecorderStorage {
+
+    template<class Event> class Ring {
+        struct Slot {
+            std::atomic_flag owned = ATOMIC_FLAG_INIT;
+            uint64_t sequence = 0;
+            Event event{};
+        };
+        std::unique_ptr<Slot[]> slots;
+        uint64_t capacity;
+        std::atomic<uint64_t> next{0};
+        std::atomic<uint64_t> lost{0};
+    public:
+        explicit Ring(uint64_t count) : slots(new Slot[count]), capacity(count) {}
+
+        void append(const Event &event) {
+            const uint64_t ticket = next.fetch_add(1, std::memory_order_relaxed) + 1;
+            Slot &slot = slots[(ticket - 1) % capacity];
+            if (slot.owned.test_and_set(std::memory_order_acquire)) {
+                lost.fetch_add(1, std::memory_order_relaxed);
+                return;
+            }
+            if (slot.sequence < ticket) {
+                slot.event = event;
+                slot.sequence = ticket;
+            }
+            else lost.fetch_add(1, std::memory_order_relaxed);
+            slot.owned.clear(std::memory_order_release);
+        }
+
+        std::vector<Event> snapshot(uint64_t &busy) {
+            struct Copy { uint64_t sequence; Event event; };
+            std::vector<Copy> copies;
+            copies.reserve(size_t(capacity));
+            const uint64_t end = next.load(std::memory_order_acquire);
+            const uint64_t begin = end > capacity ? end - capacity : 0;
+            for (uint64_t i = 0; i < capacity; ++i) {
+                Slot &slot = slots[i];
+                if (slot.owned.test_and_set(std::memory_order_acquire)) { ++busy; continue; }
+                if (slot.sequence > begin && slot.sequence <= end) copies.push_back({slot.sequence, slot.event});
+                slot.owned.clear(std::memory_order_release);
+            }
+            std::sort(copies.begin(), copies.end(), [](const Copy &a, const Copy &b) { return a.sequence < b.sequence; });
+            std::vector<Event> events;
+            events.reserve(copies.size());
+            for (const auto &copy : copies) events.push_back(copy.event);
+            return events;
+        }
+        uint64_t submitted() const { return next.load(std::memory_order_acquire); }
+        uint64_t dropped() const { return lost.load(std::memory_order_acquire); }
+        uint64_t bytes() const { return capacity * sizeof(Slot); }
+    };
+}
