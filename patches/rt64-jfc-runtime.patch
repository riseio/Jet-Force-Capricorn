@@ -0,0 +1,24 @@
+struct StateCB { uint width; uint rows; uint firstRow; uint sampleIndex; };
+[[vk::push_constant]] ConstantBuffer<StateCB> state : register(b0);
+StructuredBuffer<float4> source : register(t1);
+struct Output {
+#ifdef DEPTH_TARGET
+    float value : SV_Depth;
+#else
+    float4 value : SV_Target;
+#endif
+    uint coverage : SV_Coverage;
+};
+Output PSMain(float4 position : SV_Position) {
+    uint2 p = uint2(position.xy);
+    float4 value = source[(p.y - state.firstRow) * state.width + p.x];
+    Output result;
+#ifdef DEPTH_TARGET
+    result.value = value.x;
