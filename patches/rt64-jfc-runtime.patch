+        uint64_t nativeThreadId() {
+            thread_local const uint64_t id =
+#ifdef _WIN32
+                GetCurrentThreadId();
+#elif defined(__linux__)
+                uint64_t(syscall(SYS_gettid));
+#else
+                0;
+#endif
+            return id;
