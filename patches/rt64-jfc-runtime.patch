+    void PerformanceProfiler::registerRenderWorker(uint64_t workerId, std::string_view name,
+        uint64_t logicalQueueId, uint64_t nativeQueueId, uint32_t commandListType) {
+        auto &profiler = state();
+        profiler.activeWriters.fetch_add(1, std::memory_order_acq_rel);
+        if (profiler.accepting.load(std::memory_order_acquire)) {
+            if (name.size() >= profiler.renderWorkers[0].name.size() || !validUTF8(name, false)) {
+                profiler.invalidEvents.fetch_add(1, std::memory_order_relaxed);
+                profiler.activeWriters.fetch_sub(1, std::memory_order_release);
+                return;
+            }
+            const uint32_t index = profiler.nextRenderWorker.fetch_add(1, std::memory_order_relaxed);
+            if (index < profiler.renderWorkers.size()) {
+                auto &worker = profiler.renderWorkers[index];
+                worker.workerId = workerId;
+                worker.logicalQueueId = logicalQueueId;
+                worker.nativeQueueId = nativeQueueId;
+                worker.commandListType = commandListType;
+                const size_t count = std::min(name.size(), worker.name.size() - 1);
+                std::copy_n(name.data(), count, worker.name.data());
+                worker.name[count] = '\0';
+            }
+            else profiler.droppedRenderWorkers.fetch_add(1, std::memory_order_relaxed);
+        }
+        profiler.activeWriters.fetch_sub(1, std::memory_order_release);
+    }
