+
+    void PerformanceProfiler::recordCounter(
+        std::string_view name,
+        double value,
+        uint64_t correlationId,
+        uint64_t argument0,
+        uint64_t argument1
+    ) {
+        if (!enabled()) {
+            return;
+        }
+
+        const uint64_t counterInterval = state().counterInterval;
+
+        const bool selectedWindow = name.substr(0, 13) == "Renderer.GPU." ||
+            name.substr(0, 25) == "Renderer.SampledWorkload." ||
+            name.substr(0, 13) == "Renderer.Pair" || name == PerformanceEventNames::RendererFrameWorkloads;
+        if (!selectedWindow && (correlationId != 0) &&
+            ((correlationId % counterInterval) != 0)) {
+            return;
+        }
+
+        Event event;
+        copyEventName(event, name);
+        event.timestampNanoseconds = nowNanoseconds();
+        event.correlationId = correlationId;
+        event.value = value;
+        event.argument0 = argument0;
+        event.argument1 = argument1;
+        event.category = PerformanceCategory::Counter;
+        event.kind = EventKind::Counter;
+        appendEvent(std::move(event));
+    }
+
+    uint64_t PerformanceProfiler::beginAttachmentGroup(uint64_t correlationId, uint64_t output) {
+        if (!captureEnabled() || state().finished.load(std::memory_order_acquire)) return 0;
+        const uint64_t group = state().attachments.beginGroup(correlationId, output);
+        if (group) recordAttachmentInstant(group,"Recorder.AttachmentGroupAdmitted",group,correlationId,output);
+        return group;
+    }
+
+    void PerformanceProfiler::sealAttachmentGroup(uint64_t group, bool success) {
+        if (state().accepting.load(std::memory_order_acquire)) state().attachments.sealGroup(group,success);
+    }
+
+    void PerformanceProfiler::recordAttachmentInstant(uint64_t group, std::string_view name,
+            uint64_t correlationId, uint64_t argument0, uint64_t argument1) {
+        auto &profiler = state();
+        if (!profiler.accepting.load(std::memory_order_acquire)) return;
+        if (!group || profiler.attachments.activeGroup.load(std::memory_order_acquire) != group) {
+            profiler.attachments.rejected.fetch_add(1); return;
+        }
+        Event event;
+        copyEventName(event,name);
+        event.timestampNanoseconds = uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now()-profiler.origin).count());
+        event.correlationId = correlationId;
+        event.argument0 = argument0;
+        event.argument1 = argument1;
+        event.category = PerformanceCategory::Counter;
+        event.kind = EventKind::Instant;
+        appendEvent(std::move(event),true);
+    }
+
+    static bool queueAttachment(std::string_view suffix, std::vector<uint8_t> data,
+            PerformanceAttachmentChecksum checksum, std::string_view completionEvent,
+            uint64_t correlationId, uint64_t argument0, uint64_t argument1,
+            const void *borrowed = nullptr, size_t borrowedBytes = 0,
+            std::shared_ptr<const uint8_t> shared = {}, size_t storageBytes = 0,
+            std::string_view failureEvent = {}, uint64_t group = 0) {
+        auto &profiler = state();
+        const bool safeSuffix = !suffix.empty() && suffix.size() <= 160 && suffix.front() == '.' &&
+            suffix.find("..") == std::string_view::npos &&
+            std::all_of(suffix.begin(), suffix.end(), [](char c) {
+                return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                    (c >= '0' && c <= '9') || c == '.' || c == '-' || c == '_';
+            });
+        const bool admitted = group && profiler.attachments.activeGroup.load(std::memory_order_acquire) == group;
+        if ((!PerformanceProfiler::captureEnabled() && !admitted) || (data.empty() && ((!borrowed && !shared) || !borrowedBytes)) || !safeSuffix || completionEvent.empty() ||
+            checksum > PerformanceAttachmentChecksum::Adler32HighWord ||
+            completionEvent.size() >= 80 || completionEvent.find('\0') != std::string_view::npos ||
+            failureEvent.size() >= 80 || failureEvent.find('\0') != std::string_view::npos) {
+            profiler.attachments.reject(group); return false;
+        }
+        return profiler.attachments.enqueue(
+            std::filesystem::u8path(profiler.outputPath.u8string() + std::string(suffix)), std::move(data), checksum,
+            [name = std::string(completionEvent), failure = std::string(failureEvent), correlationId, argument0, argument1, checksum, group](bool success, uint32_t hash) {
+                const uint64_t result = checksum == PerformanceAttachmentChecksum::CRC32 ? hash :
+                    checksum == PerformanceAttachmentChecksum::Adler32HighWord ?
+                    ((uint64_t(hash) << 32) | uint32_t(argument1)) : argument1;
+                const auto emit = [&](std::string_view eventName,uint64_t value) {
+                    if (group) PerformanceProfiler::recordAttachmentInstant(group,eventName,correlationId,argument0,value);
+                    else PerformanceProfiler::recordCriticalInstant(PerformanceCategory::Counter,eventName,correlationId,argument0,value);
+                };
+                emit(success ? std::string_view(name) : std::string_view("Attachment.WriteFailed"),result);
+                if (!success && !failure.empty()) emit(failure,3);
+            }, borrowed, borrowedBytes, std::move(shared), storageBytes, group);
+    }
+
+    bool PerformanceProfiler::writeAttachment(std::string_view suffix, const void *data, size_t bytes,
+            std::string_view completionEvent, uint64_t correlationId, uint64_t argument0, uint64_t argument1) {
+        return queueAttachment(suffix, {}, PerformanceAttachmentChecksum::None, completionEvent,
+            correlationId, argument0, argument1, data, bytes);
+    }
+
+    bool PerformanceProfiler::writeAttachment(std::string_view suffix, const void *data, size_t bytes,
+            std::string_view completionEvent, uint64_t correlationId, uint64_t argument0, uint64_t argument1, uint64_t group) {
+        return queueAttachment(suffix, {}, PerformanceAttachmentChecksum::None, completionEvent,
+            correlationId, argument0, argument1, data, bytes, {}, 0, {}, group);
+    }
+
+    bool PerformanceProfiler::writeOwnedAttachment(std::string_view suffix, std::vector<uint8_t> data,
+            PerformanceAttachmentChecksum checksum, std::string_view completionEvent,
+            uint64_t correlationId, uint64_t argument0, uint64_t argument1, std::string_view failureEvent) {
+        return queueAttachment(suffix, std::move(data), checksum, completionEvent, correlationId, argument0, argument1,
+            nullptr, 0, {}, 0, failureEvent);
+    }
+
+    bool PerformanceProfiler::writeOwnedAttachment(std::string_view suffix, std::vector<uint8_t> data,
+            PerformanceAttachmentChecksum checksum, std::string_view completionEvent,
+            uint64_t correlationId, uint64_t argument0, uint64_t argument1, std::string_view failureEvent, uint64_t group) {
+        return queueAttachment(suffix, std::move(data), checksum, completionEvent, correlationId, argument0, argument1,
+            nullptr, 0, {}, 0, failureEvent, group);
+    }
+
+    bool PerformanceProfiler::writeSharedAttachment(std::string_view suffix,
+            std::shared_ptr<const uint8_t> data, size_t bytes, size_t storageBytes,
+            PerformanceAttachmentChecksum checksum, std::string_view completionEvent,
+            uint64_t correlationId, uint64_t argument0, uint64_t argument1, std::string_view failureEvent) {
+        return queueAttachment(suffix, {}, checksum, completionEvent, correlationId, argument0, argument1,
+            nullptr, bytes, std::move(data), storageBytes, failureEvent);
+    }
+
+    bool PerformanceProfiler::writeSharedAttachment(std::string_view suffix,
+            std::shared_ptr<const uint8_t> data, size_t bytes, size_t storageBytes,
+            PerformanceAttachmentChecksum checksum, std::string_view completionEvent,
+            uint64_t correlationId, uint64_t argument0, uint64_t argument1, std::string_view failureEvent, uint64_t group) {
+        return queueAttachment(suffix, {}, checksum, completionEvent, correlationId, argument0, argument1,
+            nullptr, bytes, std::move(data), storageBytes, failureEvent, group);
+    }
+
+    void PerformanceProfiler::drainAttachments() {
+        state().attachments.drain();
+    }
+
+    void PerformanceProfiler::finish() {
+        ProfilerState &profiler = state();
+        if (profiler.outputPath.empty() ||
+            profiler.finished.exchange(true, std::memory_order_acq_rel)) {
+            return;
+        }
+
+        const auto finalizeClock = [&]() {
+            return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - profiler.origin).count());
+        };
+        const uint64_t finalizeStart = finalizeClock();
+        const uint64_t finalizeCpuStart = currentThreadCpuNanoseconds();
+        profiler.controlRunning.store(false, std::memory_order_release);
+        if (profiler.controlThread.joinable()) profiler.controlThread.join();
+
+        profiler.hostObservationRunning.store(
+            false,
+            std::memory_order_release
+        );
+        {
+            const std::scoped_lock hostObservationLock(
+                profiler.hostObservationMutex
+            );
+            if (profiler.hostObservationThread.joinable()) {
+                profiler.hostObservationThread.join();
+            }
+        }
+#ifdef _WIN32
+        profiler.displayObservationRunning.store(
+            false,
+            std::memory_order_release
+        );
+        {
+            const std::scoped_lock displayObservationLock(
+                profiler.displayObservationMutex
+            );
+            if (profiler.displayObservationThread.joinable()) {
+                profiler.displayObservationThread.join();
+            }
+        }
+#endif
+
+        profiler.attachments.stop();
+
+        profiler.accepting.store(false, std::memory_order_release);
+        while (profiler.activeWriters.load(std::memory_order_acquire) != 0) std::this_thread::yield();
+        profiler.checkpointRunning.store(false, std::memory_order_release);
+        {
+            const std::scoped_lock checkpointLock(
+                profiler.checkpointMutex
+            );
+            if (profiler.checkpointThread.joinable()) {
+                profiler.checkpointThread.join();
+            }
+        }
+
+        if (profiler.incidentRing && !profiler.journalHealthy.load(std::memory_order_acquire)) {
+            const bool tailWritten = writeIncidentSnapshot(profiler, ++profiler.snapshotGeneration);
+            const std::scoped_lock lock(profiler.metadataMutex);
+            profiler.metadata["journal_failure_tail_snapshot"] = tailWritten ? "written" : "failed";
+            profiler.metadata["journal_failure_tail_generation"] = std::to_string(profiler.snapshotGeneration);
+        }
+        std::vector<ThreadBuffer *> buffers;
+        {
+            const std::scoped_lock lock(profiler.registryMutex);
+            buffers = profiler.threadBuffers;
+        }
+        const std::scoped_lock finalMetadataLock(profiler.metadataMutex);
+        std::unique_ptr<ThreadBuffer> passiveSnapshot;
+        if (profiler.passiveRing) {
+            uint64_t busy = 0;
+            const auto events = profiler.passiveRing->snapshot(busy);
+            passiveSnapshot = std::make_unique<ThreadBuffer>(profiler.maximumEvents);
+            passiveSnapshot->name = "RT64 passive events";
+            passiveSnapshot->id = 1;
+            for (size_t i = 0; i < events.size(); ++i) {
+                const size_t chunkIndex = i / EventChunkSize;
+                if (i % EventChunkSize == 0) {
+                    auto chunk = std::make_unique<Event[]>(EventChunkSize);
+                    passiveSnapshot->eventChunks[chunkIndex].store(chunk.get());
+                    passiveSnapshot->eventChunkOwners.push_back(std::move(chunk));
+                }
+                passiveSnapshot->eventChunks[chunkIndex].load()[i % EventChunkSize] = events[i];
+            }
+            passiveSnapshot->eventCount.store(events.size());
+            buffers.push_back(passiveSnapshot.get());
+            profiler.droppedEvents.fetch_add(profiler.passiveRing->dropped() + busy);
+            profiler.metadata["ring_events_submitted"] = std::to_string(profiler.passiveRing->submitted());
+            profiler.metadata["ring_storage_bytes"] = std::to_string(profiler.passiveRing->bytes());
+            profiler.metadata["ring_history_evicted"] = std::to_string(
+                profiler.passiveRing->submitted() > events.size() ? profiler.passiveRing->submitted() - events.size() : 0);
+        }
+        profiler.metadata["observer_gpu_query_commands"] = std::to_string(profiler.gpuQueryCommands.load());
+        profiler.metadata["observer_backend_fence_status_queries"] = std::to_string(profiler.backendFenceStatusQueries.load());
+        profiler.metadata["observer_secondary_graphics_devices"] = std::to_string(profiler.secondaryGraphicsDevices.load());
+        profiler.metadata["observer_frame_path_allocations"] = std::to_string(profiler.framePathAllocations.load());
+        profiler.metadata["interrupted_scopes"] = std::to_string(profiler.interruptedScopes.load());
+        {
+            std::filesystem::path summaryTemporary = profiler.summaryPath;
+            summaryTemporary += ".final.tmp";
+            std::filesystem::path traceTemporary = profiler.outputPath;
+            traceTemporary += ".final.tmp";
+            ContentDigest summaryDigest, traceDigest;
+            const uint64_t summaryStart = finalizeClock();
+            const uint64_t summaryCpuStart = currentThreadCpuNanoseconds();
+            const bool summarySerialized = writeSummary(
+                profiler,
+                buffers,
+                summaryTemporary,
+                summaryDigest
+            );
+            const uint64_t traceStart = finalizeClock();
+            const uint64_t traceCpuStart = currentThreadCpuNanoseconds();
+            const bool traceSerialized = writeTrace(
+                profiler,
+                buffers,
+                traceTemporary,
+                traceDigest
+            );
+            const uint64_t publishStart = finalizeClock();
+            const uint64_t publishCpuStart = currentThreadCpuNanoseconds();
+            const bool summaryWritten = summarySerialized &&
+                replaceFileAtomically(
+                    summaryTemporary,
+                    profiler.summaryPath
+                );
+            const bool traceWritten = traceSerialized &&
+                replaceFileAtomically(
+                    traceTemporary,
+                    profiler.outputPath
+                );
+            const auto completionPath = std::filesystem::path(profiler.outputPath.string() + ".completion.json");
+            const auto completionTemporary = std::filesystem::path(completionPath.string() + ".tmp");
+            std::error_code sizeError;
+            const uint64_t traceBytes = traceWritten ? std::filesystem::file_size(profiler.outputPath, sizeError) : 0;
+            const bool traceSized = traceWritten && !sizeError;
+            sizeError.clear();
+            const uint64_t summaryBytes = summaryWritten ? std::filesystem::file_size(profiler.summaryPath, sizeError) : 0;
+            const bool summarySized = summaryWritten && !sizeError;
+            const bool completeFinalProducts =
+                streamedOnlyEventCount(buffers) == 0u && omittedTraceEvents(profiler, buffers) == 0u &&
+                droppedEventCount(profiler, buffers) == 0u && profiler.invalidEvents.load() == 0u;
+            const bool contentVerified = traceSized && summarySized &&
+                verifyContent(profiler.outputPath, traceDigest) && verifyContent(profiler.summaryPath, summaryDigest) &&
+                verifyContent(profiler.outputPath.string() + ".startup.json", profiler.startupDigest);
+            const char *journalDisposition = profiler.passiveRing ? "NOT_WRITTEN" :
+                (completeFinalProducts && contentVerified && profiler.journalHealthy.load(std::memory_order_acquire)
+                    ? "REDUNDANT_MAY_REMOVE" : "REQUIRED");
+            const uint64_t finalizeMeasuredEnd = finalizeClock();
+            const uint64_t finalizeCpuEnd = currentThreadCpuNanoseconds();
+            std::ofstream completion(completionTemporary, std::ios::binary);
+            completion << "{\"schema\":\"n64profiler-completion-v1\",\"pid\":" << profiler.processId
+                << ",\"session_id\":\"" << jsonEscape(profiler.metadata["session_id"]) << '"'
+                << ",\"trace_written\":" << (traceSized ? "true" : "false")
+                << ",\"summary_written\":" << (summarySized ? "true" : "false")
+                << ",\"trace_bytes\":" << (traceSized ? traceBytes : 0)
+                << ",\"summary_bytes\":" << (summarySized ? summaryBytes : 0)
+                << ",\"terminal_integrity\":\"sha256-stream-v1\",\"content_verified\":" << (contentVerified ? "true" : "false")
+                << ",\"journal_disposition\":\"" << journalDisposition << "\",\"artifacts\":{";
+            const auto writeDigest = [&](const char *name, const ContentDigest &digest) {
+                completion << '"' << name << "\":{\"bytes\":" << digest.bytes << ",\"sha256\":\"" << digest.sha256
+                    << "\",\"written\":" << (digest.valid ? "true" : "false") << '}';
+            };
+            writeDigest("trace", traceDigest);
+            completion << ',';
+            writeDigest("summary", summaryDigest);
+            completion << ',';
+            writeDigest("startup", profiler.startupDigest);
+            if (!profiler.passiveRing) { completion << ','; writeDigest("journal", profiler.journalDigest); }
+            completion << "},\"finalization\":{\"window_ns\":[" << finalizeStart << ',' << finalizeMeasuredEnd
+                << "],\"scope\":\"CALLER_CPU_AND_WALL_PREFIX_EXCLUDES_COMPLETION_RECEIPT_AND_WORKER_CPU\",\"phases\":[";
+            const auto writeFinalizePhase = [&](const char *name, uint64_t start, uint64_t end,
+                uint64_t cpuStart, uint64_t cpuEnd) {
+                completion << "{\"name\":\"" << name << "\",\"wall_ns\":" << (end - start)
+                    << ",\"caller_cpu_ns\":";
+                if (cpuStart && cpuEnd >= cpuStart) completion << (cpuEnd - cpuStart);
+                else completion << "null";
+                completion << '}';
+            };
+            writeFinalizePhase("drain_and_snapshot", finalizeStart, summaryStart, finalizeCpuStart, summaryCpuStart);
+            completion << ',';
+            writeFinalizePhase("summary_analysis_and_write", summaryStart, traceStart, summaryCpuStart, traceCpuStart);
+            completion << ',';
+            writeFinalizePhase("trace_write", traceStart, publishStart, traceCpuStart, publishCpuStart);
+            completion << ',';
+            writeFinalizePhase("publish_and_size", publishStart, finalizeMeasuredEnd, publishCpuStart, finalizeCpuEnd);
+            completion << "]}}\n";
+            completion.flush();
+            const bool completionGood = completion.good();
+            completion.close();
+            const bool completionWritten = completionGood && !completion.fail() &&
+                replaceFileAtomically(completionTemporary, completionPath);
+
+            if (summaryWritten && traceWritten && completionWritten && contentVerified && completeFinalProducts &&
+                (profiler.passiveRing || profiler.journalHealthy.load(std::memory_order_acquire))) {
+                std::error_code removeError;
+                if (std::filesystem::is_regular_file(profiler.journalPath, removeError))
+                    std::filesystem::remove(profiler.journalPath, removeError);
+                removeError.clear();
+                std::filesystem::remove(profiler.livePath, removeError);
+            }
+
+            std::fflush(stderr);
+        }
+    }
+
+    PerformanceScope::PerformanceScope(
+        PerformanceCategory category,
+        std::string_view name,
+        uint64_t correlationId,
+        uint64_t argument0,
+        uint64_t argument1
+    )
+        : category(category),
+          name(name),
+          correlationId(correlationId),
+          argument0(argument0),
+          argument1(argument1),
+          active(PerformanceProfiler::shouldRecordDuration(name)) {
+        if (active) {
+            startThreadId = passiveThreadId(state());
+            startNanoseconds = PerformanceProfiler::nowNanoseconds();
+            measureThreadCpu =
+                PerformanceProfiler::shouldMeasureThreadCpu(name);
+            if (measureThreadCpu) {
+                startThreadCpuNanoseconds =
+                    PerformanceProfiler::currentThreadCpuNanoseconds();
+                threadCpuMeasurementAvailable =
+                    startThreadCpuNanoseconds > 0;
+            }
+        }
+    }
+
+    PerformanceScope::~PerformanceScope() {
+        end();
+    }
+
+    void PerformanceScope::end() {
+        if (active) {
+            const bool sameThread = startThreadId != 0 && startThreadId == passiveThreadId(state());
+            if (!sameThread) threadCpuMeasurementAvailable = false;
+            uint64_t threadCpuDurationNanoseconds = 0;
+            if (threadCpuMeasurementAvailable) {
+                const uint64_t endThreadCpuNanoseconds =
+                    PerformanceProfiler::currentThreadCpuNanoseconds();
+                if ((startThreadCpuNanoseconds > 0) &&
+                    (endThreadCpuNanoseconds >=
+                        startThreadCpuNanoseconds)) {
+                    threadCpuDurationNanoseconds =
+                        endThreadCpuNanoseconds -
+                        startThreadCpuNanoseconds;
+                }
+                else {
+                    threadCpuMeasurementAvailable = false;
+                }
+            }
+            PerformanceProfiler::recordAcceptedDuration(
+                category,
+                name,
+                startNanoseconds,
+                PerformanceProfiler::nowNanoseconds(),
+                correlationId,
+                argument0,
+                argument1,
+                threadCpuDurationNanoseconds,
+                threadCpuMeasurementAvailable,
+                sameThread
+            );
+            active = false;
+        }
+    }
+}
