+    void PerformanceProfiler::recordRuntimeGraphicsActionCompleted(bool screenUpdate,
+        uint64_t dequeuedNanoseconds, uint64_t completedNanoseconds, uint64_t sequence) {
+        static const bool declared = []() {
+            setMetadata("producer.graphics_tasks.supported", "1");
+            setMetadata("producer.graphics_tasks.enabled", mode() != PerformanceCaptureMode::Disabled ? "1" : "0");
+            setMetadata("runtime_action_alignment", "Native-clock duration ending at observer callback; not a calibrated native timestamp");
+            setMetadata("graphics_task_completion_owner", "Host send_dl action returned; not GPU completion or guest simulation correctness");
+            return true;
+        }();
+        (void)declared;
+        if (!captureEnabled() || !dequeuedNanoseconds || completedNanoseconds <= dequeuedNanoseconds) return;
+        const uint64_t duration = completedNanoseconds - dequeuedNanoseconds;
+        const uint64_t now = nowNanoseconds();
+        if (duration > now || now - duration < state().resumeTimestamp.load(std::memory_order_acquire)) return;
+        recordDuration(PerformanceCategory::CPU, screenUpdate ? "FrameProduction.ScreenUpdateActionWork" :
+            "FrameProduction.GraphicsTaskActionWork", now - duration, now, sequence);
+        if (!screenUpdate) recordCriticalInstant(PerformanceCategory::Frame,
+            "FrameProduction.GraphicsTaskCompleted", sequence, 0, duration);
+    }
