+    void PerformanceProfiler::recordRuntimeGraphicsActionDequeued(bool screenUpdate,
+        uint64_t queuedNanoseconds, uint64_t dequeuedNanoseconds, uint64_t sequence) {
+        if (!captureEnabled() || !queuedNanoseconds || dequeuedNanoseconds <= queuedNanoseconds) return;
+        const uint64_t duration = dequeuedNanoseconds - queuedNanoseconds;
+        const uint64_t now = nowNanoseconds();
+        if (duration > now || now - duration < state().resumeTimestamp.load(std::memory_order_acquire)) return;
+        recordDuration(PerformanceCategory::Wait, screenUpdate ? "FrameProduction.ScreenUpdateActionQueueDelay" :
+            "FrameProduction.GraphicsTaskActionQueueDelay", now - duration, now, sequence);
+    }
