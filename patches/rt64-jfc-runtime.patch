diff --git a/src/hle/rt64_extended_gbi_ownership.h b/src/hle/rt64_extended_gbi_ownership.h
new file mode 100644
index 0000000..f404bda
--- /dev/null
+++ b/src/hle/rt64_extended_gbi_ownership.h
@@ -0,0 +1,78 @@
+#pragma once
+
+#include <cstdint>
+#include <limits>
+
+namespace RT64 {
+
+    struct ExtendedGBIOwnership {
+        uint8_t opCode = 0;
+        uint32_t scopedDepth = 0;
+        bool persistent = false;
+
+        bool enablePersistent(uint8_t requestedOpCode) {
+            if (requestedOpCode == 0) {
+                return false;
+            }
+
+            if (opCode == 0) {
+                opCode = requestedOpCode;
+            }
+            else if (opCode != requestedOpCode) {
+                return false;
+            }
+
+            persistent = true;
+            return true;
+        }
+
+        bool disablePersistent() {
+            if (!persistent) {
+                return false;
+            }
+
+            persistent = false;
+            if (scopedDepth == 0) {
+                opCode = 0;
+            }
+
+            return true;
+        }
+
+        bool push(uint8_t requestedOpCode) {
+            if ((requestedOpCode == 0) ||
+                (scopedDepth == std::numeric_limits<uint32_t>::max())) {
+                return false;
+            }
+
+            if (opCode == 0) {
+                opCode = requestedOpCode;
+            }
+            else if (opCode != requestedOpCode) {
+                return false;
+            }
+
+            scopedDepth++;
+            return true;
+        }
+
+        bool pop() {
+            if (scopedDepth == 0) {
+                return false;
+            }
+
+            scopedDepth--;
+            if ((scopedDepth == 0) && !persistent) {
+                opCode = 0;
+            }
+
+            return true;
+        }
+
+        void reset() {
+            opCode = 0;
+            scopedDepth = 0;
+            persistent = false;
+        }
+    };
+}
diff --git a/src/hle/rt64_f3ddkr_camera_ownership.h b/src/hle/rt64_f3ddkr_camera_ownership.h
new file mode 100644
index 0000000..34045e7
--- /dev/null
+++ b/src/hle/rt64_f3ddkr_camera_ownership.h
@@ -0,0 +1,115 @@
+#pragma once
+
+#include "common/rt64_math.h"
+#include "../include/rt64_extended_gbi.h"
+#include "../include/rt64_f3ddkr_tracer.h"
+
+namespace RT64 {
+    constexpr uint32_t F3DDKRCameraMatrixId = 0x80000001U;
+    constexpr float F3DDKREndpointTolerance = 1e-5f;
+
+    constexpr bool matchesF3DDKRCameraHistory(uint32_t currentOwner,
+        uint32_t previousOwner, bool cameraMapped, uint32_t mappedPreviousOwner) {
+        return currentOwner == UINT32_MAX ? previousOwner == UINT32_MAX
+            : cameraMapped && previousOwner == mappedPreviousOwner;
+    }
+
+    struct F3DDKRTracerTransform {
+        uint32_t transformIndex = UINT32_MAX;
+        uint32_t cameraIndex = UINT32_MAX;
+        F3DDKRTracer tracer;
+        hlslpp::float4x4 projection;
+        hlslpp::float2 viewportScale;
+        uint32_t previousWorkload = UINT32_MAX;
+        uint32_t previousTracer = UINT32_MAX;
+    };
+
+    inline hlslpp::float4x4 composeF3DDKRTracer(const F3DDKRTracer &tracer,
+        const hlslpp::float4x4 &camera, const hlslpp::float4x4 &projection,
+        const hlslpp::float2 &viewportScale) {
+        const auto &p = tracer.endpoints;
+        const auto first = hlslpp::mul(hlslpp::float4(p[0], p[1], p[2], 1.0f), camera);
+        const auto second = hlslpp::mul(hlslpp::float4(p[3], p[4], p[5], 1.0f), camera);
+        auto clippedFirst = first;
+        auto clippedSecond = second;
+        const float nearW = std::abs(float(projection[2].w)) * 10.0f;
+        float offsetX = 0.0f, offsetY = 0.0f;
+
+        if (nearW > 0.0f && (float(first.w) >= nearW || float(second.w) >= nearW)) {
+            if (float(first.w) < nearW)
+                clippedFirst = hlslpp::lerp(first, second, (nearW - float(first.w)) / float(second.w - first.w));
+            if (float(second.w) < nearW)
+                clippedSecond = hlslpp::lerp(second, first, (nearW - float(second.w)) / float(first.w - second.w));
+            const double dx = (double(clippedFirst.x) / double(clippedFirst.w) -
+                double(clippedSecond.x) / double(clippedSecond.w)) * double(viewportScale.x);
+            const double dy = -(double(clippedFirst.y) / double(clippedFirst.w) -
+                double(clippedSecond.y) / double(clippedSecond.w)) * double(viewportScale.y);
+            const double length = std::hypot(dx, dy);
+            if (length > 0.0) {
+                offsetX = float(dy * tracer.width / length);
+                offsetY = float(dx * tracer.width / length);
+            }
+        }
+        hlslpp::float4x4 result;
+        result[0] = hlslpp::mul(hlslpp::float4(offsetX, offsetY, 0.0f, 0.0f), projection);
+        result[1] = first - second;
+        result[2] = projection[2];
+        result[3] = second;
+        return result;
+    }
+
+    struct F3DDKRBillboardAnchor {
+        uint32_t transformIndex = UINT32_MAX;
+        float position[3] = {};
+
+        hlslpp::float3 point() const {
+            return {position[0], position[1], position[2]};
+        }
+    };
+
+    inline hlslpp::float4x4 f3ddkrBillboardBasis(
+        hlslpp::float4x4 complete, const hlslpp::float3 &anchor,
+        const hlslpp::float4x4 &owner) {
+        complete[3] -= hlslpp::mul(hlslpp::float4(anchor, 1.0f), owner);
+        return complete;
+    }
+
+    inline hlslpp::float4x4 composeF3DDKRBillboard(
+        hlslpp::float4x4 basis, const hlslpp::float3 &anchor,
+        const hlslpp::float4x4 &presentedOwner) {
+        basis[3] += hlslpp::mul(hlslpp::float4(anchor, 1.0f), presentedOwner);
+        return basis;
+    }
+
+    inline hlslpp::float4x4 transposeF3DDKRBillboardLinear(const hlslpp::float4x4 &basis) {
+        auto result = basis;
+        for (unsigned row = 0; row < 3; ++row)
+            for (unsigned column = 0; column < 3; ++column)
+                result[row][column] = basis[column][row];
+        return result;
+    }
+
+    constexpr uint8_t f3ddkrMatrixOrdering(uint32_t matrixId) {
+        return (matrixId == G_EX_ID_IGNORE || matrixId == G_EX_ID_AUTO)
+            ? G_EX_ORDER_AUTO
+            : G_EX_ORDER_LINEAR;
+    }
+
+    inline hlslpp::float4x4 composeF3DDKRPresentedTransform(
+        const hlslpp::float4x4 &model,
+        const hlslpp::float4x4 &camera
+    ) {
+        return hlslpp::mul(model, camera);
+    }
+
+    inline bool matchesF3DDKRCompleteMVP(
+        const hlslpp::float4x4 &completeMVP,
+        const hlslpp::float4x4 &model,
+        const hlslpp::float4x4 &camera
+    ) {
+        return matrixDifference(
+            completeMVP,
+            composeF3DDKRPresentedTransform(model, camera)) <=
+            F3DDKREndpointTolerance;
+    }
+}
