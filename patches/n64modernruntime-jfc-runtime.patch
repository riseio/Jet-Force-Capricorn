diff --git a/ultramodern/include/ultramodern/rsp_task_lifecycle.hpp b/ultramodern/include/ultramodern/rsp_task_lifecycle.hpp
new file mode 100644
index 0000000..d417b8c
--- /dev/null
+++ b/ultramodern/include/ultramodern/rsp_task_lifecycle.hpp
@@ -0,0 +1,84 @@
+#pragma once
+#include <cstdint>
+#include <limits>
+#include <stdexcept>
+
+namespace ultramodern::rsp {
+
+class TaskLifecycle {
+public:
+    struct Result {
+        uint64_t token = 0;
+        bool dispatch = false, spInterrupt = false, dpInterrupt = false;
+    };
+private:
+    enum class Active { None, Graphics, Audio } active = Active::None;
+    uint32_t graphicsAddress = 0;
+    uint64_t graphicsToken = 0, audioToken = 0, sequence = 0;
+    bool graphicsYielded = false, graphicsCompleted = false;
+    uint64_t nextToken() {
+        if (sequence == std::numeric_limits<uint64_t>::max())
+            throw std::overflow_error("SP task generation exhausted");
+        return ++sequence;
+    }
+    void clearGraphics() {
+        graphicsAddress = 0; graphicsToken = 0;
+        graphicsYielded = graphicsCompleted = false;
+    }
+public:
+    Result startGraphics(uint32_t address) {
+        if (!address || active != Active::None)
+            throw std::logic_error("SP graphics start while another task owns SP");
+        if (graphicsToken) {
+            if (graphicsAddress != address || !graphicsYielded)
+                throw std::logic_error("SP resume does not own yielded graphics task");
+            Result result{graphicsToken};
+            graphicsYielded = false;
+            if (graphicsCompleted) {
+                result.spInterrupt = true;
+                clearGraphics();
+            } else active = Active::Graphics;
+            return result;
+        }
+        graphicsAddress = address; graphicsToken = nextToken();
+        active = Active::Graphics;
+        return {graphicsToken, true};
+    }
+    Result startAudio() {
+        if (active != Active::None)
+            throw std::logic_error("SP audio start before prior ownership retired");
+        audioToken = nextToken(); active = Active::Audio;
+        return {audioToken, true};
+    }
+    Result yieldGraphics() {
+
+        if (active == Active::None) return {};
+        if (active != Active::Graphics)
+            throw std::logic_error("Graphics yield requested for an audio task");
+        graphicsYielded = true; active = Active::None;
+        return {graphicsToken, false, true};
+    }
+    bool yielded(uint32_t address) const {
+        return graphicsToken && graphicsAddress == address && graphicsYielded;
+    }
+    Result completeGraphics(uint64_t token) {
+        if (!token || token != graphicsToken || graphicsCompleted)
+            throw std::logic_error("Stale or duplicate graphics completion");
+        Result result{token, false, false, true};
+        if (graphicsYielded) graphicsCompleted = true;
+        else {
+            if (active != Active::Graphics)
+                throw std::logic_error("Graphics completion lost SP ownership");
+            result.spInterrupt = true; active = Active::None; clearGraphics();
+        }
+        return result;
+    }
+    Result completeAudio(uint64_t token) {
+        if (!token || token != audioToken || active != Active::Audio)
+            throw std::logic_error("Stale or duplicate audio completion");
+        audioToken = 0; active = Active::None;
+        return {token, false, true};
+    }
+    bool idle() const { return active == Active::None && !graphicsToken && !audioToken; }
+};
+}
diff --git a/ultramodern/include/ultramodern/rt64_guest_vi_bridge.hpp b/ultramodern/include/ultramodern/rt64_guest_vi_bridge.hpp
new file mode 100644
index 0000000..5805048
--- /dev/null
+++ b/ultramodern/include/ultramodern/rt64_guest_vi_bridge.hpp
@@ -0,0 +1,25 @@
+#pragma once
+
+#include "ultramodern/diagnostic_vi_messages.hpp"
+
+namespace RT64::ProfilerGuestVI {
+    inline void observe(ultramodern::diagnostic_vi::Event event, uint64_t sequence,
+        uint32_t queue, uint32_t guestThread, uint32_t slot) {
+        using Event = ultramodern::diagnostic_vi::Event;
+        static constexpr const char *names[] = {"GuestVI.Invalid", "GuestVI.Generated",
+            "GuestVI.Delivered", "GuestVI.Consumed", "GuestVI.DeliveryBlocked", "GuestVI.TrackingLost",
+            "GuestVI.QueueReset", "GuestVI.StateReset", "GuestVI.SlotChanged", "GuestVI.SlotReplaced"};
+        const auto value = static_cast<uint32_t>(event);
+        if (value == 0 || value >= sizeof(names) / sizeof(names[0])) return;
+        PerformanceProfiler::recordCriticalInstant(PerformanceCategory::CPU, names[value],
+            sequence, (uint64_t(queue) << 32) | guestThread, slot);
+    }
+
+    inline void install() {
+        if (!PerformanceProfiler::enabled()) return;
+        PerformanceProfiler::setMetadata("producer.guest_vi.supported", "1");
+        PerformanceProfiler::setMetadata("producer.guest_vi.enabled", "1");
+        PerformanceProfiler::setMetadata("producer.guest_vi.owner", "guest_retrace_consumption");
+        ultramodern::diagnostic_vi::setCallback(observe);
+    }
+}
