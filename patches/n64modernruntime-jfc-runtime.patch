+recomp::overlays::PreparedState::PreparedState(std::unique_ptr<Impl> storage)
+    : impl(std::move(storage)) {}
+recomp::overlays::PreparedState::~PreparedState() = default;
+recomp::overlays::PreparedState::PreparedState(PreparedState&&) noexcept = default;
