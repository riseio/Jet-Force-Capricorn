+void ultramodern::state::validate_video(const VideoState& saved, std::span<const uint8_t> memory) {
+    const auto guest_offset = [](uint32_t address, size_t length) -> size_t {
+        if (address < 0x80000000U || uint64_t(address) + length > 0x80800000ULL) {
+            throw std::runtime_error("Invalid save-state VI guest address");
+        }
+        return address - 0x80000000U;
+    };
+    if (memory.size() != 8U * 1024 * 1024 || saved.current < 0 || saved.current > 1 ||
+        saved.field < 0 || saved.field > 1 || saved.remaining_retraces < 1 || saved.remaining_retraces > 65535) {
+        throw std::runtime_error("Invalid save-state VI counters");
+    }
+    const auto validate_queue = [&](int32_t address) {
+        if (address == 0) return;
+        OSMesgQueue queue;
+        std::memcpy(&queue, memory.data() + guest_offset(uint32_t(address), sizeof(queue)), sizeof(queue));
+        if (queue.msgCount < 1 || queue.msgCount > int32_t(memory.size() / sizeof(OSMesg)) ||
+            queue.validCount < 0 || queue.validCount > queue.msgCount || queue.first < 0 || queue.first >= queue.msgCount) {
+            throw std::runtime_error("Invalid save-state VI message queue");
+        }
+        guest_offset(uint32_t(queue.msg), size_t(queue.msgCount) * sizeof(OSMesg));
+    };
+    for (const auto& frame : saved.frames) {
+        if (frame.mode != 0) guest_offset(frame.mode, sizeof(OSViMode));
+        if (frame.framebuffer != 0) guest_offset(uint32_t(frame.framebuffer), 1);
+        if (frame.retraces < 1 || frame.retraces > 65535) throw std::runtime_error("Invalid save-state retrace interval");
+        validate_queue(frame.queue);
+    }
+    for (size_t i = 0; i < saved.events.size(); i += 2) validate_queue(saved.events[i]);
+    for (const auto* regs : {&saved.registers, &saved.screen_registers}) {
+        if ((*regs)[1] >= memory.size() || (*regs)[2] > 4096) {
+            throw std::runtime_error("Invalid save-state VI framebuffer extent");
+        }
+    }
+}
+
+void ultramodern::state::restore_video(const VideoState& saved) noexcept {
+    if (!inside_state_operation) std::terminate();
+    auto& vi = events_context.vi;
+    vi.cur_state = saved.current; vi.field = saved.field;
+    vi.remaining_retraces = saved.remaining_retraces;
+    for (size_t i = 0; i < saved.frames.size(); ++i) {
+        const auto& frame = saved.frames[i];
+        vi.states[i] = {frame.mode ? reinterpret_cast<const OSViMode*>(events_context.rdram + (frame.mode - 0x80000000U)) : &dummy_mode,
+            frame.framebuffer, frame.queue, frame.message, frame.state, frame.control, frame.retraces};
+    }
+    std::memcpy(&vi.regs, saved.registers.data(), sizeof(vi.regs));
+    std::memcpy(&vi.update_screen_regs, saved.screen_registers.data(), sizeof(vi.update_screen_regs));
+    events_context.sp.mq = saved.events[0]; events_context.sp.msg = saved.events[1];
+    events_context.dp.mq = saved.events[2]; events_context.dp.msg = saved.events[3];
+    events_context.ai.mq = saved.events[4]; events_context.ai.msg = saved.events[5];
+    events_context.si.mq = saved.events[6]; events_context.si.msg = saved.events[7];
+}
