diff --git a/ultramodern/include/ultramodern/diagnostic_vi_messages.hpp b/ultramodern/include/ultramodern/diagnostic_vi_messages.hpp
new file mode 100644
index 0000000..636eb1e
--- /dev/null
+++ b/ultramodern/include/ultramodern/diagnostic_vi_messages.hpp
@@ -0,0 +1,83 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+namespace ultramodern::diagnostic_vi {
+    enum class Event : uint32_t {
+        Generated = 1, Delivered, Consumed, DeliveryBlocked, TrackingLost,
+        QueueReset, StateReset, SlotChanged, SlotReplaced
+    };
+    using Callback = void(Event, uint64_t, uint32_t, uint32_t, uint32_t);
+    inline std::atomic<Callback *> callback{nullptr};
+    inline std::atomic<uint64_t> nextSequence{1};
+    void setCallback(Callback *sink);
+
+    inline void emit(Event event, uint64_t sequence, uint32_t queue,
+        uint32_t guestThread = 0, uint32_t slot = 0) {
+        if (auto *sink = callback.load(std::memory_order_relaxed)) {
+            sink(event, sequence, queue, guestThread, slot);
+        }
+    }
+
+    inline uint64_t generated(uint32_t queue) {
+        if (!callback.load(std::memory_order_relaxed)) return 0;
+        const uint64_t sequence = nextSequence.fetch_add(1, std::memory_order_relaxed);
+        if (sequence) emit(Event::Generated, sequence, queue);
+        else emit(Event::TrackingLost, 0, queue);
+        return sequence;
+    }
+
+    struct Slot {
+        uint32_t address = 0, queue = 0, value = 0;
+        uint64_t sequence = 0;
+    };
+
+    template<std::size_t Capacity = 4096> class Slots {
+        static_assert(Capacity > 0);
+        std::array<Slot, Capacity> slots{};
+        static std::size_t index(uint32_t address) {
+            return ((address >> 2) * uint32_t(2654435761U)) % Capacity;
+        }
+    public:
+        void written(uint32_t address, uint32_t queue, uint32_t value, uint64_t sequence) {
+            if (!callback.load(std::memory_order_relaxed)) return;
+            auto &slot = slots[index(address)];
+            if (!sequence && slot.address != address) return;
+            if (slot.sequence) {
+                emit(slot.address == address ? Event::SlotReplaced : Event::TrackingLost,
+                    slot.sequence, slot.queue, 0, slot.address);
+            }
+
+            slot = sequence ? Slot{address, queue, value, sequence} : Slot{};
+            if (sequence) emit(Event::Delivered, sequence, queue, 0, address);
+        }
+        void consumed(uint32_t address, uint32_t queue, uint32_t value, uint32_t guestThread) {
+            if (!callback.load(std::memory_order_relaxed)) return;
+            auto &slot = slots[index(address)];
+            if (!slot.sequence || slot.address != address) return;
+            const Slot old = slot;
+            slot = {};
+            if (old.queue == queue && old.value == value) {
+                emit(Event::Consumed, old.sequence, queue, guestThread, address);
+            }
+            else emit(Event::SlotChanged, old.sequence, old.queue, guestThread, address);
+        }
+        void resetQueue(uint32_t queue) {
+            if (!callback.load(std::memory_order_relaxed)) return;
+            for (auto &slot : slots) {
+                if (slot.sequence && slot.queue == queue) {
+                    emit(Event::QueueReset, slot.sequence, queue, 0, slot.address);
+                    slot = {};
+                }
+            }
+        }
+        void resetState() {
+            for (auto &slot : slots) slot = {};
+            emit(Event::StateReset, 0, 0);
+        }
+    };
+    inline Slots<> slots;
+}
