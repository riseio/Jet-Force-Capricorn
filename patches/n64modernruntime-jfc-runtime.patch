+ultramodern::state::PreparedExternalMessages::PreparedExternalMessages(
+    std::span<const ExternalMessageState> saved, std::span<const uint8_t> memory,
+    std::span<const ThreadBinding> threads) : impl(std::make_unique<Impl>()) {
+    if (saved.size() > maximum_state_messages || threads.size() != 5 || memory.size() != 0x800000) {
+        throw std::runtime_error("Invalid save-state external-event inventory");
+    }
