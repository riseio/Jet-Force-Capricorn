+
+recomp::overlays::PreparedState recomp::overlays::prepare_state(
+    std::span<const SectionBinding> saved, uint32_t rdram_size) {
+    if (section_addresses == nullptr || saved.size() > sections_info.num_code_sections ||
+        rdram_size == 0 || rdram_size > 0x20000000U) {
+        throw std::runtime_error("Save-state overlay inventory is invalid or runtime not initialized");
+    }
+    auto prepared = std::make_unique<PreparedState::Impl>();
+    prepared->addresses.resize(sections_info.total_num_sections);
+    prepared->sections.reserve(saved.size());
+    std::vector<bool> seen(sections_info.num_code_sections, false);
+    for (size_t i = 0; i < sections_info.num_code_sections; ++i) {
+        const auto& section = sections_info.code_sections[i];
+        if (section.index >= prepared->addresses.size()) {
+            throw std::runtime_error("Runtime overlay section index is invalid");
+        }
+        prepared->addresses[section.index] = section.ram_addr;
+    }
+
+    for (size_t i = 0; i < num_patch_code_sections; ++i) {
+        const auto& section = patch_code_sections[i];
+        for (size_t f = 0; f < section.num_funcs; ++f) {
+            prepared->functions[int32_t(section.ram_addr + section.funcs[f].offset)] = section.funcs[f].func;
+        }
+    }
+    for (const auto& binding : saved) {
+        const auto found = code_sections_by_rom.find(binding.rom);
+        if (found == code_sections_by_rom.end()) {
+            throw std::runtime_error("Save state names an unknown compiled overlay");
+        }
+        const size_t index = found->second;
+        const auto& section = sections_info.code_sections[index];
+        if (seen[index] || binding.size != section.size || binding.size == 0 ||
+            (binding.ram & 3U) != 0 || binding.ram < 0x80000000U ||
+            uint64_t(binding.ram) + binding.size > 0x80000000ULL + rdram_size) {
+            throw std::runtime_error("Save-state overlay extent or identity is incompatible");
+        }
+        seen[index] = true;
+        for (const auto& prior : prepared->sections) {
+            const uint64_t prior_start = uint32_t(prior.loaded_ram_addr);
+            const auto& prior_section = sections_info.code_sections[prior.section_table_index];
+            if (binding.ram < prior_start + prior_section.size &&
+                prior_start < uint64_t(binding.ram) + binding.size) {
+                throw std::runtime_error("Save state contains overlapping compiled overlays");
+            }
+        }
+        for (size_t f = 0; f < section.num_funcs; ++f) {
+            const auto& function = section.funcs[f];
+            if (function.offset >= section.size) {
+                throw std::runtime_error("Runtime overlay function lies outside its section");
+            }
+            prepared->functions[int32_t(binding.ram + function.offset)] = function.func;
+        }
+        prepared->sections.emplace_back(int32_t(binding.ram), index);
+        prepared->addresses[section.index] = int32_t(binding.ram);
+    }
+    return PreparedState(std::move(prepared));
+}
+
+std::vector<recomp::overlays::SectionBinding> recomp::overlays::capture_state(uint32_t rdram_size) {
+    std::vector<SectionBinding> saved;
+    saved.reserve(loaded_sections.size());
+    for (const auto& loaded : loaded_sections) {
+        const auto& section = sections_info.code_sections[loaded.section_table_index];
+        saved.push_back({section.rom_addr, uint32_t(loaded.loaded_ram_addr), section.size});
+    }
+    auto prepared = prepare_state(saved, rdram_size);
+    if (prepared.impl->functions != func_map ||
+        !std::equal(prepared.impl->addresses.begin(), prepared.impl->addresses.end(), section_addresses)) {
+        throw std::runtime_error("Save-state overlay inventory does not represent live dispatch (dynamic code or stale mapping)");
+    }
+    return saved;
+}
+
+void recomp::overlays::PreparedState::commit() noexcept {
+    if (!impl || impl->committed) std::terminate();
+    func_map.swap(impl->functions);
+    loaded_sections.swap(impl->sections);
+    std::copy(impl->addresses.begin(), impl->addresses.end(), section_addresses);
+    impl->committed = true;
+}
