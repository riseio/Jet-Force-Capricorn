+ultramodern::state::VideoState ultramodern::state::capture_video() {
+    if (!inside_state_operation) throw std::logic_error("VI capture requires renderer checkpoint ownership");
+    VideoState saved;
+    const auto& vi = events_context.vi;
+    saved.current = vi.cur_state;
+    saved.field = vi.field;
+    saved.remaining_retraces = vi.remaining_retraces;
+    for (size_t i = 0; i < saved.frames.size(); ++i) {
+        const auto& frame = vi.states[i];
+        uint32_t mode = 0;
+        if (frame.mode != &dummy_mode) {
+            const uintptr_t base = reinterpret_cast<uintptr_t>(events_context.rdram);
+            const uintptr_t pointer = reinterpret_cast<uintptr_t>(frame.mode);
+            if (pointer < base || pointer - base > 8U * 1024 * 1024 - sizeof(OSViMode)) {
+                throw std::runtime_error("VI mode has no portable guest identity");
+            }
+            mode = 0x80000000U + uint32_t(pointer - base);
+        }
+        saved.frames[i] = {mode, frame.framebuffer, frame.mq, frame.msg,
+            frame.state, frame.control, frame.retrace_count};
+    }
+    static_assert(sizeof(vi.regs) == sizeof(saved.registers));
+    std::memcpy(saved.registers.data(), &vi.regs, sizeof(vi.regs));
+    std::memcpy(saved.screen_registers.data(), &vi.update_screen_regs, sizeof(vi.update_screen_regs));
+    saved.events = {events_context.sp.mq, events_context.sp.msg,
+        events_context.dp.mq, events_context.dp.msg, events_context.ai.mq,
+        events_context.ai.msg, events_context.si.mq, events_context.si.msg};
+    return saved;
+}
