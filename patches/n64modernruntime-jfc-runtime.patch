+                        [&](const auto& thread) { return thread.address == next; })) {
+                    throw std::runtime_error("Invalid save-state blocked event receiver");
+                }
+                OSThread thread;
+                std::memcpy(&thread, memory.data() + offset(uint32_t(next), sizeof(thread)), sizeof(thread));
+                const uint32_t queue_field = uint32_t(message.queue) + uint32_t(list == 0
+                    ? offsetof(OSMesgQueue, blocked_on_recv) : offsetof(OSMesgQueue, blocked_on_send));
