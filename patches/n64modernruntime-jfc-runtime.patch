+void ultramodern::renderer::complete_cpu_framebuffer(uint8_t* rdram, uint32_t scratch, uint32_t address,
+    std::span<const uint32_t> effects) {
+    if (address >= 8U * 1024U * 1024U || (address & 1U))
+        throw std::invalid_argument("Invalid native CPU framebuffer address");
+    constexpr uint32_t bytes = sizeof(OSMesgQueue) + 2 * sizeof(OSMesg);
+    static_assert(bytes <= 0x40);
+    if (!rdram || (scratch & 7U) || scratch < 0x80000000U || scratch > 0x80800000U - bytes)
+        throw std::invalid_argument("Invalid native CPU image completion queue storage");
+    const auto queue = PTR(OSMesgQueue)(scratch);
+    const auto buffer = PTR(OSMesg)(scratch + sizeof(OSMesgQueue));
+    const auto reply = PTR(OSMesg)(scratch + sizeof(OSMesgQueue) + sizeof(OSMesg));
+    osCreateMesgQueue(rdram, queue, buffer, 1);
+    {
+        std::lock_guard lock(gfx_action_shutdown_mutex);
+        if (!gfx_actions_open || exited.load()) throw ultramodern::thread_terminated{};
+        if (!events_context.action_queue.enqueue(CpuFramebufferAction{address, queue, effects}))
+            throw std::bad_alloc();
+    }
+    if (osRecvMesg(rdram, queue, reply, OS_MESG_BLOCK) != 0)
+        throw std::runtime_error("Failed native CPU image completion receive");
+    ultramodern::throw_if_exiting();
+    if (*TO_PTR(OSMesg, reply) != 1)
+        throw std::runtime_error("CPU image completion failed; renderer error recorded above");
+}
