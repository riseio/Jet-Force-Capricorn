+struct recomp::state::SaveMediaPause::Impl {
+    std::unique_lock<std::mutex> operation{save_operation_mutex, std::try_to_lock};
+    uint8_t* rdram;
+    bool requested = false;
+    std::unique_ptr<SaveMediaState> prepared;
+    explicit Impl(uint8_t* memory) : rdram(memory) {
+        if (!operation.owns_lock()) throw std::logic_error("Save-media operation already active");
+    }
+    ~Impl() {
+        if (!requested) return;
+        std::unique_lock lock(save_state_mutex);
+        save_pause_requested.store(false, std::memory_order_release);
+        save_state_cv.notify_all();
+        save_state_cv.wait(lock, [] { return !save_writer_parked || !save_writer_running; });
+    }
+};
+
+recomp::state::SaveMediaPause::SaveMediaPause(uint8_t* rdram) : impl(std::make_unique<Impl>(rdram)) {
+    std::unique_lock lock(save_state_mutex);
+    if (!save_writer_running || exited) throw std::logic_error("Save-media writer is not running");
+    impl->requested = true;
