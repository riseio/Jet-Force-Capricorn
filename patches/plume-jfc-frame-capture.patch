@@ -0,0 +1,20 @@
+#pragma once
+
+#include <cstdint>
+
+namespace plume {
+
+    struct QueryReadState {
+        uint32_t first = 0;
+        uint32_t count = 0;
+        void invalidate() { first = 0; count = 0; }
+        void completed(uint32_t readFirst, uint32_t readCount) {
+            first = readFirst;
+            count = readCount;
+        }
+        bool contains(uint32_t queryFirst, uint32_t queryCount) const {
+            return queryCount > 0 && queryFirst >= first && queryFirst - first <= count &&
+                queryCount <= count - (queryFirst - first);
+        }
+    };
+}
