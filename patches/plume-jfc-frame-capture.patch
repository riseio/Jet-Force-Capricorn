diff --git a/plume_rt64_profile_interval.h b/plume_rt64_profile_interval.h
new file mode 100644
index 0000000..3ef6fe2
--- /dev/null
+++ b/plume_rt64_profile_interval.h
@@ -0,0 +1,30 @@
+// Copyright (c) 2024 renderbag and contributors. All rights reserved.
+// Licensed under the MIT license. See LICENSE file for details.
+
+#pragma once
+
+#include <charconv>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+namespace plume {
+
+    inline bool rt64ProfileIntervalInstrumentationEnabled() {
+        static const bool enabled = []() {
+            const char *text = std::getenv("RT64_PROFILE_INTERVAL");
+            if ((text == nullptr) || (text[0] == '\0')) {
+                return false;
+            }
+
+            const char *end = text + std::strlen(text);
+            uint64_t interval = 0;
+            const auto result = std::from_chars(text, end, interval);
+            return (result.ec == std::errc()) &&
+                (result.ptr == end) &&
+                (interval >= 30) &&
+                (interval <= 1'000'000ULL);
+        }();
+        return enabled;
+    }
+}
