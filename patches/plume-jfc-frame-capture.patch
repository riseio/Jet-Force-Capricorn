+    static void checkVulkanResult(VkResult result, const char *operation) {
+        if (result != VK_SUCCESS) {
+            char message[192];
+            std::snprintf(message, sizeof(message), "Vulkan %s failed (VkResult %d)", operation, int(result));
+            std::fprintf(stderr, "%s\n", message);
+            std::fflush(stderr);
+            throw std::runtime_error(message);
+        }
+    }
+
+    static constexpr uint32_t VulkanSubmissionPhaseCapacity = 32768;
+
+    struct VulkanSubmissionPhaseRecord {
+        uint64_t ordinal = 0;
+        uint64_t timestampNs = 0;
+        uint64_t nativeSequence = 0;
+        uint32_t familyIndex = 0;
+        uint32_t queueIndex = 0;
+        uint32_t commandListType = 0;
+        uint32_t commandListCount = 0;
+        uint32_t waitSemaphoreCount = 0;
+        uint32_t signalSemaphoreCount = 0;
+        uint32_t signalsFence = 0;
+    };
+
+    struct VulkanSubmissionPhaseTrace {
+        std::atomic_uint64_t recordCount = 0;
+        std::array<VulkanSubmissionPhaseRecord,
+            VulkanSubmissionPhaseCapacity> records{};
+    };
+
+    static bool vulkanSubmissionPhaseEnabled() {
+        static const bool enabled =
+            std::getenv("JFC_VULKAN_SUBMIT_PHASE_TRACE") != nullptr;
+        return enabled;
+    }
+
+    static VulkanSubmissionPhaseTrace &vulkanSubmissionPhaseTrace() {
+        static VulkanSubmissionPhaseTrace trace;
+        return trace;
+    }
+
+    static void recordVulkanSubmissionPhase(
+        uint64_t nativeSequence,
+        uint32_t familyIndex,
+        uint32_t queueIndex,
+        RenderCommandListType commandListType,
+        uint32_t commandListCount,
+        uint32_t waitSemaphoreCount,
+        uint32_t signalSemaphoreCount,
+        bool signalsFence
+    ) {
+        if (!vulkanSubmissionPhaseEnabled()) {
+            return;
+        }
+
+        VulkanSubmissionPhaseTrace &trace = vulkanSubmissionPhaseTrace();
+        const uint64_t ordinal = trace.recordCount.fetch_add(
+            1, std::memory_order_relaxed);
+        VulkanSubmissionPhaseRecord &record =
+            trace.records[ordinal % VulkanSubmissionPhaseCapacity];
+        record.ordinal = ordinal;
+        record.timestampNs = static_cast<uint64_t>(
+            std::chrono::duration_cast<std::chrono::nanoseconds>(
+                std::chrono::steady_clock::now().time_since_epoch()).count());
+        record.nativeSequence = nativeSequence;
+        record.familyIndex = familyIndex;
+        record.queueIndex = queueIndex;
+        record.commandListType = static_cast<uint32_t>(commandListType);
+        record.commandListCount = commandListCount;
+        record.waitSemaphoreCount = waitSemaphoreCount;
+        record.signalSemaphoreCount = signalSemaphoreCount;
+        record.signalsFence = signalsFence ? 1U : 0U;
+    }
+
+    static void dumpVulkanSubmissionPhase() {
+        if (!vulkanSubmissionPhaseEnabled()) {
+            return;
+        }
+
+        const VulkanSubmissionPhaseTrace &trace =
+            vulkanSubmissionPhaseTrace();
+        const uint64_t total = trace.recordCount.load(
+            std::memory_order_relaxed);
+        const uint64_t retained = std::min<uint64_t>(
+            total, VulkanSubmissionPhaseCapacity);
+        const uint64_t firstOrdinal = total - retained;
+
+        for (uint64_t ordinal = firstOrdinal; ordinal < total; ordinal++) {
+            const VulkanSubmissionPhaseRecord &record =
+                trace.records[ordinal % VulkanSubmissionPhaseCapacity];
+
+        }
+
+        std::fflush(stderr);
+    }
