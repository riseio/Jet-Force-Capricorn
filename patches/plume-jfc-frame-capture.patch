diff --git a/plume_clock_calibration.h b/plume_clock_calibration.h
new file mode 100644
index 0000000..614ab1b
--- /dev/null
+++ b/plume_clock_calibration.h
@@ -0,0 +1,38 @@
+#pragma once
+#include <cstdint>
+#include <cmath>
+
+namespace plume {
+    enum class ProfileHostClock : uint32_t { Unknown, QueryPerformanceCounter, Monotonic };
+
+    struct ProfileClockCalibration {
+        uint64_t gpuNanoseconds = 0;
+        uint64_t hostTicks = 0;
+        uint64_t hostFrequency = 0;
+        uint64_t maximumDeviationNanoseconds = 0;
+        bool maximumDeviationKnown = false;
+        uint32_t timestampValidBits = 0;
+        uint64_t gpuWrapNanoseconds = 0;
+        ProfileHostClock hostClock = ProfileHostClock::Unknown;
+
+        double queryScaleErrorPartsPerBillion = 0;
+    };
+
+    inline bool profileVulkanNanoseconds(uint64_t ticks, double period, uint64_t &nanoseconds) {
+        if (!(period >= 1.0 / 65536.0 && period < 281474976710656.0)) return false;
+        const uint64_t factor = uint64_t(period * 65536.0);
+        const uint64_t u1 = ticks & 0xffffffff, v1 = factor & 0xffffffff;
+        uint64_t t = u1 * v1;
+        const uint64_t w3 = t & 0xffffffff;
+        uint64_t k = t >> 32;
+        t = (ticks >> 32) * v1 + k;
+        k = t & 0xffffffff;
+        const uint64_t w1 = t >> 32;
+        t = u1 * (factor >> 32) + k;
+        const uint64_t high = (ticks >> 32) * (factor >> 32) + w1 + (t >> 32);
+        const uint64_t low = (t << 32) + w3;
+        if ((high >> 16) != 0) return false;
+        nanoseconds = (low >> 16) | (high << 48);
+        return true;
+    }
+}
